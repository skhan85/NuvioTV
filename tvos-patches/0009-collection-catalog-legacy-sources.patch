+++ b/shared/src/commonTest/kotlin/com/nuvio/app/features/collection/CollectionCatalogResolverTest.kt
@@ -0,0 +1,67 @@
+package com.nuvio.app.features.collection
+
+import com.nuvio.app.features.addons.AddonCatalog
+import com.nuvio.app.features.addons.AddonManifest
+import com.nuvio.app.features.addons.ManagedAddon
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertNotNull
+
+class CollectionCatalogResolverTest {
+    private val manifestUrl = "https://example.com/aio/manifest.json"
+    private val addon = ManagedAddon(
+        manifestUrl = manifestUrl,
+        manifest = AddonManifest(
+            id = "aio-metadata",
+            name = "AIOMetadata",
+            description = "",
+            version = "2.16.5",
+            resources = emptyList(),
+            types = listOf("movie", "series"),
+            catalogs = listOf(
+                AddonCatalog(
+                    id = "mdblist.13914",
+                    type = "movie",
+                    name = "All Movies on Netflix",
+                ),
+                AddonCatalog(
+                    id = "mdblist.13963",
+                    type = "series",
+                    name = "All Series on Netflix",
+                ),
+            ),
+            transportUrl = manifestUrl,
+        ),
+    )
+
+    @Test
+    fun `legacy display label is resolved to manifest type and id`() {
+        val source = CollectionCatalogSource(
+            addonId = "aio-metadata",
+            type = "All Movies on Netflix",
+            catalogId = "mdblist.13914",
+        )
+
+        val resolved = listOf(addon).findCollectionCatalog(source)
+
+        assertNotNull(resolved)
+        assertEquals("movie", resolved.catalog.type)
+        assertEquals("mdblist.13914", resolved.canonicalSource.catalogId)
+        assertEquals("movie", resolved.canonicalSource.type)
+    }
+
+    @Test
+    fun `catalog id resolves even when the saved addon id is stale`() {
+        val source = CollectionCatalogSource(
+            addonId = "old-aio-metadata-instance",
+            type = "All Series on Netflix",
+            catalogId = "mdblist.13963",
+        )
+
+        val resolved = listOf(addon).findCollectionCatalog(source)
+
+        assertNotNull(resolved)
+        assertEquals("aio-metadata", resolved.canonicalSource.addonId)
+        assertEquals("series", resolved.canonicalSource.type)
+    }
+}
