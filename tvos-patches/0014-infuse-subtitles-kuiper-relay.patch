+        XCTAssertEqual(InfuseSubtitlePicker.relayURL(relayed, language: "eng"), relayed)
+        XCTAssertEqual(InfuseSubtitlePicker.relayURL("file:///tmp/a.srt", language: "en"), "file:///tmp/a.srt")
+    }
 }
