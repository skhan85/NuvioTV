--- /dev/null
+++ b/iosApp/NuvioTV/Screens/RemainingEpisodes.swift
@@ -0,0 +1,112 @@
+import Combine
+import Foundation
+import SharedCore
+
+/// Fork: "N left" on Continue Watching cards — how many aired episodes come after the one on the
+/// card and are not watched yet. Worked out in the background from the series' episode list (the
+/// same metadata the detail page uses), so the row never waits on it; a card shows nothing until
+/// its count is known, and nothing when the count is 0 or the item is a movie.
+///
+/// Counts are cached per card (series + the episode on it) for half an hour. Watching an episode
+/// moves the card to the next one, which is a new key, so the count follows without a refresh.
+/// Off switch: `UserDefaults` key `fork_cw_remaining_episodes` = false.
+@MainActor
+final class RemainingEpisodes: ObservableObject {
+    static let shared = RemainingEpisodes()
+    static let enabledKey = "fork_cw_remaining_episodes"
+    private static let maxAge: TimeInterval = 30 * 60
+
+    @Published private(set) var counts: [String: Int] = [:]
+    private var computedAt: [String: Date] = [:]
+    private var inFlight: Set<String> = []
+    private var queue: [WatchProgressEntry] = []
+    private var worker: Task<Void, Never>?
+
+    static var isEnabled: Bool {
+        UserDefaults.standard.object(forKey: enabledKey) as? Bool ?? true
+    }
+
+    static func key(_ entry: WatchProgressEntry) -> String? {
+        guard let s = entry.seasonNumber?.intValue, let e = entry.episodeNumber?.intValue else { return nil }
+        return "\(entry.parentMetaId)|\(s):\(e)"
+    }
+
+    /// The badge text for a card, or nil.
+    func label(for entry: WatchProgressEntry) -> String? {
+        guard Self.isEnabled, let key = Self.key(entry), let n = counts[key], n > 0 else { return nil }
+        return "\(n) left"
+    }
+
+    /// The row's cards changed: work out any counts that are missing or old, one series at a time.
+    func request(_ entries: [WatchProgressEntry]) {
+        guard Self.isEnabled else { return }
+        let now = Date()
+        for entry in entries {
+            guard let key = Self.key(entry), !inFlight.contains(key) else { continue }
+            if let at = computedAt[key], now.timeIntervalSince(at) < Self.maxAge { continue }
+            inFlight.insert(key)
+            queue.append(entry)
+        }
+        guard worker == nil, !queue.isEmpty else { return }
+        worker = Task { @MainActor in
+            while !queue.isEmpty {
+                let entry = queue.removeFirst()
+                await compute(entry)
+            }
+            worker = nil
+        }
+    }
+
+    private func compute(_ entry: WatchProgressEntry) async {
+        guard let key = Self.key(entry),
+              let season = entry.seasonNumber?.intValue,
+              let episode = entry.episodeNumber?.intValue else { return }
+        defer { inFlight.remove(key) }
+        let type = entry.parentMetaType.isEmpty ? entry.contentType : entry.parentMetaType
+        var meta = MetaDetailsRepository.shared.peek(type: type, id: entry.parentMetaId)
+        if meta?.videos.isEmpty ?? true {
+            do {
+                meta = try await MetaDetailsRepository.shared.fetchChecked(
+                    type: type, id: entry.parentMetaId, cacheResult: true
+                )
+            } catch {
+                print("[RemainingEpisodes] episode list fetch failed for \(entry.parentMetaId): \(error)")
+                return
+            }
+        }
+        guard let videos = meta?.videos, !videos.isEmpty else { return }
+
+        let today = CurrentDateProvider.shared.todayIsoDate()
+        let later = videos.filter { video in
+            guard let s = video.season?.value, let e = video.episode?.value else { return false }
+            // Specials only count when the card itself is in the specials season.
+            if s == 0 && season != 0 { return false }
+            return (s, e) > (season, episode)
+        }
+        var watched: Set<String> = []
+        for video in later {
+            guard let s = video.season?.value, let e = video.episode?.value else { continue }
+            let sk = KotlinInt(int: Int32(s))
+            let ek = KotlinInt(int: Int32(e))
+            let marked = WatchedRepository.shared.isWatched(id: entry.parentMetaId, type: type,
+                                                            season: sk, episode: ek)
+            let completed = WatchProgressRepository.shared.progressForVideo(
+                videoId: "\(entry.parentMetaId):\(s):\(e)",
+                parentMetaId: entry.parentMetaId,
+                seasonNumber: sk,
+                episodeNumber: ek
+            )?.isEffectivelyCompleted == true
+            if marked || completed { watched.insert("\(s):\(e)") }
+        }
+        let count = EpisodeSpoilerRules.airedUnwatchedCount(
+            later.map {
+                EpisodeSpoilerRules.EpisodeFacts(season: $0.season?.value, episode: $0.episode?.value,
+                                                 released: $0.released)
+            },
+            watchedKeys: watched,
+            todayIsoDate: today
+        )
+        computedAt[key] = Date()
+        if counts[key] != count { counts[key] = count }
+    }
+}
