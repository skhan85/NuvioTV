diff --git a/iosApp/NuvioTV/Screens/Player/RewindSubtitleWatch.swift b/iosApp/NuvioTV/Screens/Player/RewindSubtitleWatch.swift
new file mode 100644
index 00000000..ee80f592
--- /dev/null
+++ b/iosApp/NuvioTV/Screens/Player/RewindSubtitleWatch.swift
@@ -0,0 +1,74 @@
+import Foundation
+import SharedCore
+
+/// Fork: Apple TV port of the iPhone "auto-show subtitles on rewind" feature (Nuvio Enhanced
+/// 611b0201, iPhone fork patch 0011). When subtitles are off and you rewind, they turn on until
+/// playback catches back up to the point you rewound from, then turn off again. Rewinding again
+/// before catching up only moves that point further out. A manual subtitle pick ends it at once.
+///
+/// Pure state; both engines (mpv and native) feed it rewinds and ticks and do the track switching.
+struct RewindSubtitleWatch {
+    /// Settings → Subtitles toggle (on by default). Device-local, like the other tvOS-only tuning keys.
+    static let enabledKey = "autoShowSubtitlesOnRewind"
+    static var isEnabled: Bool {
+        UserDefaults.standard.object(forKey: enabledKey) as? Bool ?? true
+    }
+
+    /// A backward user jump smaller than this (a frame-step or position jitter) is not a rewind.
+    static let minimumRewindSec: Double = 3
+
+    private(set) var watermarkSec: Double?
+    private(set) var autoShowing = false
+
+    /// A user rewind from `fromSec` to `toSec`. Returns true when subtitles should be turned on now.
+    mutating func rewound(fromSec: Double, toSec: Double, subtitlesOff: Bool, enabled: Bool = Self.isEnabled) -> Bool {
+        guard enabled, fromSec.isFinite, toSec.isFinite, fromSec - toSec >= Self.minimumRewindSec else { return false }
+        if autoShowing {
+            watermarkSec = max(watermarkSec ?? fromSec, fromSec)
+            return false
+        }
+        guard subtitlesOff else { return false }
+        watermarkSec = fromSec
+        autoShowing = true
+        return true
+    }
+
+    /// Called on every position tick. Returns true when the auto-shown subtitles should be turned
+    /// off again (playback reached the rewind point).
+    mutating func tick(positionSec: Double) -> Bool {
+        guard autoShowing, let watermark = watermarkSec, positionSec.isFinite, positionSec >= watermark else { return false }
+        reset()
+        return true
+    }
+
+    /// The viewer picked a subtitle (or Off) themselves: never undo their choice later.
+    mutating func reset() {
+        watermarkSec = nil
+        autoShowing = false
+    }
+
+    /// Index of the track to show: the first non-forced track in a preferred subtitle language,
+    /// else any track in one, else the first non-forced track, else the first track.
+    static func pickTrack(languages: [String?], forced: [Bool]) -> Int? {
+        guard !languages.isEmpty else { return nil }
+        PlayerSettingsRepository.shared.ensureLoaded()
+        let settings = PlayerSettingsRepository.shared.uiState.value_ as? PlayerSettingsUiState
+        let targets = settings.map {
+            PlayerLanguagePreferencesKt.resolvePreferredSubtitleLanguageTargets(
+                preferredSubtitleLanguage: $0.preferredSubtitleLanguage,
+                secondaryPreferredSubtitleLanguage: $0.secondaryPreferredSubtitleLanguage,
+                deviceLanguages: DeviceLanguagePreferences.shared.preferredLanguageCodes()
+            )
+        } ?? []
+        func matches(_ index: Int) -> Bool {
+            targets.contains { SubtitleLanguageMatching.shared.matchesLanguageCode(language: languages[index], target: $0) }
+        }
+        let all = Array(languages.indices)
+        let nonForced = all.filter { !(forced[safe: $0] ?? false) }
+        return nonForced.first(where: matches) ?? all.first(where: matches) ?? nonForced.first ?? all.first
+    }
+}
+
+private extension Array {
+    subscript(safe index: Int) -> Element? { indices.contains(index) ? self[index] : nil }
+}
