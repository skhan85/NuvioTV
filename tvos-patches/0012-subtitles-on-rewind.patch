diff --git a/iosApp/NuvioTVTests/RewindSubtitleWatchTests.swift b/iosApp/NuvioTVTests/RewindSubtitleWatchTests.swift
new file mode 100644
index 00000000..6867e738
--- /dev/null
+++ b/iosApp/NuvioTVTests/RewindSubtitleWatchTests.swift
@@ -0,0 +1,43 @@
+import XCTest
+@testable import NuvioTV
+
+/// Fork: auto-show subtitles on rewind (`RewindSubtitleWatch`).
+final class RewindSubtitleWatchTests: XCTestCase {
+    func testRewindWithSubtitlesOffTurnsThemOnUntilCaughtUp() {
+        var watch = RewindSubtitleWatch()
+        XCTAssertTrue(watch.rewound(fromSec: 600, toSec: 590, subtitlesOff: true, enabled: true))
+        XCTAssertFalse(watch.tick(positionSec: 599))
+        XCTAssertTrue(watch.tick(positionSec: 600))
+        XCTAssertFalse(watch.autoShowing)
+    }
+
+    func testRepeatedRewindKeepsTheFarthestPoint() {
+        var watch = RewindSubtitleWatch()
+        XCTAssertTrue(watch.rewound(fromSec: 600, toSec: 590, subtitlesOff: true, enabled: true))
+        XCTAssertFalse(watch.tick(positionSec: 595))
+        // Already showing: a further rewind never re-triggers, and never lowers the watermark.
+        XCTAssertFalse(watch.rewound(fromSec: 595, toSec: 580, subtitlesOff: false, enabled: true))
+        XCTAssertEqual(watch.watermarkSec, 600)
+        XCTAssertFalse(watch.tick(positionSec: 599))
+        XCTAssertTrue(watch.tick(positionSec: 600))
+    }
+
+    func testNothingHappensWhenSubtitlesAreAlreadyOnOrDisabled() {
+        var watch = RewindSubtitleWatch()
+        XCTAssertFalse(watch.rewound(fromSec: 600, toSec: 590, subtitlesOff: false, enabled: true))
+        XCTAssertFalse(watch.rewound(fromSec: 600, toSec: 590, subtitlesOff: true, enabled: false))
+        XCTAssertFalse(watch.autoShowing)
+    }
+
+    func testTinyBackwardJumpIsNotARewind() {
+        var watch = RewindSubtitleWatch()
+        XCTAssertFalse(watch.rewound(fromSec: 600, toSec: 598.5, subtitlesOff: true, enabled: true))
+    }
+
+    func testManualPickEndsTheAutoShow() {
+        var watch = RewindSubtitleWatch()
+        XCTAssertTrue(watch.rewound(fromSec: 600, toSec: 590, subtitlesOff: true, enabled: true))
+        watch.reset()
+        XCTAssertFalse(watch.tick(positionSec: 700))
+    }
+}
