     static func pick(streamSubtitles: [Candidate], addonSubtitles: [Candidate],
@@ -34,7 +37,7 @@ enum InfuseSubtitlePicker {
     }
 
     /// The stream's subtitles plus the add-on subtitles fetched so far for this title.
