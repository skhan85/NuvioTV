+        let kept = Array(picked.prefix(own.count + maxAddonSubtitles))
+        return kept.enumerated().map { index, sub in
+            SubtitleInput(url: relayURL(sub.url, language: sub.language, name: sub.name, number: index + 1,
+                                        videoURL: videoURL),
                           name: sub.name, lang: sub.language)
         }
     }
@@ -68,7 +73,11 @@ enum InfuseSubtitlePicker {
     /// Infuse showed none of them. Kuiper's `/subs/` relay serves each one as a plain `.srt`. The
     /// file name carries the track's label and a two-letter language code
