-    static func relayURL(_ url: String, language: String, name: String = "", number: Int = 1) -> String {
+    ///
+    /// With `videoURL`, the link also names the video (`/subs/<subtitle>/v/<video>/<name>`), so the
+    /// relay lines the subtitle up with the video's audio (Kuiper's `subsync` container).
+    static func relayURL(_ url: String, language: String, name: String = "", number: Int = 1,
+                         videoURL: String? = nil) -> String {
         guard url.hasPrefix("http://") || url.hasPrefix("https://"), !url.hasPrefix(relayBase) else { return url }
         let encoded = Data(url.utf8).base64EncodedString()
             .replacingOccurrences(of: "+", with: "-")
@@ -80,6 +89,16 @@ enum InfuseSubtitlePicker {
         let label = String(String(name.unicodeScalars.filter { allowed.contains($0) }).trimmingCharacters(in: .whitespaces).prefix(60))
         let file = "\(label.isEmpty ? "Subtitle" : label) \(number).\(code.isEmpty ? "und" : code).srt"
         let path = file.addingPercentEncoding(withAllowedCharacters: .urlPathAllowed.subtracting(CharacterSet(charactersIn: "/"))) ?? "sub.srt"
-        return relayBase + encoded + "/" + path
+        guard let videoURL, videoURL.hasPrefix("http://") || videoURL.hasPrefix("https://") else {
+            return relayBase + encoded + "/" + path
+        }
+        return relayBase + encoded + "/v/" + base64url(videoURL) + "/" + path
+    }
+
+    private static func base64url(_ text: String) -> String {
+        Data(text.utf8).base64EncodedString()
+            .replacingOccurrences(of: "+", with: "-")
+            .replacingOccurrences(of: "/", with: "_")
+            .trimmingCharacters(in: CharacterSet(charactersIn: "="))
     }
 }
