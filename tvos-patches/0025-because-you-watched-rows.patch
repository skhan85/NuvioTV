+    /// Fork: (re)builds the "Because you watched" rows. Cheap to call on every Home appearance —
+    /// the shared side caches by last-watched titles. UserDefaults `fork_because_rows` turns it off.
+    func refreshForkRows() {
+        forkRowsTask?.cancel()
+        let gen = pipelineGeneration
+        forkRowsTask = Task { @MainActor [weak self] in
+            let defaults = UserDefaults.standard
+            var because: [HomeCatalogSection] = []
+            if defaults.object(forKey: "fork_because_rows") as? Bool ?? true {
+                because = (try? await ForkHomeRows.shared.becauseYouWatchedChecked(maxRows: 2)) ?? []
+            }
+            guard let self, !Task.isCancelled, self.pipelineGeneration == gen else { return }
+            self.becauseRows = because
+        }
+    }
