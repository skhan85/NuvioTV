@@ -0,0 +1,82 @@
+import Foundation
+
+/// Fork: "warm the stream before you press Play" (ported from ysosrs123's NuvioTV fork).
+///
+/// Resting on a stream row for half a second opens its URL once (a 1-byte range request whose
+/// body is dropped as soon as the headers arrive). For debrid-backed links that makes the
+/// addon/debrid service unlock and resolve the file now, so Infuse (or the built-in player) gets a
+/// ready link when Play is pressed. The same request doubles as a liveness check: a link answering
+/// with an HTTP error is reported dead so the picker can mark it and the automatic pickers skip it.
+/// Network errors and timeouts are NOT treated as dead (a slow link is not a broken one).
+/// UserDefaults `fork_stream_warmup` = false turns it off.
+@MainActor
+final class StreamWarmup {
+    static let shared = StreamWarmup()
+
+    static var enabled: Bool { UserDefaults.standard.object(forKey: "fork_stream_warmup") as? Bool ?? true }
+    static let settleDelay: UInt64 = 500_000_000
+
+    enum Outcome { case alive, dead(Int) }
+
+    private var outcomes: [String: (Outcome, Date)] = [:]
+    private var inFlight: [String: (Int) -> Void] = [:]
+    private let reuseFor: TimeInterval = 10 * 60
+
+    private lazy var session: URLSession = {
+        let config = URLSessionConfiguration.ephemeral
+        config.timeoutIntervalForRequest = 12
+        config.timeoutIntervalForResource = 20
+        config.httpMaximumConnectionsPerHost = 2
+        return URLSession(configuration: config)
+    }()
+
+    /// Warms `urlString` unless it was warmed recently or is already being warmed. `onDead` runs on
+    /// the main actor with the HTTP status when the link answers with an error.
+    func warm(_ urlString: String, headers: [String: String], onDead: @escaping (Int) -> Void) {
+        guard Self.enabled, let url = URL(string: urlString),
+              let scheme = url.scheme?.lowercased(), scheme == "http" || scheme == "https" else { return }
+        if let (outcome, at) = outcomes[urlString], Date().timeIntervalSince(at) < reuseFor {
+            if case let .dead(code) = outcome { onDead(code) }
+            return
+        }
+        guard inFlight[urlString] == nil else { return }
+        inFlight[urlString] = onDead
+        var request = URLRequest(url: url)
+        request.httpMethod = "GET"
+        request.setValue("bytes=0-0", forHTTPHeaderField: "Range")
+        for (key, value) in headers { request.setValue(value, forHTTPHeaderField: key) }
+        let started = Date()
+        let session = self.session
+        let finalRequest = request
+        Task.detached(priority: .utility) {
+            var status: Int?
+            do {
+                let (bytes, response) = try await session.bytes(for: finalRequest)
+                bytes.task.cancel()
+                status = (response as? HTTPURLResponse)?.statusCode
+            } catch {
+                status = nil
+            }
+            let ms = Int(Date().timeIntervalSince(started) * 1000)
+            await MainActor.run {
+                StreamWarmup.shared.finish(urlString, status: status, ms: ms)
+            }
+        }
+    }
+
+    private func finish(_ urlString: String, status: Int?, ms: Int) {
+        let onDead = inFlight.removeValue(forKey: urlString)
+        guard let status else {
+            print("[Warmup] no answer in \(ms) ms (left alone)")
+            return
+        }
+        if status >= 400 && status != 416 {
+            outcomes[urlString] = (.dead(status), Date())
+            print("[Warmup] dead link status=\(status) in \(ms) ms")
+            onDead?(status)
+        } else {
+            outcomes[urlString] = (.alive, Date())
+            print("[Warmup] warmed status=\(status) in \(ms) ms")
+        }
+    }
+}
