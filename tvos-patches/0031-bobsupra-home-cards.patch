diff --git a/iosApp/NuvioTV/Screens/CWBloomCard.swift b/iosApp/NuvioTV/Screens/CWBloomCard.swift
new file mode 100644
index 00000000..96d58ac9
--- /dev/null
+++ b/iosApp/NuvioTV/Screens/CWBloomCard.swift
@@ -0,0 +1,223 @@
+import SwiftUI
+import SharedCore
+
+// MARK: - Fork: bobsupra-style Continue Watching cards
+
+/// Fork settings for the bobsupra-style Home cards. Local-only, not synced.
+enum ForkCWStyle {
+    /// `fork_cw_posters`: Continue Watching shows portrait posters that open into a wide card on
+    /// focus (default) instead of always-wide landscape cards.
+    static let postersKey = "fork_cw_posters"
+    static var posters: Bool { UserDefaults.standard.object(forKey: postersKey) as? Bool ?? true }
+    /// How long focus has to rest on a card before it opens, so a fast scrub along the row does not
+    /// open every card it passes.
+    static let openDelay: TimeInterval = 0.3
+    static let openAnimation: Animation = .spring(response: 0.3, dampingFraction: 1.0)
+
+    /// The open card: 16:9 at the poster's height.
+    static func wideWidth(_ style: PosterStyle) -> CGFloat { style.height * 16.0 / 9.0 }
+}
+
+/// A Continue Watching card in the bobsupra style: a portrait poster with a "S1 E6 · 35m left" pill;
+/// once focus rests on it, it widens to a 16:9 card with the episode still (or backdrop), the
+/// episode code, title and episode name, and the progress bar. Leaving focus closes it.
+struct CWBloomCard: View {
+    let entry: WatchProgressEntry
+    let posterURL: String?
+    let wideURL: String?
+    let progress: Double?
+    /// "N left" from `RemainingEpisodes`, shown in the open card.
+    var remainingLabel: String? = nil
+    var shuffled: Bool = false
+    /// Fires when the card's width changes edge, so the row can keep the open card on screen.
+    var onOpenChange: ((Bool) -> Void)? = nil
+
+    @Environment(\.isFocused) private var isFocused
+    @Environment(\.posterStyle) private var style
+    @Environment(\.accessibilityReduceMotion) private var reduceMotion
+    @AppStorage("accent_focus_ring") private var accentFocusRing = false
+    @AppStorage("no_zoom_on_focus") private var noZoomOnFocus = false
+    @State private var open = false
+    @State private var openTask: Task<Void, Never>?
+    /// Bumped on every focus change; a pending open only fires if it is still current.
+    @State private var focusGeneration = 0
+
+    private var focusMode: CardFocusMode {
+        .resolve(accentFocusRing: accentFocusRing, noZoomOnFocus: noZoomOnFocus)
+    }
+
+    private var height: CGFloat { style.height }
+    private var narrowWidth: CGFloat { style.width }
+    private var wideWidth: CGFloat { ForkCWStyle.wideWidth(style) }
+    private var width: CGFloat { open ? wideWidth : narrowWidth }
+
+    private var episodeCode: String? {
+        guard let s = entry.seasonNumber?.intValue, let e = entry.episodeNumber?.intValue else { return nil }
+        return "S\(s) E\(e)"
+    }
+
+    private var timeLeft: String? {
+        StageCopy.remainingLabel(positionMs: entry.lastPositionMs, durationMs: entry.durationMs)
+    }
+
+    /// "S1 E6 · 35m left", "2h 20m left", "S1 E6" — whatever is known.
+    private var pillText: String? {
+        let parts = [episodeCode, timeLeft].compactMap { $0 }
+        return parts.isEmpty ? nil : parts.joined(separator: " · ")
+    }
+
+    private var episodeTitle: String? {
+        let t: String? = entry.episodeTitle
+        guard let t, !t.isEmpty else { return nil }
+        return t
+    }
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: Theme.Spacing.md) {
+            ZStack(alignment: .topLeading) {
+                CachedAsyncImage(string: posterURL, fallback: wideURL,
+                                 decodeSize: .points(width: narrowWidth, height: height))
+                    .frame(width: width, height: height)
+                    .clipped()
+                    .opacity(open ? 0 : 1)
+
+                // Loaded once the card has focus, so a row of closed posters fetches no backdrops.
+                CachedAsyncImage(string: (isFocused || open) ? wideURL : nil, fallback: posterURL,
+                                 decodeSize: .points(width: wideWidth, height: height))
+                    .frame(width: width, height: height)
+                    .clipped()
+                    .opacity(open ? 1 : 0)
+
+                if open {
+                    LinearGradient(colors: [.clear, .black.opacity(0.75)],
+                                   startPoint: .center, endPoint: .bottom)
+                        .frame(width: width, height: height)
+                        .transition(.opacity)
+                    openCaption
+                        .frame(width: width, height: height, alignment: .bottomLeading)
+                        .transition(.opacity)
+                }
+
+                pill
+                    .frame(width: width, alignment: open ? .topTrailing : .top)
+                    .padding(.top, Theme.Spacing.sm)
+
+                if let progress {
+                    progressBar(progress)
+                        .frame(width: width, height: height, alignment: .bottom)
+                }
+            }
+            .frame(width: width, height: height)
+            .clipShape(RoundedRectangle(cornerRadius: style.cornerRadius))
+            .overlay {
+                if accentFocusRing && isFocused {
+                    RoundedRectangle(cornerRadius: style.cornerRadius)
+                        .strokeBorder(Theme.Palette.focusRingColor, lineWidth: 4)
+                }
+            }
+            .modifier(CardArtworkFocusLift(mode: focusMode, isFocused: isFocused,
+                                           artworkHeight: height, cornerRadius: style.cornerRadius))
+
+            if style.showTitle {
+                Text(entry.title)
+                    .font(Theme.Font.cardTitle)
+                    .foregroundStyle(isFocused ? Theme.Palette.textPrimary : Theme.Palette.textSecondary)
+                    .lineLimit(1)
+                    .padding(.horizontal, Theme.Spacing.xs)
+                    .frame(width: width, alignment: .leading)
+                    .modifier(CardCaptionFocusDrop(mode: focusMode, isFocused: isFocused, artworkHeight: height))
+                    .opacity(open ? 0 : 1)
+            }
+        }
+        .modifier(CardFocusTreatment(mode: focusMode, isFocused: isFocused, artworkHeight: height,
+                                     cornerRadius: style.cornerRadius, tint: nil))
+        .zIndex(isFocused ? 1 : 0)
+        .onChange(of: isFocused, initial: true) { _, focused in
+            openTask?.cancel()
+            focusGeneration &+= 1
+            let generation = focusGeneration
+            if focused {
+                openTask = Task { @MainActor in
+                    try? await Task.sleep(nanoseconds: UInt64(ForkCWStyle.openDelay * 1_000_000_000))
+                    guard !Task.isCancelled, focusGeneration == generation else { return }
+                    setOpen(true)
+                }
+            } else {
+                setOpen(false)
+            }
+        }
+        .onDisappear {
+            openTask?.cancel()
+            open = false
+        }
+    }
+
+    private func setOpen(_ value: Bool) {
+        guard open != value else { return }
+        if reduceMotion {
+            open = value
+        } else {
+            withAnimation(ForkCWStyle.openAnimation) { open = value }
+        }
+        onOpenChange?(value)
+    }
+
+    @ViewBuilder
+    private var pill: some View {
+        let text = pillText
+        if text != nil || shuffled {
+            HStack(spacing: Theme.Spacing.xs) {
+                if let text { Text(text) }
+                if shuffled { Image(systemName: "shuffle") }
+            }
+            .font(Theme.Font.caption.weight(.semibold))
+            .lineLimit(1)
+            .minimumScaleFactor(0.7)
+            .foregroundStyle(Color.white)
+            .padding(.horizontal, Theme.Spacing.sm)
+            .padding(.vertical, Theme.Spacing.xxs)
+            .background(Color.black.opacity(0.6), in: Capsule())
+            .padding(.horizontal, Theme.Spacing.sm)
+            .allowsHitTesting(false)
+        }
+    }
+
+    private var openCaption: some View {
+        VStack(alignment: .leading, spacing: 2) {
+            if let episodeCode {
+                Text(remainingLabel.map { "\(episodeCode) · \($0)" } ?? episodeCode)
+                    .font(Theme.Font.caption)
+                    .foregroundStyle(Color.white.opacity(0.85))
+            }
+            Text(entry.title)
+                .font(Theme.Font.cardTitle.weight(.bold))
+                .foregroundStyle(Color.white)
+                .lineLimit(1)
+            if let episodeTitle {
+                Text(episodeTitle)
+                    .font(Theme.Font.caption)
+                    .foregroundStyle(Color.white.opacity(0.85))
+                    .lineLimit(1)
+            }
+        }
+        .shadow(color: .black.opacity(0.6), radius: 4, y: 1)
+        .padding(.horizontal, Theme.Spacing.md)
+        .padding(.bottom, progress != nil ? Theme.Spacing.lg : Theme.Spacing.md)
+        .allowsHitTesting(false)
+    }
+
+    private func progressBar(_ value: Double) -> some View {
+        GeometryReader { geo in
+            ZStack(alignment: .leading) {
+                Capsule().fill(Color.white.opacity(0.3))
+                Capsule()
+                    .fill(Theme.Palette.progress)
+                    .frame(width: geo.size.width * min(max(value, 0), 1))
+            }
+        }
+        .frame(height: 5)
+        .padding(.horizontal, Theme.Spacing.md)
+        .padding(.bottom, Theme.Spacing.sm)
+        .allowsHitTesting(false)
+    }
+}
