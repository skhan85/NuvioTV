index 00000000..74e4ccda
--- /dev/null
+++ b/iosApp/NuvioTVTests/NextEpisodeStaleDurationTests.swift
@@ -0,0 +1,22 @@
+import XCTest
+@testable import NuvioTV
+
+/// Fork: the Android 0.9.2 duration guard (via nexis-cmyk 66970f26). A player can briefly report
+/// a duration belonging to the previous stream; that must never open the next-episode card.
+final class NextEpisodeStaleDurationTests: XCTestCase {
+    func testStaleShorterDurationIsNotPlausible() {
+        XCTAssertFalse(NextEpisodeTriggerPolicy.isPlausibleReading(positionSec: 25 * 60, durationSec: 20 * 60))
+    }
+
+    func testNearEndWithinToleranceIsPlausible() {
+        XCTAssertTrue(NextEpisodeTriggerPolicy.isPlausibleReading(positionSec: 45 * 60 + 0.5, durationSec: 45 * 60))
+    }
+
+    func testBeyondToleranceIsNotPlausible() {
+        XCTAssertFalse(NextEpisodeTriggerPolicy.isPlausibleReading(positionSec: 45 * 60 + 1.01, durationSec: 45 * 60))
+    }
+
+    func testNormalMidEpisodeReadingIsPlausible() {
+        XCTAssertTrue(NextEpisodeTriggerPolicy.isPlausibleReading(positionSec: 10 * 60, durationSec: 45 * 60))
+    }
+}
