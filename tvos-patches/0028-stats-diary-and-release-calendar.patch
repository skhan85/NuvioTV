+import SwiftUI
+import SharedCore
+
+/// Fork: Stats, Diary (from NuvioPro) and the release Calendar (from Nuvio Enhanced / NuvioPro),
+/// opened from the Library tab. All data comes from `ForkInsights` in shared: watched history, the
+/// library and addon metadata already on the device.
+struct InsightsView: View {
+    enum Page: String, CaseIterable, Identifiable {
+        case stats, diary, calendar
+        var id: String { rawValue }
+        var title: String {
+            switch self {
+            case .stats: return String(localized: "Stats")
+            case .diary: return String(localized: "Diary")
+            case .calendar: return String(localized: "Calendar")
+            }
+        }
+        var icon: String {
+            switch self {
+            case .stats: return "chart.bar.fill"
+            case .diary: return "book.closed.fill"
+            case .calendar: return "calendar"
+            }
+        }
+    }
+
+    @State private var page: Page
+
+    init(page: Page) {
+        _page = State(initialValue: page)
+    }
+    @State private var summary: WatchStatsSummary?
+    @State private var calendar: [CalendarEntry]?
+    @State private var calendarFailed = false
+
+    private static func nowMs() -> Int64 { Int64(Date().timeIntervalSince1970 * 1000) }
+
+    var body: some View {
+        ZStack {
+            Theme.Palette.background.ignoresSafeArea()
+            ScrollView(.vertical) {
+                VStack(alignment: .leading, spacing: Theme.Spacing.lg) {
+                    HStack(spacing: Theme.Spacing.md) {
+                        ForEach(Page.allCases) { item in
+                            FilterChip(title: item.title, systemImage: item.icon, isActive: page == item) {
+                                page = item
+                            }
+                        }
+                    }
+                    .focusSection()
+
+                    switch page {
+                    case .stats: statsPage
+                    case .diary: diaryPage
+                    case .calendar: calendarPage
+                    }
+                }
+                .padding(Theme.Spacing.screen)
+                .frame(maxWidth: .infinity, alignment: .leading)
+            }
+            .scrollClipDisabled()
+        }
+        .onAppear { summary = ForkInsights.shared.stats(nowEpochMs: Self.nowMs()) }
+        .task(id: page) {
+            guard page == .calendar, calendar == nil else { return }
+            do {
+                calendar = try await ForkInsights.shared.calendarChecked(nowEpochMs: Self.nowMs(), force: false)
+            } catch {
+                calendarFailed = true
+                calendar = []
+            }
+        }
+    }
+
+    // MARK: Stats
+
+    @ViewBuilder
+    private var statsPage: some View {
+        if let s = summary {
+            LazyVGrid(columns: Array(repeating: GridItem(.flexible(), spacing: Theme.Spacing.lg), count: 4),
+                      alignment: .leading, spacing: Theme.Spacing.lg) {
+                statTile("\(s.estimatedHours)", String(localized: "hours watched (est.)"))
+                statTile("\(s.movies)", String(localized: "movies"))
+                statTile("\(s.episodes)", String(localized: "episodes"))
+                statTile("\(s.showsFinished) / \(s.showsStarted)", String(localized: "shows finished"))
+                statTile("\(s.thisMonth)", String(localized: "this month"))
+                statTile("\(s.thisYear)", String(localized: "this year"))
+                statTile("\(s.longestStreakDays)", String(localized: "best streak (days)"))
+                statTile("\(s.movieShare)% / \(100 - s.movieShare)%", String(localized: "movies / episodes"))
+            }
+
+            if !s.topGenres.isEmpty {
+                sectionTitle(String(localized: "Taste"))
+                Text(s.topGenres.joined(separator: "  ·  "))
+                    .font(Theme.Font.body)
+                    .foregroundStyle(Theme.Palette.textPrimary)
+            }
+
+            sectionTitle(String(localized: "Achievements"))
+            LazyVGrid(columns: Array(repeating: GridItem(.flexible(), spacing: Theme.Spacing.lg), count: 5),
+                      alignment: .leading, spacing: Theme.Spacing.lg) {
+                ForEach(Array(s.achievements.enumerated()), id: \.offset) { _, a in
+                    achievementTile(a)
+                }
+            }
+        } else {
+            ProgressView()
+        }
+    }
+
+    private func statTile(_ value: String, _ label: String) -> some View {
+        Button {} label: {
+            VStack(alignment: .leading, spacing: Theme.Spacing.xs) {
+                Text(value)
+                    .font(.system(size: 52, weight: .bold, design: .rounded))
+                    .foregroundStyle(Theme.Palette.textPrimary)
+                    .minimumScaleFactor(0.5)
+                    .lineLimit(1)
+                Text(label)
+                    .font(Theme.Font.caption)
+                    .foregroundStyle(Theme.Palette.textSecondary)
+            }
+            .padding(Theme.Spacing.md)
+            .frame(maxWidth: .infinity, alignment: .leading)
+        }
+        .buttonStyle(.settingsRow)
+    }
+
+    private func achievementTile(_ a: Achievement) -> some View {
+        let tierColors: [Color] = [.gray, .brown, Color(white: 0.8), .yellow]
+        let tier = Int(a.tier)
+        return Button {} label: {
+            VStack(spacing: Theme.Spacing.sm) {
+                ZStack {
+                    Circle().stroke(Color.white.opacity(0.15), lineWidth: 10)
+                    Circle()
+                        .trim(from: 0, to: CGFloat(a.progress))
+                        .stroke(tierColors[min(tier, 3)], style: StrokeStyle(lineWidth: 10, lineCap: .round))
+                        .rotationEffect(.degrees(-90))
+                    Image(systemName: tier > 0 ? "medal.fill" : "medal")
+                        .font(.system(size: 40))
+                        .foregroundStyle(tierColors[min(tier, 3)])
+                }
+                .frame(width: 110, height: 110)
+                Text(a.title).font(Theme.Font.body).foregroundStyle(Theme.Palette.textPrimary)
+                Text(a.detail).font(Theme.Font.caption).foregroundStyle(Theme.Palette.textSecondary)
+            }
+            .padding(Theme.Spacing.md)
+            .frame(maxWidth: .infinity)
+        }
+        .buttonStyle(.settingsRow)
+    }
+
+    // MARK: Diary
+
+    @ViewBuilder
+    private var diaryPage: some View {
+        if let s = summary {
+            if s.days.isEmpty {
+                emptyText(String(localized: "Nothing watched yet. Finished titles show up here, day by day."))
+            }
+            LazyVStack(alignment: .leading, spacing: Theme.Spacing.md) {
+                ForEach(Array(s.days.enumerated()), id: \.offset) { index, day in
+                    if index == 0 || s.days[index - 1].date.prefix(7) != day.date.prefix(7) {
+                        sectionTitle(Self.monthTitle(day.date))
+                    }
+                    Text(Self.dayTitle(day.date))
+                        .font(Theme.Font.caption)
+                        .foregroundStyle(Theme.Palette.textSecondary)
+                    ForEach(Array(day.entries.enumerated()), id: \.offset) { _, entry in
+                        row(poster: entry.poster, title: entry.name,
+                            detail: entry.episodes.isEmpty
+                                ? (entry.type == "movie" ? String(localized: "Movie") : String(localized: "Series"))
+                                : entry.episodes.joined(separator: ", "))
+                    }
+                }
+            }
+        } else {
+            ProgressView()
+        }
+    }
+
+    // MARK: Calendar
+
+    @ViewBuilder
+    private var calendarPage: some View {
+        if let calendar {
+            if calendar.isEmpty {
+                emptyText(calendarFailed
+                          ? String(localized: "Couldn't load the calendar. Try again later.")
+                          : String(localized: "No episodes in the next 60 days for the shows in your Library."))
+            }
+            let today = ForkInsights.shared.todayLocal(nowEpochMs: Self.nowMs())
+            LazyVStack(alignment: .leading, spacing: Theme.Spacing.md) {
+                ForEach(Array(calendar.enumerated()), id: \.offset) { index, entry in
+                    if index == 0 || calendar[index - 1].date != entry.date {
+                        sectionTitle(entry.date == today ? String(localized: "Today") : Self.dayTitle(entry.date))
+                    }
+                    row(poster: entry.poster, title: entry.name, detail: entry.label,
+                        dimmed: entry.date < today)
+                }
+            }
+        } else {
+            HStack(spacing: Theme.Spacing.md) {
+                ProgressView()
+                Text("Checking your shows\u{2026}").foregroundStyle(Theme.Palette.textSecondary)
+            }
+        }
+    }
+
+    // MARK: Pieces
+
+    private func row(poster: String?, title: String, detail: String, dimmed: Bool = false) -> some View {
+        Button {} label: {
+            HStack(spacing: Theme.Spacing.md) {
+                AsyncImage(url: poster.flatMap(URL.init(string:))) { image in
+                    image.resizable().scaledToFill()
+                } placeholder: {
+                    Color.white.opacity(0.08)
+                }
+                .frame(width: 60, height: 90)
+                .clipShape(RoundedRectangle(cornerRadius: 8))
+                VStack(alignment: .leading, spacing: Theme.Spacing.xxs) {
+                    Text(title).font(Theme.Font.body).foregroundStyle(Theme.Palette.textPrimary).lineLimit(1)
+                    Text(detail).font(Theme.Font.caption).foregroundStyle(Theme.Palette.textSecondary).lineLimit(2)
+                }
+                Spacer()
+            }
+            .padding(.vertical, Theme.Spacing.xs)
+            .padding(.horizontal, Theme.Spacing.sm)
+            .opacity(dimmed ? 0.55 : 1)
+        }
+        .buttonStyle(.settingsRow)
+        .frame(maxWidth: 1100, alignment: .leading)
+    }
+
+    private func sectionTitle(_ text: String) -> some View {
+        Text(text)
+            .font(Theme.Font.sectionTitle)
+            .foregroundStyle(Theme.Palette.textPrimary)
+            .padding(.top, Theme.Spacing.md)
+    }
+
+    private func emptyText(_ text: String) -> some View {
+        Text(text).font(Theme.Font.body).foregroundStyle(Theme.Palette.textSecondary)
+    }
+
+    private static let isoParser: DateFormatter = {
+        let f = DateFormatter()
+        f.dateFormat = "yyyy-MM-dd"
+        return f
+    }()
+
+    static func dayTitle(_ iso: String) -> String {
+        guard let date = isoParser.date(from: iso) else { return iso }
+        return date.formatted(.dateTime.weekday(.wide).month(.abbreviated).day())
+    }
+
+    static func monthTitle(_ iso: String) -> String {
+        guard let date = isoParser.date(from: iso) else { return String(iso.prefix(7)) }
+        return date.formatted(.dateTime.month(.wide).year())
+    }
+}
