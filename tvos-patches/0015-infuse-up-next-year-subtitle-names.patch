diff --git a/iosApp/NuvioTVTests/InfuseUpNextTests.swift b/iosApp/NuvioTVTests/InfuseUpNextTests.swift
new file mode 100644
index 00000000..0c7a14d6
--- /dev/null
+++ b/iosApp/NuvioTVTests/InfuseUpNextTests.swift
@@ -0,0 +1,26 @@
+import XCTest
+@testable import NuvioTV
+
+/// Fork: Up Next after Infuse and the movie year in the Infuse title (`InfuseUpNext`).
+final class InfuseUpNextTests: XCTestCase {
+    func testNearEndMeansPastNinetyPercentOrInsideTheLastTwoMinutes() {
+        XCTAssertTrue(InfuseUpNext.reachedEnd(positionMs: 2_700_000, durationMs: 3_000_000))
+        XCTAssertTrue(InfuseUpNext.reachedEnd(positionMs: 2_500_000, durationMs: 2_600_000))
+        XCTAssertFalse(InfuseUpNext.reachedEnd(positionMs: 1_200_000, durationMs: 3_000_000))
+        XCTAssertFalse(InfuseUpNext.reachedEnd(positionMs: 0, durationMs: 3_000_000))
+    }
+
+    func testReleaseDateDecidesWhetherTheNextEpisodeHasAired() {
+        let today = ISO8601DateFormatter().date(from: "2026-10-07T12:00:00Z")!
+        XCTAssertTrue(InfuseUpNext.hasAired("2026-10-07T00:00:00.000Z", today: today))
+        XCTAssertFalse(InfuseUpNext.hasAired("2026-10-14", today: today))
+        XCTAssertTrue(InfuseUpNext.hasAired(nil, today: today))
+    }
+
+    func testMovieTitleGetsItsYearOnce() {
+        XCTAssertEqual(InfuseUpNext.titleWithYear("Dune", year: "2021", isEpisode: false), "Dune (2021)")
+        XCTAssertEqual(InfuseUpNext.titleWithYear("Dune (2021)", year: "2021", isEpisode: false), "Dune (2021)")
+        XCTAssertEqual(InfuseUpNext.titleWithYear("Severance", year: "2022–", isEpisode: true), "Severance")
+        XCTAssertEqual(InfuseUpNext.titleWithYear("Untitled", year: nil, isEpisode: false), "Untitled")
+    }
+}
