diff --git a/iosApp/NuvioTV/Screens/InfuseUpNext.swift b/iosApp/NuvioTV/Screens/InfuseUpNext.swift
new file mode 100644
index 00000000..74a15deb
--- /dev/null
+++ b/iosApp/NuvioTV/Screens/InfuseUpNext.swift
@@ -0,0 +1,76 @@
+import Foundation
+import SharedCore
+
+/// Fork: Up Next for episodes played in Infuse.
+///
+/// Infuse plays one file and calls back when it stops. `StreamPickerView` notes which episode it
+/// handed over (and the duration it expects); when Infuse's success callback reports a position
+/// near the end (past 90%, or inside the last two minutes), this posts `returnedNearEnd` with the
+/// episode's video id. `DetailView` then closes the picker and offers the next episode, starting it
+/// after ten seconds unless cancelled.
+enum InfuseUpNext {
+    static let returnedNearEnd = Notification.Name("InfuseUpNextReturnedNearEnd")
+    static let countdownSeconds = 10
+
+    private struct Launch {
+        let videoId: String
+        let durationMs: Int64
+    }
+
+    /// Main thread only (set from the picker, read from the callback router).
+    private static var lastLaunch: Launch?
+
+    static func noteLaunch(videoId: String, durationMs: Int64?) {
+        guard let durationMs, durationMs > 0 else {
+            lastLaunch = nil
+            return
+        }
+        lastLaunch = Launch(videoId: videoId, durationMs: durationMs)
+    }
+
+    /// Called with a consumed Infuse success callback (`…/success?…&position=<seconds>`).
+    static func noteReturn(_ url: URL) {
+        guard let launch = lastLaunch else { return }
+        lastLaunch = nil
+        let position = URLComponents(url: url, resolvingAgainstBaseURL: false)?
+            .queryItems?.first { $0.name == "position" }?.value.flatMap(Double.init)
+        guard let position, reachedEnd(positionMs: Int64(position * 1000), durationMs: launch.durationMs) else { return }
+        NotificationCenter.default.post(name: returnedNearEnd, object: launch.videoId)
+    }
+
+    static func reachedEnd(positionMs: Int64, durationMs: Int64) -> Bool {
+        guard durationMs > 0, positionMs > 0 else { return false }
+        return positionMs >= durationMs * 9 / 10 || durationMs - positionMs <= 120_000
+    }
+
+    /// The episode after (season, episode) in air order, skipping ones not released yet.
+    static func nextEpisode(in videos: [MetaVideo], season: Int, episode: Int, today: Date = Date()) -> MetaVideo? {
+        let numbered = videos
+            .compactMap { video -> (Int, Int, MetaVideo)? in
+                guard let s = video.season?.intValue, let e = video.episode?.intValue else { return nil }
+                return (Int(s), Int(e), video)
+            }
+            .sorted { ($0.0, $0.1) < ($1.0, $1.1) }
+        guard let index = numbered.firstIndex(where: { $0.0 == season && $0.1 == episode }),
+              index + 1 < numbered.count else { return nil }
+        let next = numbered[index + 1].2
+        return hasAired(next.released, today: today) ? next : nil
+    }
+
+    static func hasAired(_ released: String?, today: Date = Date()) -> Bool {
+        guard let released, released.count >= 10 else { return true }
+        let formatter = DateFormatter()
+        formatter.dateFormat = "yyyy-MM-dd"
+        formatter.timeZone = TimeZone(identifier: "UTC")
+        let todayString = formatter.string(from: today)
+        return String(released.prefix(10)) <= todayString
+    }
+
+    /// "Dune (2021)" for a movie, so Infuse matches the right film; episodes keep their title.
+    static func titleWithYear(_ title: String, year: String?, isEpisode: Bool) -> String {
+        guard !isEpisode, let year,
+              let range = year.range(of: #"(19|20)\d{2}"#, options: .regularExpression) else { return title }
+        let value = String(year[range])
+        return title.contains("(\(value))") ? title : "\(title) (\(value))"
+    }
+}
