diff --git a/iosApp/NuvioTV/Screens/Top10Rank.swift b/iosApp/NuvioTV/Screens/Top10Rank.swift
new file mode 100644
index 00000000..2bea0f57
--- /dev/null
+++ b/iosApp/NuvioTV/Screens/Top10Rank.swift
@@ -0,0 +1,50 @@
+import SwiftUI
+
+/// Fork: Netflix-style "Top 10" rows. Any row whose title says "Top 10" (FlixPatrol rows, etc.)
+/// gets a big outlined rank numeral behind each of its first ten cards. UserDefaults
+/// `fork_top10_numerals` turns it off.
+enum Top10Rank {
+    static func isTop10(_ title: String) -> Bool {
+        guard UserDefaults.standard.object(forKey: "fork_top10_numerals") as? Bool ?? true else { return false }
+        let t = title.lowercased()
+        return t.contains("top 10") || t.contains("top ten") || t.contains("top10")
+    }
+
+    static func ranks(title: String, ids: [String]) -> [String: Int] {
+        guard isTop10(title) else { return [:] }
+        var out: [String: Int] = [:]
+        for (i, id) in ids.prefix(10).enumerated() where out[id] == nil { out[id] = i + 1 }
+        return out
+    }
+
+    /// How far the card slides over its numeral.
+    static func overlap(artworkHeight: CGFloat) -> CGFloat { artworkHeight * 0.16 }
+}
+
+struct Top10Numeral: View {
+    let rank: Int
+    let artworkHeight: CGFloat
+
+    var body: some View {
+        let size = artworkHeight * 0.92
+        ZStack {
+            // Outline: the numeral drawn dark and offset in eight directions, then a dark fill on top.
+            ForEach(0..<8, id: \.self) { i in
+                let a = Double(i) * .pi / 4
+                Text("\(rank)")
+                    .foregroundStyle(Color.white.opacity(0.85))
+                    .offset(x: cos(a) * 3, y: sin(a) * 3)
+            }
+            Text("\(rank)").foregroundStyle(Color.black)
+        }
+        .font(.system(size: size, weight: .black, design: .rounded))
+        .monospacedDigit()
+        .tracking(rank == 10 ? -size * 0.08 : 0)
+        .lineLimit(1)
+        .fixedSize()
+        .frame(height: artworkHeight, alignment: .bottom)
+        .offset(y: size * 0.12)
+        .accessibilityHidden(true)
+        .allowsHitTesting(false)
+    }
+}
