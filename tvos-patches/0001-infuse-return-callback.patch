+
+/// Tracks the stream last handed to Infuse so its x-success callback
+/// (`nuviotv://external-player/infuse/success?position=<seconds>`) can be recorded as watch
+/// progress, the same way the built-in players record theirs.
+@MainActor
+struct InfuseHandoff {
+    let context: PlaybackContext
+    let durationSec: Double?
+
+    static var pending: InfuseHandoff?
+
+    /// Handles Infuse's return URL. Returns true when the URL was an Infuse callback.
+    static func handle(_ url: URL) -> Bool {
+        guard url.scheme == "nuviotv", url.host == "external-player" else { return false }
+        let parts = url.pathComponents.filter { $0 != "/" }
+        guard parts.first == "infuse" else { return false }
+        guard let handoff = pending else { return true }
+        pending = nil
+        guard parts.count >= 2, parts[1] == "success" else { return true }
+        let items = URLComponents(url: url, resolvingAgainstBaseURL: false)?.queryItems ?? []
+        guard let raw = items.first(where: { $0.name == "position" })?.value,
+              let position = Double(raw), position > 1 else { return true }
+        guard let duration = handoff.durationSec, duration > 0 else { return true }
+        PlaybackProgressRecorder(context: handoff.context).record(
+            positionSec: min(position, duration),
+            durationSec: duration,
+            isPaused: true,
+            speed: 1,
+            flush: true
+        )
+        return true
+    }
+
+    /// Minutes from addon runtime strings such as "45 min", "1h 30m" or "2h".
+    static func runtimeMinutes(_ value: String?) -> Int? {
+        guard let text = value?.lowercased(), !text.isEmpty else { return nil }
+        var hours = 0, minutes = 0, current = "", sawUnit = false
+        for ch in text {
+            if ch.isNumber {
+                current.append(ch)
+            } else if ch == "h", let n = Int(current) {
+                hours = n; current = ""; sawUnit = true
+            } else if ch == "m", let n = Int(current) {
+                minutes = n; current = ""; sawUnit = true
+            } else if !current.isEmpty && ch == " " {
+                continue
+            }
+        }
+        if !sawUnit, let n = Int(current) { minutes = n }
+        let total = hours * 60 + minutes
+        return total > 0 ? total : nil
+    }
+}
