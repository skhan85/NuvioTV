+    /// Best-known length of what is being handed to Infuse, in seconds: a previous in-app play's
+    /// exact duration, else the episode's own runtime, else the title runtime. Infuse only returns
+    /// the stop position, so without this completion (90%) could never be detected.
+    private func infuseHandoffDurationSec(storedDurationMs: Int64?) -> Double? {
+        if let ms = storedDurationMs, ms > 0 { return Double(ms) / 1000.0 }
+        let allEpisodes = episodes.isEmpty ? fetchedEpisodes : episodes
+        if let season, let episode,
+           let match = allEpisodes.first(where: { $0.season?.intValue == season && $0.episode?.intValue == episode }),
+           let minutes = match.runtime?.intValue, minutes > 0 {
+            return Double(minutes) * 60
+        }
+        if let minutes = InfuseHandoff.runtimeMinutes(meta?.runtime), minutes > 0 {
+            return Double(minutes) * 60
+        }
+        if let details = MetaDetailsRepository.shared.peek(type: type, id: parentMetaId),
+           let minutes = InfuseHandoff.runtimeMinutes(details.runtime), minutes > 0 {
+            return Double(minutes) * 60
+        }
+        return nil
+    }
+
