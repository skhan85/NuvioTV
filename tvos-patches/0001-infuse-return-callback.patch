diff --git a/iosApp/NuvioTV/Screens/PlaybackProgressRecorder.swift b/iosApp/NuvioTV/Screens/PlaybackProgressRecorder.swift
index f351f3c..5412d01 100644
--- a/iosApp/NuvioTV/Screens/PlaybackProgressRecorder.swift
