diff --git a/shared/src/commonMain/kotlin/com/nuvio/app/features/home/ForkHomeRows.kt b/shared/src/commonMain/kotlin/com/nuvio/app/features/home/ForkHomeRows.kt
new file mode 100644
index 00000000..2d4e69ce
--- /dev/null
+++ b/shared/src/commonMain/kotlin/com/nuvio/app/features/home/ForkHomeRows.kt
@@ -0,0 +1,107 @@
+package com.nuvio.app.features.home
+
+import com.nuvio.app.features.catalog.CatalogTarget
+import com.nuvio.app.features.tmdb.TmdbMetadataService
+import com.nuvio.app.features.watched.WatchedRepository
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+
+/**
+ * Fork: extra Netflix-style Home rows built from TMDB.
+ *  - "Because you watched X": recommendations for the most recently finished titles.
+ *  - "Coming Soon": upcoming movies + streamer series premieres over the next 90 days.
+ * Rows come back as ordinary [HomeCatalogSection]s with no "See All" (nothing behind them).
+ */
+object ForkHomeRows {
+    const val BECAUSE_KEY_PREFIX = "fork.because."
+    const val COMING_SOON_KEY = "fork.comingSoon"
+
+    private val mutex = Mutex()
+    private var becauseSignature: String? = null
+    private var becauseRows: List<HomeCatalogSection> = emptyList()
+    private var comingSoonDay: String? = null
+    private var comingSoonRow: HomeCatalogSection? = null
+
+    suspend fun becauseYouWatched(maxRows: Int = 2): List<HomeCatalogSection> {
+        val watched = WatchedRepository.uiState.value.items
+        val seeds = watched
+            .filter { it.type == "movie" || it.type == "series" }
+            .sortedByDescending { it.markedAtEpochMs }
+            .distinctBy { it.id }
+            .take(maxRows)
+        if (seeds.isEmpty()) return emptyList()
+        val signature = seeds.joinToString("|") { it.id }
+        mutex.withLock { if (signature == becauseSignature) return becauseRows }
+
+        val seenIds = watched.map { it.id }.toSet()
+        val seenNames = watched.map { it.name.trim().lowercase() }.toSet()
+        val usedIds = mutableSetOf<String>()
+        val rows = seeds.mapNotNull { seed ->
+            val items = TmdbMetadataService.recommendationsFor(seed.id, seed.type)
+                .filter { it.id !in seenIds && it.name.trim().lowercase() !in seenNames && usedIds.add(it.id) }
+            if (items.size < 4) return@mapNotNull null
+            section(
+                key = BECAUSE_KEY_PREFIX + seed.id,
+                title = "Because you watched ${seed.name}",
+                type = seed.type,
+                items = items,
+            )
+        }
+        mutex.withLock {
+            becauseSignature = signature
+            becauseRows = rows
+        }
+        return rows
+    }
+
+    suspend fun comingSoon(region: String, nowEpochMs: Long): HomeCatalogSection? {
+        val today = isoDate(nowEpochMs)
+        mutex.withLock { if (today == comingSoonDay && comingSoonRow != null) return comingSoonRow }
+        val until = isoDate(nowEpochMs + 90L * 24 * 60 * 60 * 1000)
+        val items = TmdbMetadataService.comingSoon(region.ifBlank { "US" }.uppercase(), today, until)
+        val row = if (items.size < 4) null else section(COMING_SOON_KEY, "Coming Soon", "movie", items)
+        mutex.withLock {
+            comingSoonDay = today
+            comingSoonRow = row
+        }
+        return row
+    }
+
+    @Throws(Throwable::class)
+    suspend fun becauseYouWatchedChecked(maxRows: Int): List<HomeCatalogSection> = becauseYouWatched(maxRows)
+
+    @Throws(Throwable::class)
+    suspend fun comingSoonChecked(region: String, nowEpochMs: Long): HomeCatalogSection? = comingSoon(region, nowEpochMs)
+
+    /** True when the title's release date (yyyy-MM-dd) is after today. */
+    fun isUnreleased(rawReleaseDate: String?, nowEpochMs: Long): Boolean {
+        val date = rawReleaseDate?.takeIf { it.length >= 10 }?.substring(0, 10) ?: return false
+        return date > isoDate(nowEpochMs)
+    }
+
+    private fun section(key: String, title: String, type: String, items: List<MetaPreview>) = HomeCatalogSection(
+        key = key,
+        title = title,
+        subtitle = "",
+        addonName = "TMDB",
+        target = CatalogTarget.Addon(manifestUrl = "", contentType = type, catalogId = key),
+        items = items,
+        availableItemCount = items.size,
+        hasMore = false,
+    )
+
+    /** UTC yyyy-MM-dd for an epoch time (civil-from-days, no datetime library needed). */
+    fun isoDate(epochMs: Long): String {
+        val days = epochMs.floorDiv(86_400_000L)
+        val z = days + 719_468
+        val era = z.floorDiv(146_097L)
+        val doe = z - era * 146_097
+        val yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365
+        val doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
+        val mp = (5 * doy + 2) / 153
+        val d = doy - (153 * mp + 2) / 5 + 1
+        val m = if (mp < 10) mp + 3 else mp - 9
+        val y = yoe + era * 400 + if (m <= 2) 1 else 0
+        return "${y.toString().padStart(4, '0')}-${m.toString().padStart(2, '0')}-${d.toString().padStart(2, '0')}"
+    }
+}
diff --git a/shared/src/commonMain/kotlin/com/nuvio/app/features/tmdb/TmdbMetadataService.kt b/shared/src/commonMain/kotlin/com/nuvio/app/features/tmdb/TmdbMetadataService.kt
index 7ea68789..5b66ed2e 100644
--- a/shared/src/commonMain/kotlin/com/nuvio/app/features/tmdb/TmdbMetadataService.kt
+++ b/shared/src/commonMain/kotlin/com/nuvio/app/features/tmdb/TmdbMetadataService.kt
@@ -1301,6 +1301,80 @@ object TmdbMetadataService {
         }.getOrNull()
     }
 
+    /**
+     * Fork: "Because you watched X" — TMDB recommendations for any Nuvio id (tmdb:/tt…).
+     * Empty when the title can't be matched to TMDB or no key is configured.
+     */
+    suspend fun recommendationsFor(id: String, type: String): List<MetaPreview> {
+        val mediaType = if (type.equals("series", true) || type.equals("tv", true)) "tv" else "movie"
+        val tmdbId = runCatching { TmdbService.ensureTmdbId(id, mediaType) }.getOrNull()
+            ?.toIntOrNull() ?: return emptyList()
+        val language = normalizeTmdbLanguage(TmdbSettingsRepository.snapshot().language)
+        return fetchMoreLikeThis(tmdbId = tmdbId, mediaType = mediaType, language = language)
+    }
+
+    /**
+     * Fork: "Coming Soon" — upcoming movies for [region] plus new series premiering on the big
+     * streamers, release dates from [fromDate] to [toDate] (yyyy-MM-dd), soonest first.
+     */
+    suspend fun comingSoon(region: String, fromDate: String, toDate: String): List<MetaPreview> = coroutineScope {
+        val language = normalizeTmdbLanguage(TmdbSettingsRepository.snapshot().language)
+        val movies = async {
+            fetch<TmdbRecommendationResponse>(
+                endpoint = "discover/movie",
+                query = mapOf(
+                    "language" to language,
+                    "region" to region,
+                    "sort_by" to "popularity.desc",
+                    "with_release_type" to "2|3|4",
+                    "release_date.gte" to fromDate,
+                    "release_date.lte" to toDate,
+                ),
+            )?.results.orEmpty().map { it to "movie" }
+        }
+        val series = async {
+            fetch<TmdbRecommendationResponse>(
+                endpoint = "discover/tv",
+                query = mapOf(
+                    "language" to language,
+                    "sort_by" to "popularity.desc",
+                    "with_networks" to "213|2739|2552|1024|3186|49|453|4330|2697",
+                    "first_air_date.gte" to fromDate,
+                    "first_air_date.lte" to toDate,
+                ),
+            )?.results.orEmpty().map { it to "series" }
+        }
+        (movies.await().take(14) + series.await().take(8))
+            .mapNotNull { (item, type) ->
+                val date = (item.releaseDate ?: item.firstAirDate)?.takeIf { it.length >= 10 } ?: return@mapNotNull null
+                if (date < fromDate) return@mapNotNull null
+                val poster = buildImageUrl(item.posterPath, "w500") ?: return@mapNotNull null
+                val title = item.title?.trim()?.takeIf(String::isNotBlank)
+                    ?: item.name?.trim()?.takeIf(String::isNotBlank)
+                    ?: return@mapNotNull null
+                MetaPreview(
+                    id = "tmdb:${item.id}",
+                    type = type,
+                    name = title,
+                    poster = poster,
+                    banner = buildImageUrl(item.backdropPath, "w1280"),
+                    posterShape = PosterShape.Poster,
+                    description = item.overview?.trim()?.takeIf(String::isNotBlank),
+                    releaseInfo = comingSoonLabel(date),
+                    rawReleaseDate = date,
+                )
+            }
+            .distinctBy { it.id }
+            .sortedBy { it.rawReleaseDate }
+    }
+
+    private fun comingSoonLabel(date: String): String {
+        val months = listOf("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec")
+        val month = date.substring(5, 7).toIntOrNull()?.let { months.getOrNull(it - 1) } ?: return date
+        val day = date.substring(8, 10).toIntOrNull() ?: return date
+        return "$month $day"
+    }
+
     private suspend fun fetchMoreLikeThis(
         tmdbId: Int,
         mediaType: String,
