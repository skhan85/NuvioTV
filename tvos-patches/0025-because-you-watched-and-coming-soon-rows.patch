+    /// Fork: (re)builds the "Because you watched" and "Coming Soon" rows. Cheap to call on every
+    /// Home appearance — the shared side caches by last-watched titles and by day.
+    /// UserDefaults `fork_because_rows` / `fork_coming_soon_row` turn each off.
+    func refreshForkRows() {
+        forkRowsTask?.cancel()
+        let gen = pipelineGeneration
+        forkRowsTask = Task { @MainActor [weak self] in
+            let defaults = UserDefaults.standard
+            var because: [HomeCatalogSection] = []
+            if defaults.object(forKey: "fork_because_rows") as? Bool ?? true {
+                because = (try? await ForkHomeRows.shared.becauseYouWatchedChecked(maxRows: 2)) ?? []
+            }
+            var soon: HomeCatalogSection?
+            if defaults.object(forKey: "fork_coming_soon_row") as? Bool ?? true {
+                let region = Locale.current.region?.identifier ?? "US"
+                let now = Int64(Date().timeIntervalSince1970 * 1000)
+                soon = try? await ForkHomeRows.shared.comingSoonChecked(region: region, nowEpochMs: now)
+            }
+            guard let self, !Task.isCancelled, self.pipelineGeneration == gen else { return }
+            self.becauseRows = because
+            self.comingSoon = soon
+        }
+    }
+
