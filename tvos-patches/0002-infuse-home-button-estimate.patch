+
+    /// NuvioTV is back in the foreground. The time away is added to the estimate, except for a
+    /// stretch longer than the rest of the title plus 30 minutes (e.g. Infuse left with Home and
+    /// NuvioTV only reopened the next day), which says nothing about how much was watched.
+    static func onForeground() {
+        guard var handoff = pending, !handoff.estimationClosed, let since = handoff.awaySince else { return }
+        let stretch = max(0, Date().timeIntervalSince(since))
+        if let duration = handoff.durationSec,
