+        }
+        handoff.awaySince = nil
+        handoff.foregroundSince = Date()
+        pending = handoff
+    }
+
+    /// Records an estimated position when Infuse was left without its callback. Deliberately
+    /// conservative: set back a little (so resuming rewinds rather than skips) and capped at 79%,
+    /// below the 90% watched threshold and the 80% at which trackers count a play, so an estimate
+    /// never marks a title watched. Pauses in Infuse cannot be seen and count as watching. The
+    /// handoff stays pending, so a later Back from Infuse still records the exact position.
+    static func recordEstimateIfNeeded() {
+        guard let handoff = pending, !handoff.estimationClosed,
+              let duration = handoff.durationSec, duration > 0 else { return }
+        guard Date().timeIntervalSince(handoff.launchedAt) < 6 * 60 * 60 else { return }
+        guard handoff.awaySec >= 120 else { return }
+        let margin = max(60, handoff.awaySec / 20)
+        let estimate = min(handoff.startSec + handoff.awaySec - margin, duration * 0.79)
