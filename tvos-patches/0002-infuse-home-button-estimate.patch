+    /// NuvioTV left the foreground while a handoff is still waiting for Infuse's callback.
+    static func onBackground() {
+        guard var handoff = pending, !handoff.estimationClosed, handoff.awaySince == nil else { return }
+        if let back = handoff.foregroundSince, Date().timeIntervalSince(back) > 60 {
+            handoff.estimationClosed = true
+            handoff.foregroundSince = nil
+            pending = handoff
