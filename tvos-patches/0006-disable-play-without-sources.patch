diff --git a/shared/src/commonMain/kotlin/com/nuvio/app/features/streams/PlaybackAvailability.kt b/shared/src/commonMain/kotlin/com/nuvio/app/features/streams/PlaybackAvailability.kt
new file mode 100644
index 0000000..d3855be
--- /dev/null
+++ b/shared/src/commonMain/kotlin/com/nuvio/app/features/streams/PlaybackAvailability.kt
@@ -0,0 +1,49 @@
+package com.nuvio.app.features.streams
+
+import com.nuvio.app.core.build.FeaturePolicyProvider
+import com.nuvio.app.features.addons.AddonRepository
+import com.nuvio.app.features.addons.enabledAddons
+import com.nuvio.app.features.details.MetaDetailsRepository
+import com.nuvio.app.features.plugins.PluginScraperHostProvider
+
+/**
+ * Upstream 972109f9 ("disable play when no source is available"), shaped for tvOS: whether any
+ * installed source could answer a stream request for this title, so Detail can say so up front
+ * instead of opening an empty stream list.
+ *
+ * Deliberately errs towards `true`: it only says no when the add-on list has settled and nothing
+ * can answer. It mirrors [StreamsRepository]'s own matching, including BUG-74's `tmdb:` to IMDb
+ * remap, so a title the stream list could still reach is never blocked here. tvOS has no
+ * downloads, so upstream's download fallback is left out.
+ */
+object PlaybackAvailability {
+    fun canStream(type: String, videoId: String): Boolean {
+        val state = AddonRepository.uiState.value
+        if (!state.isInitialized) return true
+        val addons = state.addons.enabledAddons()
+        // A manifest still loading could be the one that answers.
+        if (addons.any { it.manifest == null && it.isRefreshing }) return true
+
+        val remappable = StreamVideoIdRemap.parseTmdbId(videoId) != null
+        val addonCanAnswer = addons.any { addon ->
+            val manifest = addon.manifest ?: return@any false
+            manifest.resources.any { resource ->
+                resource.name == "stream" &&
+                    resource.types.contains(type) &&
+                    (
+                        StreamVideoIdRemap.accepts(resource.idPrefixes, videoId) ||
+                            (remappable && StreamVideoIdRemap.accepts(resource.idPrefixes, "tt0000000"))
+                        )
+            }
+        }
+        if (addonCanAnswer) return true
+
+        if (FeaturePolicyProvider.policy.pluginsEnabled) {
+            val host = PluginScraperHostProvider.host
+            host.initialize()
+            if (host.getEnabledScrapersForType(type).isNotEmpty()) return true
+        }
+
+        return MetaDetailsRepository.findEmbeddedStreams(videoId).isNotEmpty()
+    }
+}
