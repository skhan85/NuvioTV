+    /// Fork: Infuse reads its subtitle once, when playback starts. The add-on subtitle goes through
+    /// Kuiper's relay with the video named (`/v/`), and the relay's subsync container needs ~20-35 s
+    /// the first time a subtitle meets a video. Infuse would get the unsynced copy, so this asks the
+    /// relay first (`?wait=35`, the same warm-up the iPhone fork does) and opens Infuse once the
+    /// synced copy is ready — immediately when it was synced before. Menu skips the wait.
+    private func launchExternally(urlString: String, stream: StreamItem, listed: StreamItem, playerId: String,
+                                  fallbackToInternal: Bool = false, autoAttempt: Int? = nil,
+                                  completion: @escaping (Bool) -> Void = { _ in }) {
+        guard playerId == Self.infusePlayerId, !syncingSubtitles else {
+            if !syncingSubtitles {
+                completion(openExternally(urlString: urlString, stream: stream, listed: listed, playerId: playerId,
+                                          fallbackToInternal: fallbackToInternal, autoAttempt: autoAttempt))
+            }
+            return
+        }
+        let subtitles = InfuseSubtitlePicker.subtitles(for: stream, videoURL: urlString)
+        let syncLinks = subtitles.map { $0.url }.filter { InfuseSubtitlePicker.isSyncLink($0) }
+        let open = {
+            completion(openExternally(urlString: urlString, stream: stream, listed: listed, playerId: playerId,
+                                      fallbackToInternal: fallbackToInternal, autoAttempt: autoAttempt,
+                                      subtitles: subtitles))
+        }
+        guard !syncLinks.isEmpty else {
+            open()
+            return
+        }
+        withAnimation { syncingSubtitles = true }
+        subtitleSyncTask = Task { @MainActor in
+            await InfuseSubtitlePicker.warmUpSync(syncLinks)
+            // Cleared by onDisappear: the viewer left, so nothing opens.
+            guard syncingSubtitles else { return }
+            withAnimation { syncingSubtitles = false }
+            subtitleSyncTask = nil
+            open()
+        }
+    }
+
