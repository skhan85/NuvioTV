diff --git a/iosApp/NuvioTVTests/InfuseSubtitlePickerTests.swift b/iosApp/NuvioTVTests/InfuseSubtitlePickerTests.swift
new file mode 100644
index 00000000..d148fa01
--- /dev/null
+++ b/iosApp/NuvioTVTests/InfuseSubtitlePickerTests.swift
@@ -0,0 +1,40 @@
+import XCTest
+@testable import NuvioTV
+
+/// Fork: add-on subtitles handed to Infuse (`InfuseSubtitlePicker`).
+final class InfuseSubtitlePickerTests: XCTestCase {
+    private typealias C = InfuseSubtitlePicker.Candidate
+
+    func testKeepsStreamSubtitlesThenAFewMatchingAddonOnesPerLanguage() {
+        let own = [C(url: "https://s/own.srt", name: "Own", language: "en")]
+        let english = (1...5).map { C(url: "https://os/en/\($0)", name: "EN \($0)", language: "en") }
+        let french = [C(url: "https://os/fr/1", name: "FR", language: "fr")]
+        let arabic = [C(url: "https://os/ar/1", name: "AR", language: "ar")]
+        let picked = InfuseSubtitlePicker.pick(
+            streamSubtitles: own,
+            addonSubtitles: english + french + arabic + [english[0]],
+            matches: { $0 == "en" || $0 == "ar" }
+        )
+        XCTAssertEqual(picked, own + Array(english.prefix(InfuseSubtitlePicker.maxPerLanguage)) + arabic)
+    }
+
+    func testSkipsAddonCopiesOfTheStreamsOwnSubtitles() {
+        let own = [C(url: "https://s/1", name: "Own", language: "en")]
+        let picked = InfuseSubtitlePicker.pick(
+            streamSubtitles: own,
+            addonSubtitles: [C(url: "https://s/1", name: "Dup", language: "en")],
+            matches: { _ in true }
+        )
+        XCTAssertEqual(picked, own)
+    }
+
+    func testNoTargetLanguageSendsOnlyTheStreamsSubtitles() {
+        let own = [C(url: "https://s/1", name: "Own", language: "de")]
+        let picked = InfuseSubtitlePicker.pick(
+            streamSubtitles: own,
+            addonSubtitles: [C(url: "https://os/en/1", name: "EN", language: "en")],
+            matches: { _ in false }
+        )
+        XCTAssertEqual(picked, own)
+    }
+}
