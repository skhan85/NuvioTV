+                Text(label).font(.system(size: 22)).foregroundColor(.white.opacity(0.6))
+            }
+            .padding(24)
+            .frame(maxWidth: .infinity, alignment: .leading)
+            .background(Color.white.opacity(0.08), in: RoundedRectangle(cornerRadius: 20))
+        }
+        .buttonStyle(.card)
+    }
+
+    private func achievement(_ a: ForkWatchStats.Achievement) -> some View {
+        let colors: [Color] = [.gray, .brown, Color(white: 0.8), .yellow]
+        let color = colors[min(a.tier, 3)]
+        return Button {} label: {
+            VStack(spacing: 12) {
+                ZStack {
+                    Circle().stroke(Color.white.opacity(0.15), lineWidth: 10)
+                    Circle()
+                        .trim(from: 0, to: CGFloat(a.progress))
+                        .stroke(color, style: StrokeStyle(lineWidth: 10, lineCap: .round))
+                        .rotationEffect(.degrees(-90))
+                    Image(systemName: a.tier > 0 ? "medal.fill" : "medal")
+                        .font(.system(size: 40)).foregroundColor(color)
+                }
+                .frame(width: 110, height: 110)
+                Text(a.title).font(.system(size: 26, weight: .semibold)).foregroundColor(.white)
+                Text(a.detail).font(.system(size: 20)).foregroundColor(.white.opacity(0.6))
+            }
+            .padding(20)
+            .frame(maxWidth: .infinity)
+        }
+        .buttonStyle(.card)
+    }
+
+    @ViewBuilder
+    private var diaryPage: some View {
+        if let s = stats {
+            if s.days.isEmpty {
+                empty("Nothing watched yet. Finished titles show up here, day by day.")
+            }
+            LazyVStack(alignment: .leading, spacing: 16) {
+                ForEach(Array(s.days.enumerated()), id: \.element.id) { index, day in
+                    if index == 0 || s.days[index - 1].date.prefix(7) != day.date.prefix(7) {
+                        section(Self.monthTitle(day.date))
+                    }
+                    Text(Self.dayTitle(day.date)).font(.system(size: 22)).foregroundColor(.white.opacity(0.6))
+                    ForEach(day.entries) { row(poster: $0.poster, title: $0.name, detail: $0.detail) }
+                }
+            }
+        } else {
+            ProgressView()
+        }
+    }
+
+    @ViewBuilder
+    private var calendarPage: some View {
+        if let calendar {
+            if calendar.isEmpty {
+                empty("Nothing coming up in the next 60 days for your Library or the shows you're watching.")
+            }
+            let today = Self.parser.string(from: Date())
+            LazyVStack(alignment: .leading, spacing: 16) {
+                ForEach(Array(calendar.enumerated()), id: \.element.id) { index, entry in
+                    if index == 0 || calendar[index - 1].date != entry.date {
+                        section(entry.date == today ? "Today" : Self.dayTitle(entry.date))
+                    }
+                    row(poster: entry.poster, title: entry.name, detail: entry.label, dimmed: entry.date < today) {
+                        onOpen?(entry.metaId, entry.metaType)
+                    }
+                }
+            }
+        } else {
+            HStack(spacing: 16) {
+                ProgressView()
+                Text("Checking your library…").foregroundColor(.white.opacity(0.6))
+            }
+        }
+    }
+
+    private func row(poster: String?, title: String, detail: String, dimmed: Bool = false,
+                     action: @escaping () -> Void = {}) -> some View {
+        Button(action: action) {
+            HStack(spacing: 20) {
+                AsyncImage(url: poster.flatMap(URL.init(string:))) { image in
+                    image.resizable().scaledToFill()
+                } placeholder: {
+                    Color.white.opacity(0.08)
+                }
+                .frame(width: 60, height: 90)
+                .clipShape(RoundedRectangle(cornerRadius: 8))
+                VStack(alignment: .leading, spacing: 4) {
+                    Text(title).font(.system(size: 28, weight: .semibold)).foregroundColor(.white).lineLimit(1)
+                    Text(detail).font(.system(size: 22)).foregroundColor(.white.opacity(0.6)).lineLimit(2)
+                }
+                Spacer()
+            }
+            .padding(.vertical, 6)
+            .padding(.horizontal, 12)
+            .opacity(dimmed ? 0.55 : 1)
+        }
+        .buttonStyle(.card)
+        .frame(maxWidth: 1100, alignment: .leading)
+    }
+
+    private func section(_ text: String) -> some View {
+        Text(text).font(.system(size: 34, weight: .bold)).foregroundColor(.white).padding(.top, 16)
+    }
+
+    private func empty(_ text: String) -> some View {
+        Text(text).font(.system(size: 26)).foregroundColor(.white.opacity(0.6))
+    }
+}
diff --git a/tvosApp/NuvioTV/Sources/Fork/KidsFork.swift b/tvosApp/NuvioTV/Sources/Fork/KidsFork.swift
new file mode 100644
index 00000000..91ac5b16
--- /dev/null
+++ b/tvosApp/NuvioTV/Sources/Fork/KidsFork.swift
@@ -0,0 +1,139 @@
+import Foundation
+import SwiftUI
+
+// MARK: - Fork: Kids rating limit (Disney+-style)
+
+/// Fork: on a profile with `fork_kids_rating_limit` on, titles rated above PG / TV-PG are hidden
+/// from Home rows, collections, search and More Like This. A title's rating comes from its own
+/// metadata when it has one, otherwise from TMDB (cached on the device). Titles whose rating is
+/// unknown stay hidden: a kids profile should rather miss a title than show the wrong one.
+@MainActor
+final class ForkKidsFilter: ObservableObject {
+    static let shared = ForkKidsFilter()
+    static let enabledKey = "fork_kids_rating_limit"
+
+    /// Ratings a kids profile may see, across the systems TMDB reports (US, UK, DE/AT, BR, ...).
+    nonisolated static let allowedRatings: Set<String> = [
+        "G", "PG", "TV-Y", "TV-Y7", "TV-Y7-FV", "TV-G", "TV-PG",
+        "U", "UC", "0", "6", "L", "AL", "ALL", "TP", "Livre"
+    ]
+
+    /// Bumped (at most twice a second) as ratings arrive, so views re-filter.
+    @Published private(set) var revision = 0
+
+    private var verdicts: [String: Bool]
+    private var inFlight = Set<String>()
+    private var queue: [NuvioMeta] = []
+    private var running = 0
+    private var publishScheduled = false
+    private static let maxConcurrent = 6
+    private static let storeKey = "fork_kids_rating_verdicts_v1"
+
+    private init() {
+        verdicts = (UserDefaults.standard.dictionary(forKey: Self.storeKey) as? [String: Bool]) ?? [:]
+    }
+
+    /// Whether the active profile has the kids rating limit on.
+    static var isActive: Bool {
+        ProfileSettings.current.bool(forKey: enabledKey)
+    }
+
+    nonisolated static func isAllowedRating(_ rating: String) -> Bool {
+        let normalized = rating.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !normalized.isEmpty else { return false }
+        return allowedRatings.contains(normalized) || allowedRatings.contains(normalized.uppercased())
+    }
+
+    /// true / false once known; nil while the rating is still being looked up.
+    func verdict(for meta: NuvioMeta) -> Bool? {
+        if let cert = meta.certification?.trimmingCharacters(in: .whitespacesAndNewlines), !cert.isEmpty {
+            return Self.isAllowedRating(cert)
+        }
+        return verdicts[meta.id]
+    }
+
+    /// The items a kids profile may see right now (everything when the limit is off). Unknown
+    /// ratings are looked up in the background and the list fills in as they arrive.
+    func visible(_ items: [NuvioMeta]) -> [NuvioMeta] {
+        guard Self.isActive else { return items }
+        _ = revision
+        var unknown: [NuvioMeta] = []
+        let allowed = items.filter { meta in
+            switch verdict(for: meta) {
+            case .some(let ok): return ok
+            case .none:
+                unknown.append(meta)
+                return false
+            }
+        }
+        if !unknown.isEmpty { enqueue(unknown) }
+        return allowed
+    }
+
+    /// More Like This entries (`RelatedTitle`) through the same filter.
+    func visible(_ titles: [RelatedTitle]) -> [RelatedTitle] {
+        guard Self.isActive else { return titles }
+        let allowedIds = Set(visible(titles.map(\.asMeta)).map(\.id))
+        return titles.filter { allowedIds.contains($0.id) }
+    }
+
+    /// Waits for every rating, then returns what a kids profile may see (used by search, whose
+    /// short result list is worth a brief wait rather than filling in afterwards).
+    func resolvedVisible(_ items: [NuvioMeta]) async -> [NuvioMeta] {
+        guard Self.isActive else { return items }
+        let unknown = items.filter { verdict(for: $0) == nil }
+        await withTaskGroup(of: (String, Bool).self) { group in
+            for meta in unknown.prefix(60) {
+                group.addTask {
+                    let cert = await TmdbDetailsService.fetchCertification(for: meta)
+                    return (meta.id, cert.map { ForkKidsFilter.isAllowedRating($0) } ?? false)
+                }
+            }
+            for await (id, ok) in group { verdicts[id] = ok }
+        }
+        persist()
+        return items.filter { verdict(for: $0) == true }
+    }
+
+    private func enqueue(_ metas: [NuvioMeta]) {
+        for meta in metas where !inFlight.contains(meta.id) {
+            inFlight.insert(meta.id)
+            queue.append(meta)
+        }
+        pump()
+    }
+
+    private func pump() {
+        while running < Self.maxConcurrent, !queue.isEmpty {
+            let meta = queue.removeFirst()
+            running += 1
+            Task { @MainActor in
+                let cert = await TmdbDetailsService.fetchCertification(for: meta)
+                verdicts[meta.id] = cert.map { Self.isAllowedRating($0) } ?? false
+                inFlight.remove(meta.id)
+                running -= 1
+                schedulePublish()
+                pump()
+            }
+        }
+    }
+
+    private func schedulePublish() {
+        guard !publishScheduled else { return }
+        publishScheduled = true
+        DispatchQueue.main.asyncAfter(deadline: .now() + 0.5) { [weak self] in
+            guard let self else { return }
+            publishScheduled = false
+            revision &+= 1
+            persist()
+        }
+    }
+
+    private func persist() {
+        // Ratings rarely change; keep the newest few thousand.
+        if verdicts.count > 4000 {
+            verdicts = Dictionary(uniqueKeysWithValues: verdicts.prefix(3000).map { ($0.key, $0.value) })
+        }
+        UserDefaults.standard.set(verdicts, forKey: Self.storeKey)
+    }
+}
diff --git a/tvosApp/NuvioTV/Sources/Fork/LanguagesFork.swift b/tvosApp/NuvioTV/Sources/Fork/LanguagesFork.swift
new file mode 100644
index 00000000..cb3e4bcc
--- /dev/null
+++ b/tvosApp/NuvioTV/Sources/Fork/LanguagesFork.swift
@@ -0,0 +1,175 @@
+import Foundation
+import SwiftUI
+
+// MARK: - Fork: language tags and audio-language-first sources
+
+/// Audio languages a source says it has, read from its name, text and file name ("Hindi",
+/// "Dual Audio", "🇮🇳 Hindi | English", "MULTi"). Shown as small tags on the source card; and
+/// when the profile's audio language isn't English, sources in that language move to the top
+/// of the list, so Infuse (which can't be told which audio track to pick) gets the right file.
+enum ForkStreamLanguages {
+    struct Tags: Equatable, Sendable {
+        /// Non-English audio languages, Indian languages first.
+        var languages: [String] = []
+        var multiAudio = false
+        var isEmpty: Bool { languages.isEmpty && !multiAudio }
+    }
+
+    /// Name and the words or flags that mean it. Order is the order tags are shown in.
+    private static let table: [(name: String, pattern: String)] = [
+        ("Hindi", #"\bhindi\b|\bhin\b|🇮🇳"#),
+        ("Tamil", #"\btamil\b"#),
+        ("Telugu", #"\btelugu\b"#),
+        ("Malayalam", #"\bmalayalam\b"#),
+        ("Kannada", #"\bkannada\b"#),
+        ("Punjabi", #"\bpunjabi\b"#),
+        ("Bengali", #"\bbengali\b"#),
+        ("Marathi", #"\bmarathi\b"#),
+        ("Urdu", #"\burdu\b"#),
+        ("Spanish", #"\bspanish\b|\blatino\b|\bcastellano\b|🇪🇸|🇲🇽"#),
+        ("French", #"\bfrench\b|\btruefrench\b|\bvff\b|🇫🇷"#),
+        ("German", #"\bgerman\b|🇩🇪"#),
+        ("Italian", #"\bitalian\b|🇮🇹"#),
+        ("Portuguese", #"\bportuguese\b|🇵🇹|🇧🇷"#),
+        ("Russian", #"\brussian\b|🇷🇺"#),
+        ("Arabic", #"\barabic\b|🇸🇦"#),
+        ("Turkish", #"\bturkish\b|🇹🇷"#),
+        ("Japanese", #"\bjapanese\b|🇯🇵"#),
+        ("Korean", #"\bkorean\b|🇰🇷"#),
+        ("Chinese", #"\bchinese\b|\bmandarin\b|\bcantonese\b|🇨🇳"#)
+    ]
+    private static let compiled: [(name: String, regex: NSRegularExpression)] = table.compactMap { entry in
+        guard let regex = try? NSRegularExpression(pattern: entry.pattern, options: [.caseInsensitive]) else { return nil }
+        return (name: entry.name, regex: regex)
+    }
+    private static let english = try? NSRegularExpression(pattern: #"\benglish\b|\beng\b|🇬🇧|🇺🇸"#, options: [.caseInsensitive])
+    /// "Multi Audio", "Dual-Audio", "multi lang", or a bare "MULTi" (not "multi sub").
+    private static let multi = try? NSRegularExpression(
+        pattern: #"\b(multi|dual)[ ._-]?(audio|lang|language)s?\b|\bmulti\b(?![ ._-]?subs?\b)"#,
+        options: [.caseInsensitive]
+    )
+
+    /// AIOStreams rewrites each source's text and lists its audio languages as small-caps ISO codes after a
+    /// marker ("📣 ᴇɴ • ʜɪ • ᴋᴏ"), which the words and flags above never match. The codes on such a line are
+    /// turned back into names ("English Hindi Korean") and added to the text, so tags and the
+    /// preferred-language order see them too.
+    private static let codeNames: [String: String] = [
+        "en": "English", "eng": "English", "hi": "Hindi", "ta": "Tamil", "te": "Telugu", "ml": "Malayalam",
+        "kn": "Kannada", "pa": "Punjabi", "bn": "Bengali", "mr": "Marathi", "ur": "Urdu", "es": "Spanish",
+        "fr": "French", "de": "German", "it": "Italian", "pt": "Portuguese", "ru": "Russian", "ar": "Arabic",
+        "tr": "Turkish", "ja": "Japanese", "ko": "Korean", "zh": "Chinese"
+    ]
+    private static let smallCaps: [Character: Character] = [
+        "ᴀ": "a", "ʙ": "b", "ᴄ": "c", "ᴅ": "d", "ᴇ": "e", "ꜰ": "f", "ɢ": "g", "ʜ": "h", "ɪ": "i",
+        "ᴊ": "j", "ᴋ": "k", "ʟ": "l", "ᴍ": "m", "ɴ": "n", "ᴏ": "o", "ᴘ": "p", "ǫ": "q", "ʀ": "r",
+        "ꜱ": "s", "ᴛ": "t", "ᴜ": "u", "ᴠ": "v", "ᴡ": "w", "ʏ": "y", "ᴢ": "z"
+    ]
+    private static let languageMarkers = ["📣", "🗣"]
+
+    static func withAioLanguages(_ text: String) -> String {
+        var names: [String] = []
+        for line in text.components(separatedBy: .newlines) {
+            guard let marker = languageMarkers.compactMap({ line.range(of: $0)?.lowerBound }).min() else { continue }
+            let plain = String(line[marker...].map { smallCaps[$0] ?? $0 }).lowercased()
+            let tokens = plain.components(separatedBy: CharacterSet(charactersIn: "abcdefghijklmnopqrstuvwxyz-").inverted)
+            for token in tokens {
+                let code = token.split(separator: "-").first.map(String.init) ?? ""
+                guard (2...3).contains(code.count), let name = codeNames[code], !names.contains(name) else { continue }
+                names.append(name)
+            }
+        }
+        return names.isEmpty ? text : text + "\n" + names.joined(separator: " ")
+    }
+
+    private static func found(_ regex: NSRegularExpression?, in text: String) -> Bool {
+        guard let regex else { return false }
+        return regex.firstMatch(in: text, range: NSRange(text.startIndex..., in: text)) != nil
+    }
+
+    static func tags(for stream: NuvioStream) -> Tags {
+        let text = [stream.name, stream.description, stream.filename]
+            .compactMap { $0 }
+            .joined(separator: "\n")
+        return tags(text: text)
+    }
+
+    static func tags(text raw: String) -> Tags {
+        guard !raw.isEmpty else { return Tags() }
+        let text = withAioLanguages(raw)
+        let languages = compiled.filter { found($0.regex, in: text) }.map(\.name)
+        let hasEnglish = found(english, in: text)
+        let multiAudio = found(multi, in: text) || languages.count + (hasEnglish ? 1 : 0) >= 2
+        return Tags(languages: languages, multiAudio: multiAudio)
+    }
+
+    /// The profile's audio language when sources should be reordered for it: set and not English.
+    /// With "Original", the title's own language (a Bollywood film: Hindi).
+    static func boostLanguage(meta: NuvioMeta?) -> String? {
+        guard let language = SubtitleLanguagePreferences.preferredAudioLanguage(meta: meta),
+              language.caseInsensitiveCompare("English") != .orderedSame,
+              table.contains(where: { $0.name == language }) else { return nil }
+        return language
+    }
+
+    /// Sources that list `language` first, keeping everything else in its order.
+    static func boosted(_ streams: [NuvioStream], meta: NuvioMeta?) -> [NuvioStream] {
+        guard let language = boostLanguage(meta: meta), streams.count > 1 else { return streams }
+        var first: [NuvioStream] = []
+        var rest: [NuvioStream] = []
+        for stream in streams {
+            if tags(for: stream).languages.contains(language) { first.append(stream) } else { rest.append(stream) }
+        }
+        return first.isEmpty ? streams : first + rest
+    }
+}
+
+/// Small tags beside a source's name: "Hindi", "Tamil", "Multi-audio".
+struct ForkStreamLanguageChips: View {
+    let tags: ForkStreamLanguages.Tags
+
+    var body: some View {
+        HStack(spacing: 10) {
+            ForEach(tags.languages.prefix(2), id: \.self) { language in
+                chip(language, highlighted: true)
+            }
+            if tags.multiAudio { chip("Multi-audio", highlighted: false) }
+        }
+        .fixedSize()
+    }
+
+    private func chip(_ text: String, highlighted: Bool) -> some View {
+        Text(text)
+            .font(.system(size: 22, weight: .bold))
+            .foregroundColor(highlighted ? .black : .white)
+            .padding(.horizontal, 12)
+            .padding(.vertical, 3)
+            .background(
+                Capsule().fill(highlighted ? ForkOriginalLanguage.tagColor : Color.white.opacity(0.18))
+            )
+    }
+}
+
+/// The original language of non-English titles, for a small tag on Home cards ("KOREAN").
+enum ForkOriginalLanguage {
+    static let tagColor = Color(red: 1.0, green: 0.71, blue: 0.27)
+    /// TMDB's codes. Codes not listed (and English, or "xx" for no language) get no tag.
+    private static let names: [String: String] = [
+        "ar": "Arabic", "bg": "Bulgarian", "bn": "Bengali", "ca": "Catalan", "cn": "Cantonese",
+        "cs": "Czech", "da": "Danish", "de": "German", "el": "Greek", "es": "Spanish",
+        "et": "Estonian", "fa": "Persian", "fi": "Finnish", "fil": "Filipino", "fr": "French",
+        "gu": "Gujarati", "he": "Hebrew", "hi": "Hindi", "hr": "Croatian", "hu": "Hungarian",
+        "id": "Indonesian", "is": "Icelandic", "it": "Italian", "ja": "Japanese", "ka": "Georgian",
+        "kn": "Kannada", "ko": "Korean", "lt": "Lithuanian", "lv": "Latvian", "ml": "Malayalam",
+        "mr": "Marathi", "ms": "Malay", "nb": "Norwegian", "nl": "Dutch", "no": "Norwegian",
+        "pa": "Punjabi", "pl": "Polish", "pt": "Portuguese", "ro": "Romanian", "ru": "Russian",
+        "sk": "Slovak", "sl": "Slovenian", "sr": "Serbian", "sv": "Swedish", "sw": "Swahili",
+        "ta": "Tamil", "te": "Telugu", "th": "Thai", "tl": "Tagalog", "tr": "Turkish",
+        "uk": "Ukrainian", "ur": "Urdu", "vi": "Vietnamese", "zh": "Chinese"
+    ]
+
+    /// "Korean" for TMDB's "ko"; nil for English and languages that don't get a tag.
+    static func label(forCode code: String?) -> String? {
+        guard let code = code?.lowercased(), !code.isEmpty else { return nil }
+        return names[code]
+    }
+}
diff --git a/tvosApp/NuvioTV/Sources/Fork/NetflixUIFork.swift b/tvosApp/NuvioTV/Sources/Fork/NetflixUIFork.swift
new file mode 100644
index 00000000..ff7ff64c
--- /dev/null
+++ b/tvosApp/NuvioTV/Sources/Fork/NetflixUIFork.swift
@@ -0,0 +1,253 @@
+import Foundation
+import SwiftUI
+
+// MARK: - Fork: Netflix home touches
+
+enum ForkNetflixUI {
+    /// Red TOP 10 tag and New Episode / New Season / Recently Added tags on every card.
+    static let cardBadgesKey = "fork_card_badges"
+    static let netflixRed = Color(red: 0xE5 / 255, green: 0x09 / 255, blue: 0x14 / 255)
+
+    /// Set by the app root whenever the active profile changes.
+    @MainActor static var activeProfileName: String?
+
+    @MainActor static var continueWatchingTitle: String {
+        if let name = activeProfileName?.trimmingCharacters(in: .whitespacesAndNewlines), !name.isEmpty {
+            return "Continue Watching for \(name)"
+        }
+        return "Continue Watching"
+    }
+}
+
+// MARK: Card badges
+
+/// Per-title freshness from TMDB ("New Episode", "New Season", "Recently Added"),
+/// looked up a few at a time and kept on the device for 12 hours.
+@MainActor
+final class ForkCardBadges: ObservableObject {
+    static let shared = ForkCardBadges()
+
+    struct Entry: Codable, Equatable {
+        var primary: String?
+        var secondary: String?
+        /// Original language when it isn't English ("Korean"), see `ForkOriginalLanguage`.
+        var language: String?
+        var at: Double
+    }
+
+    /// Bumped (at most twice a second) as badges arrive, so card overlays redraw.
+    @Published private(set) var revision = 0
+
+    private var entries: [String: Entry]
+    private var inFlight = Set<String>()
+    private var queue: [NuvioMeta] = []
+    private var running = 0
+    private var publishScheduled = false
+    private static let maxConcurrent = 6
+    private static let storeKey = "fork_card_badges_v4"
+    private static let ttl: Double = 12 * 3600
+
+    private init() {
+        if let data = UserDefaults.standard.data(forKey: Self.storeKey),
+           let decoded = try? JSONDecoder().decode([String: Entry].self, from: data) {
+            entries = decoded
+        } else {
+            entries = [:]
+        }
+    }
+
+    static var isEnabled: Bool {
+        ProfileSettings.current.object(forKey: ForkNetflixUI.cardBadgesKey) as? Bool ?? true
+    }
+
+    /// The badge for a title if known; starts a lookup when missing or stale.
+    func entry(for meta: NuvioMeta) -> Entry? {
+        let now = Date().timeIntervalSince1970
+        if let cached = entries[meta.id], now - cached.at < Self.ttl { return cached }
+        enqueue(meta)
+        return entries[meta.id]
+    }
+
+    /// Looks up tags for the start of every row as Home loads, so they're ready before you
+    /// scroll. Queued behind on-screen cards, which still go first.
+    func prefetch(_ sections: [TVHomeSection], perRow: Int = 15) {
+        guard Self.isEnabled else { return }
+        let now = Date().timeIntervalSince1970
+        var added = false
+        for section in sections where section.collectionFolders.isEmpty {
+            for meta in section.items.prefix(perRow) {
+                if let cached = entries[meta.id], now - cached.at < Self.ttl { continue }
+                guard !inFlight.contains(meta.id) else { continue }
+                inFlight.insert(meta.id)
+                queue.insert(meta, at: 0)
+                added = true
+            }
+        }
+        if added { DispatchQueue.main.async { [weak self] in self?.pump() } }
+    }
+
+    private func enqueue(_ meta: NuvioMeta) {
+        guard !inFlight.contains(meta.id) else { return }
+        inFlight.insert(meta.id)
+        queue.append(meta)
+        // Defer so a view body never kicks off work synchronously.
+        DispatchQueue.main.async { [weak self] in self?.pump() }
+    }
+
+    private func pump() {
+        while running < Self.maxConcurrent, !queue.isEmpty {
+            let meta = queue.removeLast() // newest first: what's on screen now
+            running += 1
+            Task { @MainActor in
+                let result = await TmdbDetailsService.fetchFreshness(for: meta)
+                entries[meta.id] = Entry(
+                    primary: result?.primary,
+                    secondary: result?.secondary,
+                    language: ForkOriginalLanguage.label(forCode: result?.language),
+                    at: Date().timeIntervalSince1970
+                )
+                inFlight.remove(meta.id)
+                running -= 1
+                schedulePublish()
+                pump()
+            }
+        }
+    }
+
+    private func schedulePublish() {
+        guard !publishScheduled else { return }
+        publishScheduled = true
+        DispatchQueue.main.asyncAfter(deadline: .now() + 0.5) { [weak self] in
+            guard let self else { return }
+            publishScheduled = false
+            revision &+= 1
+            persist()
+        }
+    }
+
+    private func persist() {
+        let now = Date().timeIntervalSince1970
+        entries = entries.filter { now - $0.value.at < Self.ttl * 4 }
+        if entries.count > 3000 {
+            entries = Dictionary(uniqueKeysWithValues: entries.sorted { $0.value.at > $1.value.at }.prefix(2000).map { ($0.key, $0.value) })
