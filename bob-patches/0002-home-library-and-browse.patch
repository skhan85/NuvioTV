+struct ForkWatchStats {
+    struct Achievement: Identifiable {
+        let id = UUID()
+        let title: String
+        let detail: String
+        let progress: Double
+        let tier: Int
+    }
+    struct DiaryEntry: Identifiable {
+        let id = UUID()
+        let name: String
+        let poster: String?
+        let detail: String
+    }
+    struct DiaryDay: Identifiable {
+        var id: String { date }
+        let date: String
+        let entries: [DiaryEntry]
+    }
+
+    var movies = 0
+    var episodes = 0
+    var showsStarted = 0
+    var showsFinished = 0
+    var estimatedHours = 0
+    var thisMonth = 0
+    var thisYear = 0
+    var longestStreak = 0
+    var topGenres: [String] = []
+    var days: [DiaryDay] = []
+    var achievements: [Achievement] = []
+
+    static func compute(now: Date = Date()) -> ForkWatchStats {
+        let items = WatchedStore.visibleItems()
+        var stats = ForkWatchStats()
+        let calendar = Calendar.current
+        let dayFormatter = DateFormatter()
+        dayFormatter.dateFormat = "yyyy-MM-dd"
+
+        var showIds = Set<String>()
+        var finished = Set<String>()
+        var minutes = 0
+        var genreCounts: [String: Int] = [:]
+        var byDay: [String: [WatchedStoreItem]] = [:]
+        for item in items {
+            let isEpisode = item.season != nil && item.episode != nil
+            if isEpisode {
+                stats.episodes += 1
+                showIds.insert(item.meta.id)
+                minutes += 45
+            } else if item.meta.isSeries {
+                showIds.insert(item.meta.id)
+                finished.insert(item.meta.id)
+            } else {
+                stats.movies += 1
+                minutes += 110
+            }
+            if calendar.isDate(item.watchedAt, equalTo: now, toGranularity: .month) { stats.thisMonth += 1 }
+            if calendar.isDate(item.watchedAt, equalTo: now, toGranularity: .year) { stats.thisYear += 1 }
+            for genre in item.meta.genres ?? [] { genreCounts[genre, default: 0] += 1 }
+            byDay[dayFormatter.string(from: item.watchedAt), default: []].append(item)
+        }
+        for id in showIds where !finished.contains(id) {
+            if let meta = items.first(where: { $0.meta.id == id })?.meta,
+               CatalogWatchedPolicy.hasWatchedAllAiredEpisodes(
+                   videos: meta.videos, watchedEpisodeKeys: WatchedStore.watchedEpisodeKeys(metaId: id)) {
+                finished.insert(id)
+            }
+        }
+        stats.showsStarted = showIds.count
+        stats.showsFinished = finished.count
+        stats.estimatedHours = minutes / 60
+        stats.topGenres = genreCounts.sorted { $0.value > $1.value }.prefix(5).map(\.key)
+
+        // Longest run of consecutive days with something watched.
+        let dates = byDay.keys.compactMap { dayFormatter.date(from: $0) }.sorted()
+        var best = 0, run = 0
+        var previous: Date?
+        for date in dates {
+            if let previous, calendar.dateComponents([.day], from: previous, to: date).day == 1 {
+                run += 1
+            } else {
+                run = 1
+            }
+            best = max(best, run)
+            previous = date
+        }
+        stats.longestStreak = best
+
+        stats.days = byDay.keys.sorted(by: >).prefix(120).map { day in
+            var grouped: [String: (WatchedStoreItem, [String])] = [:]
+            var order: [String] = []
+            for item in byDay[day] ?? [] {
+                if grouped[item.meta.id] == nil { order.append(item.meta.id); grouped[item.meta.id] = (item, []) }
+                if let s = item.season, let e = item.episode { grouped[item.meta.id]?.1.append("S\(s) E\(e)") }
+            }
+            let entries = order.compactMap { id -> DiaryEntry? in
+                guard let (item, eps) = grouped[id] else { return nil }
+                let detail = eps.isEmpty ? (item.meta.isSeries ? "Series" : "Movie") : eps.joined(separator: ", ")
+                return DiaryEntry(name: item.meta.name, poster: item.meta.posterUrl, detail: detail)
+            }
+            return DiaryDay(date: day, entries: entries)
+        }
+
+        func tier(_ value: Int, _ steps: [Int]) -> (Int, Double, Int) {
+            let reached = steps.filter { value >= $0 }.count
+            let next = reached < steps.count ? steps[reached] : steps.last!
+            return (reached, min(1, Double(value) / Double(next)), next)
+        }
+        let m = tier(stats.movies, [10, 50, 200])
+        let e = tier(stats.episodes, [50, 250, 1000])
+        let s = tier(stats.longestStreak, [3, 7, 30])
+        let f = tier(stats.showsFinished, [1, 10, 50])
+        stats.achievements = [
+            Achievement(title: "Film Buff", detail: "\(stats.movies) / \(m.2) movies", progress: m.1, tier: m.0),
+            Achievement(title: "Binger", detail: "\(stats.episodes) / \(e.2) episodes", progress: e.1, tier: e.0),
+            Achievement(title: "On a Roll", detail: "\(stats.longestStreak) / \(s.2) days in a row", progress: s.1, tier: s.0),
+            Achievement(title: "Finisher", detail: "\(stats.showsFinished) / \(f.2) shows finished", progress: f.1, tier: f.0),
+        ]
+        return stats
+    }
+}
