+    /// The card's own remaining text plus "N eps left" (fork). `fork_cw_episodes_left` = false hides it.
+    var forkRemainingText: String {
+        guard UserDefaults.standard.object(forKey: "fork_cw_episodes_left") as? Bool ?? true,
+              let left = forkEpisodesLeft, left > 0 else { return remainingText }
+        let eps = left == 1 ? "1 ep left" : "\(left) eps left"
+        return remainingText.isEmpty ? eps : "\(remainingText) · \(eps)"
+    }
