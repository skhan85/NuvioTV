@@ -0,0 +1,61 @@
+import Foundation
+
+// MARK: - Fork: "What's new in your fork"
+
+/// A short note, shown once after an update, listing what's new in this fork. Add an entry (with
+/// a higher id) whenever a fork feature ships; nothing shows until there's an unseen one.
+enum ForkWhatsNew {
+    struct Entry {
+        let id: Int
+        let date: String
+        let items: [String]
+    }
+
+    static let entries: [Entry] = [
+        Entry(
+            id: 3,
+            date: "Nov 6, 2026",
+            items: [
+                "Home cards now tag every non-English title with its language (KOREAN, SPANISH, HINDI…), not just Indian ones.",
+                "The details page shows a title's original language by name (Korean, not KO), and nothing for English titles."
+            ]
+        ),
+        Entry(
+            id: 2,
+            date: "Nov 6, 2026",
+            items: [
+                "Play Something: a shuffle button at the top of Home that resumes something you're watching or starts an unwatched title from your Library or the Top 10.",
+                "Language tags: sources show Hindi, Tamil, Multi-audio and so on, and Indian titles get a HINDI (or Tamil, Telugu…) tag on Home.",
+                "Set a profile's Preferred Audio to Hindi (Settings > Playback) and Hindi sources are listed first, so Infuse gets the Hindi file.",
+                "Remind Me from any row now sends the full release date, so your iPhone can notify on the day."
+            ]
+        ),
+        Entry(
+            id: 1,
+            date: "Nov 5, 2026",
+            items: [
+                "Coming Soon row on Home: films streaming in the next 60 days and new series, soonest first. Hold Select on one for Remind Me (your iPhone sends the notification on the day).",
+                "Card tags (TOP 10, New Episode, Coming Soon) now show straight away: rows are looked up ahead as Home loads.",
+                "Under the hood: the fork's changes are reorganised so updates from Bob's Nuvio break it less often."
+            ]
+        )
+    ]
+
+    private static let seenKey = "fork_whats_new_seen"
+
+    static var unseen: [Entry] {
+        let seen = UserDefaults.standard.integer(forKey: seenKey)
+        return Array(entries.filter { $0.id > seen }.sorted { $0.id > $1.id }.prefix(3))
+    }
+
+    static var message: String {
+        unseen.map { entry in
+            ([entry.date] + entry.items.map { "•  " + $0 }).joined(separator: "\n")
+        }.joined(separator: "\n\n")
+    }
+
+    static func markSeen() {
+        guard let latest = entries.map(\.id).max() else { return }
+        UserDefaults.standard.set(latest, forKey: seenKey)
+    }
+}
