--- /dev/null
+++ b/tvosApp/NuvioTV/Sources/Fork/PlaySomethingFork.swift
@@ -0,0 +1,88 @@
+import Foundation
+import SwiftUI
+
+// MARK: - Fork: Play Something (Netflix)
+
+/// A button at the top of Home that starts something without browsing: half the time a title
+/// you're in the middle of (resumed where you left off), otherwise an unwatched title from your
+/// Library or today's Top 10. Never the same title twice in a row. Per profile, on by default.
+enum ForkPlaySomething {
+    static let enabledKey = "fork_play_something"
+
+    enum Pick {
+        case resume(ContinueWatchingItem)
+        case title(NuvioMeta)
+    }
+
+    @MainActor private static var lastPickedId: String?
+
+    @MainActor
+    static func pick(continueWatching: [ContinueWatchingItem], sections: [TVHomeSection]) -> Pick? {
+        let today = ContentReleasePolicy.todayIsoDay()
+        // Up Next for an episode that hasn't aired can't be played yet.
+        let resumable = continueWatching.filter { item in
+            !(item.isUpNextEntry && !item.hasAired && !item.isAiringToday) && item.id != lastPickedId
+        }
+
+        var seen = Set<String>()
+        var fresh: [NuvioMeta] = []
+        func consider(_ meta: NuvioMeta) {
+            guard meta.id != lastPickedId,
+                  !continueWatching.contains(where: { $0.meta.id == meta.id }),
+                  !ContentReleasePolicy.isUnreleased(meta, today: today),
+                  !WatchedStore.contains(meta: meta),
+                  seen.insert(meta.id).inserted else { return }
+            fresh.append(meta)
+        }
+        LibraryStore.items().map(\.meta).forEach(consider)
+        sections.flatMap(\.items)
+            .filter { ForkTrendingRows.ranks[$0.id] != nil }
+            .forEach(consider)
+        fresh = ForkKidsFilter.shared.visible(fresh)
+
+        let pick: Pick?
+        if let item = resumable.randomElement(), fresh.isEmpty || Bool.random() {
+            pick = .resume(item)
+        } else if let meta = fresh.randomElement() {
+            pick = .title(meta)
+        } else {
+            pick = nil
+        }
+        switch pick {
+        case .resume(let item)?: lastPickedId = item.id
+        case .title(let meta)?: lastPickedId = meta.id
+        case nil: break
+        }
+        return pick
+    }
+}
+
+struct ForkPlaySomethingButton: View {
+    let action: () -> Void
+    @FocusState private var focused: Bool
+
+    var body: some View {
+        Button(action: action) {
+            HStack(spacing: 14) {
+                Image(systemName: "shuffle")
+                    .font(.system(size: 26, weight: .bold))
+                Text("Play Something")
+                    .font(.system(size: 28, weight: .semibold))
+            }
+            .foregroundColor(focused ? .black : .white)
+            .padding(.horizontal, 30)
+            .padding(.vertical, 14)
+            .background(
+                Capsule().fill(focused ? Color.white : Color.white.opacity(0.16))
+            )
+            .scaleEffect(focused ? 1.06 : 1)
+            .shadow(color: .black.opacity(focused ? 0.45 : 0), radius: 12, y: 4)
+            .animation(.easeOut(duration: 0.16), value: focused)
+        }
+        .buttonStyle(.plain)
+        .focused($focused)
+        .nuvioFocusEffectDisabledIfAvailable()
+        .padding(.leading, TVLayout.rowLeading)
+        .focusSection()
+    }
+}
