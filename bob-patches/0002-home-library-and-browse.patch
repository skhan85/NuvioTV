+/// Upcoming releases for the library: series episodes from -7 to +60 days, and movies with a date.
+enum ForkReleaseCalendar {
+    struct Entry: Identifiable {
+        let id = UUID()
+        let date: String
+        let name: String
+        let poster: String?
+        let label: String
+        /// Fork: the title to open when the row is pressed.
+        let metaId: String
+        let metaType: String
+    }
+
+    static func load(now: Date = Date()) async -> [Entry] {
+        let formatter = DateFormatter()
+        formatter.dateFormat = "yyyy-MM-dd"
+        formatter.timeZone = TimeZone(identifier: "UTC")
+        let from = formatter.string(from: now.addingTimeInterval(-7 * 86_400))
+        let to = formatter.string(from: now.addingTimeInterval(60 * 86_400))
+        // Fork: shows from the Library plus shows watched in the last 120 days, so the agenda
+        // covers what you are actually following (like Stremio's Calendar), not only saved titles.
+        var seen = Set<String>()
+        var library: [NuvioMeta] = []
+        for meta in LibraryStore.items().map(\.meta) where seen.insert(meta.id).inserted {
+            library.append(meta)
+        }
+        let recentCutoff = now.addingTimeInterval(-120 * 86_400)
+        let following = WatchedStore.visibleItems()
+            .filter { $0.meta.isSeries && $0.watchedAt >= recentCutoff }
+            .sorted { $0.watchedAt > $1.watchedAt }
+        for item in following where seen.insert(item.meta.id).inserted {
+            library.append(item.meta)
+        }
+        let repository = CinemetaCatalogRepository()
+
+        return await withTaskGroup(of: [Entry].self) { group in
+            for meta in library.prefix(120) {
+                group.addTask {
+                    if meta.isSeries {
+                        var videos = meta.videos ?? []
+                        if videos.isEmpty, let full = try? await repository.getMetadata(id: meta.id, type: meta.type) {
+                            videos = full.videos ?? []
+                        }
+                        return videos.compactMap { video in
+                            guard video.season > 0, let released = video.released, released.count >= 10 else { return nil }
+                            let day = String(released.prefix(10))
+                            guard day >= from, day <= to else { return nil }
+                            let title = video.title.isEmpty ? "" : " · \(video.title)"
+                            return Entry(date: day, name: meta.name, poster: meta.posterUrl,
+                                         label: "S\(video.season) E\(video.episode)\(title)",
+                                         metaId: meta.id, metaType: meta.type)
+                        }
+                    }
+                    guard let released = meta.released, released.count >= 10 else { return [] }
+                    let day = String(released.prefix(10))
+                    guard day >= from, day <= to else { return [] }
+                    return [Entry(date: day, name: meta.name, poster: meta.posterUrl, label: "Movie",
+                                  metaId: meta.id, metaType: meta.type)]
+                }
+            }
+            var all: [Entry] = []
+            for await entries in group { all += entries }
+            return all.sorted { ($0.date, $0.name) < ($1.date, $1.name) }
+        }
+    }
+}
