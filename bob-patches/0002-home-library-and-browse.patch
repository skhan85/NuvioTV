@@ -0,0 +1,131 @@
+import Foundation
+import SwiftUI
+
+// MARK: - Fork: Disney+ look for a Kids profile
+
+/// Per profile. On: Disney navy background, sky accents, and a row of kids studio tiles
+/// (Disney, Pixar, DreamWorks, Illumination, Nickelodeon, Cartoon Network) above the rows;
+/// each opens that studio's titles.
+enum ForkDisneyKids {
+    static let enabledKey = "fork_disney_style"
+    static let openBrandNotification = Notification.Name("fork.disney.openBrand")
+
+    struct Brand: Identifiable, Hashable {
+        let tmdbId: Int
+        let name: String
+        let kind: MetaCompany.Kind
+        var id: String { "\(kind.rawValue)-\(tmdbId)" }
+    }
+
+    static let brands: [Brand] = [
+        Brand(tmdbId: 2, name: "Disney", kind: .production),
+        Brand(tmdbId: 3, name: "Pixar", kind: .production),
+        Brand(tmdbId: 521, name: "DreamWorks", kind: .production),
+        Brand(tmdbId: 6704, name: "Illumination", kind: .production),
+        Brand(tmdbId: 13, name: "Nickelodeon", kind: .network),
+        Brand(tmdbId: 56, name: "Cartoon Network", kind: .network)
+    ]
+
+    static func open(_ brand: Brand, logoURL: String?) {
+        let company = MetaCompany(name: brand.name, logoURL: logoURL, tmdbId: brand.tmdbId, kind: brand.kind)
+        NotificationCenter.default.post(name: openBrandNotification, object: company)
+    }
+}
+
+/// Studio logos from TMDB, fetched once per launch.
+@MainActor
+final class ForkBrandLogos: ObservableObject {
+    static let shared = ForkBrandLogos()
+    @Published private(set) var logos: [String: String] = [:]
+    private var started = false
+
+    func loadIfNeeded() {
+        guard !started else { return }
+        started = true
+        Task { @MainActor in
+            for brand in ForkDisneyKids.brands {
+                if let path = await TmdbDetailsService.fetchBrandLogoPath(tmdbId: brand.tmdbId, isNetwork: brand.kind == .network) {
+                    logos[brand.id] = "https://image.tmdb.org/t/p/w500" + path
+                }
+            }
+            // Let a later visit retry anything that failed (offline at launch).
+            if logos.count < ForkDisneyKids.brands.count { started = false }
+        }
+    }
+}
+
+struct ForkKidsBrandRow: View {
+    @ObservedObject private var logos = ForkBrandLogos.shared
+
+    var body: some View {
+        HStack(spacing: 28) {
+            ForEach(ForkDisneyKids.brands) { brand in
+                ForkKidsBrandTile(brand: brand, logoURL: logos.logos[brand.id])
+            }
+        }
+        .padding(.leading, TVLayout.rowLeading)
+        .padding(.vertical, 14)
+        .focusSection()
+        .onAppear { logos.loadIfNeeded() }
+    }
+}
+
+private struct ForkKidsBrandTile: View {
+    let brand: ForkDisneyKids.Brand
+    let logoURL: String?
+    @FocusState private var focused: Bool
+
+    var body: some View {
+        Button {
+            ForkDisneyKids.open(brand, logoURL: logoURL)
+        } label: {
+            ZStack {
+                RoundedRectangle(cornerRadius: 14, style: .continuous)
+                    .fill(
+                        LinearGradient(
+                            colors: [Color(red: 0.19, green: 0.23, blue: 0.38), Color(red: 0.10, green: 0.13, blue: 0.24)],
+                            startPoint: .top,
+                            endPoint: .bottom
+                        )
+                    )
+                if let logoURL, let url = URL(string: logoURL) {
+                    AsyncImage(url: url) { phase in
+                        if case .success(let image) = phase {
+                            image
+                                .renderingMode(.template)
+                                .resizable()
+                                .scaledToFit()
+                                .foregroundColor(.white)
+                        } else {
+                            brandName
+                        }
+                    }
+                    .padding(.horizontal, 30)
+                    .padding(.vertical, 26)
+                } else {
+                    brandName
+                }
+            }
+            .frame(width: 236, height: 132)
+            .overlay(
+                RoundedRectangle(cornerRadius: 14, style: .continuous)
+                    .stroke(Color.white.opacity(focused ? 0.95 : 0.16), lineWidth: focused ? 4 : 2)
+            )
+            .scaleEffect(focused ? 1.08 : 1)
+            .shadow(color: .black.opacity(focused ? 0.55 : 0.25), radius: focused ? 18 : 8, y: 6)
+            .animation(.easeOut(duration: 0.18), value: focused)
+        }
+        .buttonStyle(.plain)
+        .focused($focused)
+        .nuvioFocusEffectDisabledIfAvailable()
+    }
+
+    private var brandName: some View {
+        Text(brand.name)
+            .font(.system(size: 26, weight: .bold))
+            .foregroundColor(.white)
+            .multilineTextAlignment(.center)
+            .minimumScaleFactor(0.7)
+            .padding(.horizontal, 16)
+    }
+}
