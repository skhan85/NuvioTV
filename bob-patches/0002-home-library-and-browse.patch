+    /// from the episode guide the card carries. nil for movies or without a guide.
+    var forkEpisodesLeft: Int? {
+        guard meta.isSeries, let season, let episode,
+              let videos = meta.videos, !videos.isEmpty else { return nil }
+        let count = videos.filter { video in
+            guard video.season > 0, video.episode > 0,
+                  EpisodeReleasePolicy.hasAired(video.released) else { return false }
+            if isUpNextEntry { return (video.season, video.episode) >= (season, episode) }
+            return (video.season, video.episode) > (season, episode)
+        }.count
+        return count
+    }
