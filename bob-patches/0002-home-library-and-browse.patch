@@ -0,0 +1,401 @@
+import SwiftUI
+
+// MARK: - Fork: Top 10 numerals
+
+/// Fork: rows whose title says "Top 10" (FlixPatrol rows and the like) get a big outlined rank
+/// numeral on each of their first ten posters. `fork_top10_numerals` = false turns it off.
+enum ForkTop10 {
+    static func isTop10(_ title: String) -> Bool {
+        guard UserDefaults.standard.object(forKey: "fork_top10_numerals") as? Bool ?? true else { return false }
+        let t = title.lowercased()
+        return t.contains("top 10") || t.contains("top ten") || t.contains("top10")
+    }
+}
+
+struct ForkTop10Numeral: View {
+    let rank: Int
+    let cardWidth: CGFloat
+
+    var body: some View {
+        let size = cardWidth * 0.62
+        ZStack {
+            // Outline: the numeral drawn light and offset in eight directions, a dark fill on top.
+            ForEach(0..<8, id: \.self) { i in
+                let a = Double(i) * .pi / 4
+                Text("\(rank)")
+                    .foregroundStyle(Color.white.opacity(0.9))
+                    .offset(x: cos(a) * 3, y: sin(a) * 3)
+            }
+            Text("\(rank)").foregroundStyle(Color.black)
+        }
+        .font(.system(size: size, weight: .black, design: .rounded))
+        .monospacedDigit()
+        .tracking(rank == 10 ? -size * 0.08 : 0)
+        .lineLimit(1)
+        .fixedSize()
+        .shadow(color: .black.opacity(0.6), radius: 6, y: 2)
+        .offset(x: -cardWidth * 0.12, y: size * 0.18)
+        .accessibilityHidden(true)
+        .allowsHitTesting(false)
+    }
+}
+
+// MARK: - Fork: Because you watched
+
+/// Fork: up to two "Because you watched X" rows on Home, built from TMDB recommendations for the two
+/// titles watched most recently (Continue Watching order), under Continue Watching / Upcoming.
+/// Titles already in Continue Watching are left out. `fork_because_rows` = false turns them off
+/// (Settings → Layout → Because You Watched).
+enum ForkBecauseYouWatched {
+    static let enabledKey = "fork_because_rows"
+    static let maxRows = 2
+    static let idPrefix = "fork_because_"
+
+    private static func seeds(_ items: [ContinueWatchingItem]) -> [ContinueWatchingItem] {
+        var seen = Set<String>()
+        return items.sorted { $0.lastWatchedAt > $1.lastWatchedAt }
+            .filter { seen.insert($0.meta.id).inserted }
+            .prefix(maxRows)
+            .map { $0 }
+    }
+
+    static func seedKey(_ items: [ContinueWatchingItem]) -> String {
+        seeds(items).map(\.meta.id).joined(separator: ",")
+    }
+
+    static func sections(seeds items: [ContinueWatchingItem]) async -> [TVHomeSection] {
+        let seeds = seeds(items)
+        let exclude = Set(items.map(\.meta.id))
+        var sections: [TVHomeSection] = []
+        var used = Set<String>()
+        for seed in seeds {
+            let related = await TmdbDetailsService.fetchMoreLikeThis(for: seed.meta, limit: 20)
+            let metas = related.map(\.asMeta).filter { meta in
+                !exclude.contains(meta.id) && used.insert(meta.id).inserted
+            }
+            guard metas.count >= 4 else { continue }
+            sections.append(TVHomeSection(
+                id: idPrefix + seed.meta.id,
+                title: "Because you watched \(seed.meta.name)",
+                items: metas
+            ))
+        }
+        return sections
+    }
+}
+
+// MARK: - Fork: Top 10 and Trending rows
+
+/// Fork: Netflix-style "Top 10 Shows Today", "Top 10 Movies Today" and "Trending Now" rows from
+/// TMDB trending. The Top 10 rows get the rank numerals through their names. Home places the
+/// shows row under Continue Watching, before "Because you watched", and the other two after it.
+/// `fork_trending_rows` = false turns them off (Settings → Layout → Top 10 & Trending).
+enum ForkTrendingRows {
+    static let enabledKey = "fork_trending_rows"
+    /// Per profile (Home reads it through the profile's `.defaultAppStorage`): kid-friendly lists.
+    static let kidsKey = "fork_kids_trending"
+    static let idPrefix = "fork_trending_"
+    /// Refresh at most this often while Home stays mounted.
+    static let refreshSeconds: UInt64 = 3 * 60 * 60
+
+    /// Fork: each Top 10 title's place ("#3 in TV Shows Today") for the details page badge.
+    @MainActor static var ranks: [String: (rank: Int, list: String)] = [:]
+
+    struct Rows {
+        var topShows: TVHomeSection?
+        var topMovies: TVHomeSection?
+        var trendingNow: TVHomeSection?
+        /// Fork: films streaming soon and new series premiering in the next 60 days.
+        var comingSoon: TVHomeSection?
+
+        var isEmpty: Bool { topShows == nil && topMovies == nil && trendingNow == nil && comingSoon == nil }
+    }
+
+    static let comingSoonKey = "fork_coming_soon"
+    static let comingSoonId = idPrefix + "coming_soon"
+
+    static func load(kids: Bool = false) async -> Rows {
+        async let comingSoonList = TmdbDetailsService.fetchComingSoon(kids: kids)
+        let shows: [NuvioMeta]
+        let movies: [NuvioMeta]
+        let week: [NuvioMeta]
+        if kids {
+            // Kids profile: the most popular family / kids titles; Trending Now is the next ones,
+            // films and shows alternating.
+            async let kidsShows = TmdbDetailsService.fetchKidsPopular(mediaType: "tv")
+            async let kidsMovies = TmdbDetailsService.fetchKidsPopular(mediaType: "movie")
+            let allShows = await kidsShows.map(\.asMeta)
+            let allMovies = await kidsMovies.map(\.asMeta)
+            shows = Array(allShows.prefix(10))
+            movies = Array(allMovies.prefix(10))
+            let moreShows = Array(allShows.dropFirst(10))
+            let moreMovies = Array(allMovies.dropFirst(10))
+            week = (0..<max(moreShows.count, moreMovies.count)).flatMap { index in
+                [index < moreMovies.count ? moreMovies[index] : nil,
+                 index < moreShows.count ? moreShows[index] : nil].compactMap { $0 }
+            }
+        } else {
+            async let showsList = TmdbDetailsService.fetchTrending(mediaType: "tv", window: "day", limit: 10)
+            async let moviesList = TmdbDetailsService.fetchTrending(mediaType: "movie", window: "day", limit: 10)
+            async let weekList = TmdbDetailsService.fetchTrending(mediaType: "all", window: "week", limit: 20)
+            shows = await showsList.map(\.asMeta)
+            movies = await moviesList.map(\.asMeta)
+            let topIds = Set((shows + movies).map(\.id))
+            week = await weekList.map(\.asMeta).filter { !topIds.contains($0.id) }
+        }
+
+        // Fork: check which films are still cinema-only before the rows show, so the
+        // "Hide unreleased content" filter on Home doesn't drop them after they appear.
+        if ProfileSettings.current.object(forKey: SettingsKey.hideUnreleased) as? Bool ?? false {
+            await CinemaOnlyReleases.shared.prefetch(movies + week, today: ContentReleasePolicy.todayIsoDay())
+        }
+        func row(_ name: String, _ title: String, _ items: [NuvioMeta], min: Int) -> TVHomeSection? {
+            guard items.count >= min else { return nil }
+            return TVHomeSection(id: idPrefix + name, title: title, items: items)
+        }
+        var newRanks: [String: (rank: Int, list: String)] = [:]
+        for (index, item) in shows.prefix(10).enumerated() where newRanks[item.id] == nil {
+            newRanks[item.id] = (index + 1, "TV Shows")
+        }
+        for (index, item) in movies.prefix(10).enumerated() where newRanks[item.id] == nil {
+            newRanks[item.id] = (index + 1, "Movies")
+        }
+        let finalRanks = newRanks
+        await MainActor.run { ranks = finalRanks }
+        return Rows(
+            topShows: row("top_shows", "Top 10 Shows Today", shows, min: 5),
+            topMovies: row("top_movies", "Top 10 Movies Today", movies, min: 5),
+            trendingNow: row("now", "Trending Now", week, min: 6),
+            comingSoon: row("coming_soon", "Coming Soon", await comingSoonList, min: 4)
+        )
+    }
+}
