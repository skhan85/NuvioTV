+++ b/tvosApp/NuvioTV/Sources/Fork/BillboardFork.swift
@@ -0,0 +1,72 @@
+import SwiftUI
+
+/// Fork: Netflix-style billboard. Once focus rests on a title, its trailer plays
+/// muted across the Home backdrop instead of inside the focused card, and the
+/// hero synopsis fades out so the logo sits over the video. Device-local switch
+/// in Settings → Layout → Billboard Trailer. Follows the existing trailer
+/// settings (Autoplay Trailers, Trailer Delay, Trailer Preview Sound).
+enum ForkBillboard {
+    static let enabledKey = "fork_billboard_trailer"
+}
+
+/// Fork: true inside Home's rows while the billboard owns trailer playback, so
+/// focused cards keep their artwork instead of starting a second trailer.
+private struct ForkBillboardOwnsCardTrailersKey: EnvironmentKey {
+    static let defaultValue = false
+}
+
+extension EnvironmentValues {
+    var forkBillboardOwnsCardTrailers: Bool {
+        get { self[ForkBillboardOwnsCardTrailersKey.self] }
+        set { self[ForkBillboardOwnsCardTrailersKey.self] = newValue }
+    }
+}
+
+/// Fork: the billboard's video layer. Mount it with `.id(meta.id)` so every
+/// title gets a fresh delay and player; it fades in over the still backdrop
+/// once the first frame is ready and fades back out when the trailer ends.
+struct ForkBillboardTrailer: View {
+    let meta: NuvioMeta
+    let delaySeconds: Int
+    let onPlayingChange: (Bool) -> Void
+
+    @State private var isActive = false
+    @State private var isFinished = false
+
+    var body: some View {
+        ZStack {
+            if !isFinished {
+                TrailerPreviewPlayer(
+                    meta: meta,
+                    isActive: isActive,
+                    onPlaybackReady: {
+                        guard isActive else { return }
+                        onPlayingChange(true)
+                    },
+                    onPlaybackFinished: finish,
+                    onPlaybackUnavailable: finish
+                )
+                .transition(.opacity)
+            }
+        }
+        .animation(.easeInOut(duration: 0.6), value: isFinished)
+        .allowsHitTesting(false)
+        .accessibilityHidden(true)
+        .task {
+            let delay = UInt64(min(15, max(0, delaySeconds)))
+            try? await Task.sleep(nanoseconds: delay * 1_000_000_000)
+            guard !Task.isCancelled else { return }
+            isActive = true
+        }
+        .onDisappear {
+            isActive = false
+            onPlayingChange(false)
+        }
+    }
+
+    private func finish() {
+        isActive = false
+        isFinished = true
+        onPlayingChange(false)
+    }
+}
