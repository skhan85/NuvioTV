+                            .filter { ($0.type ?? 0) >= 4 }
+                            .compactMap { $0.release_date.map { String($0.prefix(10)) } }
+                            .filter { $0 >= tomorrow }
+                            .sorted()
+                    }
+                    // Fork: already watchable at home somewhere (any country), or in cinemas more
+                    // than 90 days ago: it's out, so it isn't Coming Soon.
+                    let all = releases.results.flatMap(\.release_dates)
+                    let alreadyOut = all.contains { ($0.type ?? 0) >= 4 && ($0.release_date.map { String($0.prefix(10)) } ?? "9999") <= todayText }
