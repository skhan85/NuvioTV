+                id: "tmdb:\(item.id)",
+                name: name,
+                description: item.overview?.trimmingCharacters(in: .whitespacesAndNewlines),
+                posterUrl: imageURL(item.posterPath, size: "w500"),
+                backgroundUrl: imageURL(item.backdropPath, size: "w1280"),
+                logoUrl: nil,
+                imdbId: nil,
+                tmdbId: item.id,
+                type: type,
+                year: Int(date.prefix(4)),
+                genres: nil,
+                rating: nil,
+                releaseInfo: date,
+                runtime: nil,
+                cast: nil,
+                director: nil,
+                writer: nil,
+                certification: nil,
+                country: nil,
+                released: date,
+                status: nil,
+                videos: nil,
+                trailerYtIds: nil
+            )
+        }
+        var dated: [(date: String, meta: NuvioMeta)] = []
+        for movie in movies {
+            if let date = homeDates[movie.id], let m = meta(movie, type: "movie", date: date) { dated.append((date, m)) }
