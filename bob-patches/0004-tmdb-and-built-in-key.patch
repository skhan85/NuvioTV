+    /// Fork: every TMDB release of a film as (type, "yyyy-MM-dd…"), all countries — 1 premiere,
+    /// 2 limited theatrical, 3 theatrical, 4 digital, 5 physical, 6 TV. nil when the film can't
+    /// be matched or TMDB can't be reached (see `CinemaOnlyReleases`).
+    static func fetchMovieReleaseDates(for meta: NuvioMeta) async -> [(type: Int, date: String)]? {
+        if requestContext == nil {
+            return await withRequestContext { await fetchMovieReleaseDates(for: meta) }
+        }
+        guard let apiKey, let resolved = await resolveTmdbId(for: meta),
+              resolved.mediaType == "movie" else { return nil }
+        struct ReleaseDate: Decodable {
+            let type: Int?
+            let release_date: String?
+        }
+        struct Country: Decodable {
+            let release_dates: [ReleaseDate]
+        }
+        struct Releases: Decodable {
+            let results: [Country]
+        }
+        var components = URLComponents(
+            url: apiBase.appendingPathComponent("movie/\(resolved.id)/release_dates"),
+            resolvingAgainstBaseURL: false
+        )!
+        components.queryItems = [URLQueryItem(name: "api_key", value: apiKey)]
+        guard let url = components.url,
+              let (body, response) = try? await data(for: url),
+              let http = response as? HTTPURLResponse,
+              (200...299).contains(http.statusCode),
+              let releases = try? JSONDecoder().decode(Releases.self, from: body) else {
+            return nil
+        }
+        return releases.results
+            .flatMap(\.release_dates)
+            .compactMap { release in
+                guard let type = release.type,
+                      let date = release.release_date, date.count >= 10 else { return nil }
+                return (type: type, date: date)
+            }
+    }
