+    /// Fork: Netflix card tag for a title. Series: "New Episode" / "New Season" when an
+    /// episode aired in the last 10 days (or a new season starts within the week), with
+    /// "Watch Now" or the next air day beside it. Movies: "Recently Added" when the digital
+    /// release was in the last 30 days. nil when TMDB can't be reached.
+    static func fetchFreshness(for meta: NuvioMeta) async -> (primary: String?, secondary: String?)? {
+        if requestContext == nil {
+            return await withRequestContext { await fetchFreshness(for: meta) }
+        }
+        guard let apiKey, let resolved = await resolveTmdbId(for: meta) else { return nil }
+
+        var calendar = Calendar(identifier: .gregorian)
+        calendar.timeZone = .current
+        let today = calendar.startOfDay(for: Date())
+        let dayFormatter = DateFormatter()
+        dayFormatter.calendar = calendar
+        dayFormatter.locale = Locale(identifier: "en_US_POSIX")
+        dayFormatter.timeZone = .current
+        dayFormatter.dateFormat = "yyyy-MM-dd"
+        func day(_ raw: String?) -> Date? {
+            guard let raw, raw.count >= 10 else { return nil }
+            return dayFormatter.date(from: String(raw.prefix(10)))
+        }
+        func daysFromToday(_ date: Date) -> Int {
+            calendar.dateComponents([.day], from: today, to: calendar.startOfDay(for: date)).day ?? 0
+        }
+
+        if resolved.mediaType == "tv" {
+            struct Episode: Decodable {
+                let air_date: String?
+                let episode_number: Int?
+                let season_number: Int?
+            }
+            struct Show: Decodable {
+                let last_episode_to_air: Episode?
+                let next_episode_to_air: Episode?
+            }
+            var components = URLComponents(
+                url: apiBase.appendingPathComponent("tv/\(resolved.id)"),
+                resolvingAgainstBaseURL: false
+            )!
+            components.queryItems = [URLQueryItem(name: "api_key", value: apiKey)]
+            guard let url = components.url,
+                  let (body, response) = try? await data(for: url),
+                  let http = response as? HTTPURLResponse,
+                  (200...299).contains(http.statusCode),
+                  let show = try? JSONDecoder().decode(Show.self, from: body) else {
+                return nil
+            }
+            var primary: String?
+            var secondary: String?
+            if let last = show.last_episode_to_air, let aired = day(last.air_date) {
+                let daysAgo = -daysFromToday(aired)
+                if daysAgo >= 0 && daysAgo <= 10 {
+                    primary = (last.episode_number == 1 && (last.season_number ?? 1) > 1) ? "New Season" : "New Episode"
+                }
+            }
+            if let next = show.next_episode_to_air, let airs = day(next.air_date) {
+                let daysAhead = daysFromToday(airs)
+                if daysAhead >= 0 && daysAhead <= 6 {
+                    if primary == nil, next.episode_number == 1, (next.season_number ?? 1) > 1 {
+                        primary = "New Season"
+                    }
+                    if primary != nil {
+                        let weekday = DateFormatter()
+                        weekday.locale = Locale.current
+                        weekday.dateFormat = "EEEE"
+                        secondary = daysAhead == 0 ? "Today" : weekday.string(from: airs)
+                    }
+                }
+            }
+            if primary != nil && secondary == nil { secondary = "Watch Now" }
+            return (primary, secondary)
+        } else {
+            struct ReleaseDate: Decodable {
+                let type: Int?
+                let release_date: String?
+            }
+            struct Country: Decodable {
+                let release_dates: [ReleaseDate]
+            }
+            struct Releases: Decodable {
+                let results: [Country]
+            }
+            var components = URLComponents(
+                url: apiBase.appendingPathComponent("movie/\(resolved.id)/release_dates"),
+                resolvingAgainstBaseURL: false
+            )!
+            components.queryItems = [URLQueryItem(name: "api_key", value: apiKey)]
+            guard let url = components.url,
+                  let (body, response) = try? await data(for: url),
+                  let http = response as? HTTPURLResponse,
+                  (200...299).contains(http.statusCode),
+                  let releases = try? JSONDecoder().decode(Releases.self, from: body) else {
+                return nil
+            }
+            // Digital (4) or physical (5): when it became watchable at home.
+            let homeRelease = releases.results
+                .flatMap(\.release_dates)
+                .filter { ($0.type ?? 0) >= 4 }
+                .compactMap { day($0.release_date) }
+                .min()
+            if let homeRelease {
+                let daysAgo = -daysFromToday(homeRelease)
+                if daysAgo >= 0 && daysAgo <= 30 { return ("Recently Added", nil) }
+            }
+            return (nil, nil)
+        }
+    }
