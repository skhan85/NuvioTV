+        var movieParams = [
+            URLQueryItem(name: "region", value: "US"),
+            URLQueryItem(name: "with_release_type", value: "4|5"),
+            URLQueryItem(name: "release_date.gte", value: tomorrow),
+            URLQueryItem(name: "release_date.lte", value: until)
+        ]
