@@ -0,0 +1,66 @@
+import SwiftUI
+
+// MARK: - Fork: "Are you still watching?" (Netflix-style)
+
+/// After `episodeLimit` episodes auto-play in a row with no remote input, the player asks
+/// before starting the next one instead of playing on all night. Per profile, on by default.
+enum ForkStillWatching {
+    static let enabledKey = "fork_still_watching"
+    static let episodeLimit = 3
+
+    static var isEnabled: Bool {
+        ProfileSettings.current.object(forKey: enabledKey) as? Bool ?? true
+    }
+}
+
+struct ForkStillWatchingPrompt: View {
+    let title: String
+    let onContinue: () -> Void
+    let onExit: () -> Void
+
+    private enum Choice: Hashable { case keepWatching, exit }
+    @FocusState private var focused: Choice?
+
+    var body: some View {
+        ZStack {
+            Color.black.opacity(0.82).ignoresSafeArea()
+
+            VStack(alignment: .leading, spacing: 20) {
+                Text(title.isEmpty ? "Are you still watching?" : "Are you still watching \(title)?")
+                    .font(.system(size: 52, weight: .bold))
+                    .foregroundColor(.white)
+                    .lineLimit(2)
+                    .fixedSize(horizontal: false, vertical: true)
+
+                Text("Playback paused so episodes don't keep playing while no one's watching.")
+                    .font(.system(size: 26))
+                    .foregroundColor(.white.opacity(0.65))
+
+                VStack(alignment: .leading, spacing: 18) {
+                    Button(action: onContinue) {
+                        Label("Continue Watching", systemImage: "play.fill")
+                            .font(.system(size: 28, weight: .semibold))
+                            .frame(width: 520, alignment: .leading)
+                    }
+                    .focused($focused, equals: .keepWatching)
+
+                    Button(action: onExit) {
+                        Label("Exit", systemImage: "xmark")
+                            .font(.system(size: 28, weight: .semibold))
+                            .frame(width: 520, alignment: .leading)
+                    }
+                    .focused($focused, equals: .exit)
+                }
+                .padding(.top, 24)
+                .focusSection()
+            }
+            .frame(maxWidth: 1200, alignment: .leading)
+            .padding(.horizontal, 120)
+            .frame(maxWidth: .infinity, maxHeight: .infinity, alignment: .leading)
+        }
+        .defaultFocus($focused, .keepWatching)
+        .onAppear {
+            DispatchQueue.main.async { focused = .keepWatching }
+        }
+    }
+}
