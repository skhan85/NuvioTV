+// MARK: - Fork: Who's watching polish
+
+@MainActor
+enum ForkWhosWatching {
+    static func greeting(now: Date = Date()) -> String {
+        let hour = Calendar.current.component(.hour, from: now)
+        switch hour {
+        case 5..<12: return "Good morning"
+        case 12..<17: return "Good afternoon"
+        default: return "Good evening"
+        }
+    }
+
+    static func hasRatingLimit(_ profile: Profile) -> Bool {
+        ProfileSettings.store(for: profile.id).bool(forKey: ForkKidsFilter.enabledKey)
+    }
+
+    /// A profile is shown as Kids when it has the rating limit or kid-friendly Top 10 on.
+    static func isKids(_ profile: Profile) -> Bool {
+        let store = ProfileSettings.store(for: profile.id)
+        return store.bool(forKey: ForkKidsFilter.enabledKey) || store.bool(forKey: ForkTrendingRows.kidsKey)
+    }
+}
+
+private struct ForkEntrance: ViewModifier {
+    let shown: Bool
+    let index: Int
+    func body(content: Content) -> some View {
+        content
+            .opacity(shown ? 1 : 0)
+            .offset(y: shown ? 0 : 28)
+            .animation(.spring(response: 0.5, dampingFraction: 0.85).delay(0.06 * Double(index)), value: shown)
+    }
+}
+
+extension View {
+    func forkEntrance(shown: Bool, index: Int) -> some View {
+        modifier(ForkEntrance(shown: shown, index: index))
+    }
+}
