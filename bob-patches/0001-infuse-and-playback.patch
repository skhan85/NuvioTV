+            LinearGradient(colors: [.black.opacity(0.35), .black.opacity(0.75), .black.opacity(0.95)],
+                           startPoint: .top, endPoint: .bottom)
+                .ignoresSafeArea()
+
+            VStack(alignment: .leading, spacing: 24) {
+                Text("Because you watched \(offer.finished.name)")
+                    .font(.headline)
+                    .foregroundStyle(.white.opacity(0.75))
+                if let title = focusedTitle {
+                    VStack(alignment: .leading, spacing: 10) {
+                        Text(title.name)
+                            .font(.system(size: 52, weight: .bold))
+                            .foregroundStyle(.white)
+                            .lineLimit(1)
+                        HStack(spacing: 16) {
+                            if let year = title.year, !year.isEmpty { Text(year) }
+                            if let rating = title.rating, rating > 0 {
