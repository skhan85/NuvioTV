+                            }
+                        }
+                        .font(.callout)
+                        .foregroundStyle(.white.opacity(0.8))
+                        if let overview = title.overview, !overview.isEmpty {
+                            Text(overview)
+                                .font(.callout)
+                                .foregroundStyle(.white.opacity(0.85))
+                                .lineLimit(3)
+                                .frame(maxWidth: 1100, alignment: .leading)
+                        }
+                    }
+                }
+                ScrollView(.horizontal, showsIndicators: false) {
+                    LazyHStack(spacing: 32) {
+                        ForEach(offer.titles) { title in
+                            Button { onOpen(title) } label: {
+                                AsyncImage(url: title.posterURL.flatMap(URL.init(string:))) { image in
+                                    image.resizable().aspectRatio(contentMode: .fill)
+                                } placeholder: {
+                                    ZStack {
+                                        Color.white.opacity(0.08)
+                                        Text(title.name).font(.caption).multilineTextAlignment(.center).padding(8)
+                                    }
+                                }
+                                .frame(width: 200, height: 300)
+                                .clipShape(RoundedRectangle(cornerRadius: 14))
+                            }
+                            .buttonStyle(.card)
+                            .focused($focused, equals: title.id)
+                        }
+                    }
+                    .padding(.vertical, 40)
+                    .padding(.horizontal, 4)
+                }
+                .scrollClipDisabled()
+                Text("Press Menu to close")
+                    .font(.caption)
+                    .foregroundStyle(.white.opacity(0.55))
+            }
+            .padding(.horizontal, 80)
+            .padding(.bottom, 50)
+        }
+        .onExitCommand { onClose() }
+        .onAppear { focused = offer.titles.first?.id }
+    }
+}
+
+// MARK: - Fork: find sources ahead
+
+/// Fork: starts the stream search (and the add-on subtitle fetch) for the episode a series page would
+/// play, a moment after the page settles, so Play opens a full picker. Each episode is searched at
+/// most once every ten minutes. Off switch: `UserDefaults` key `fork_preload_detail_sources` = false.
+enum ForkDetailPrefetch {
+    static let episodeNotification = Notification.Name("ForkDetailPrefetchEpisode")
+    static let enabledKey = "fork_preload_detail_sources"
+    static let dwellSeconds: Double = 2
+    static let repeatAfter: TimeInterval = 600
+
+    struct Request {
+        let metaId: String
+        let episode: NuvioVideo
+    }
+
+    @MainActor private static var recent: [String: Date] = [:]
+
+    @MainActor static func shouldRun(key: String, now: Date = Date()) -> Bool {
+        guard UserDefaults.standard.object(forKey: enabledKey) as? Bool ?? true else { return false }
+        if let at = recent[key], now.timeIntervalSince(at) < repeatAfter { return false }
+        if recent.count > 100 { recent.removeAll() }
+        recent[key] = now
+        return true
+    }
+}
+
+extension ForkDetailPrefetch {
+    /// Starts the shared stream search and the subtitle fetch for a Continue Watching item.
+    @MainActor static func prefetch(item: ContinueWatchingItem) {
+        let meta = item.meta
+        let type = meta.isSeries ? "series" : meta.type
+        let videoId: String
+        if meta.isSeries, let season = item.season, let episode = item.episode {
+            videoId = meta.canonicalEpisodeStreamId(
+                for: NuvioVideo(id: "\(meta.id):\(season):\(episode)", title: "", season: season, episode: episode))
+        } else {
+            videoId = meta.streamId
+        }
+        guard shouldRun(key: "\(meta.id)|\(videoId)") else { return }
+        let se = StreamsRepository.seasonEpisode(fromVideoId: videoId)
+        StreamsRepository.shared.load(type: type, videoId: videoId, season: se.season, episode: se.episode)
+        ForkSubtitlePrefetch.shared.prefetch(contentId: videoId, type: type)
+    }
+}
+
+// MARK: - Fork: stream warm-up
+
+/// Fork: opens the focused stream link ahead (a one-byte ranged GET, then cancelled), so the debrid
+/// / resolver redirect chain is already done when Play is pressed. A link that answers 4xx/5xx
+/// (other than 416) is marked dead in the picker. Off switch: `fork_stream_warmup` = false.
+@MainActor
+final class ForkStreamWarmup: ObservableObject {
+    static let shared = ForkStreamWarmup()
+    static let enabledKey = "fork_stream_warmup"
+
+    @Published private(set) var dead: Set<String> = []
+    private var warmed: [String: Date] = [:]
+    private let session: URLSession = {
+        let config = URLSessionConfiguration.ephemeral
+        config.timeoutIntervalForRequest = 12
+        return URLSession(configuration: config)
+    }()
+
+    func warm(_ urlString: String, headers: [String: String]) {
+        guard UserDefaults.standard.object(forKey: Self.enabledKey) as? Bool ?? true,
+              urlString.hasPrefix("http://") || urlString.hasPrefix("https://"),
+              let url = URL(string: urlString) else { return }
+        if let at = warmed[urlString], Date().timeIntervalSince(at) < 300 { return }
+        if warmed.count > 200 { warmed.removeAll() }
+        warmed[urlString] = Date()
+        var request = URLRequest(url: url)
+        request.setValue("bytes=0-0", forHTTPHeaderField: "Range")
+        headers.forEach { request.setValue($0.value, forHTTPHeaderField: $0.key) }
+        let session = self.session
+        Task { @MainActor [weak self] in
+            guard let result = try? await session.bytes(for: request) else { return }
+            let (bytes, response) = result
+            bytes.task.cancel()
+            guard let status = (response as? HTTPURLResponse)?.statusCode else { return }
+            if status >= 400, status != 416 {
+                self?.dead.insert(urlString)
+            }
+        }
+    }
+}
