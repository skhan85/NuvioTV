+    /// Fork: a studio's or TV network's logo path on TMDB (for the Kids brand tiles).
+    static func fetchBrandLogoPath(tmdbId: Int, isNetwork: Bool) async -> String? {
+        if requestContext == nil {
+            return await withRequestContext { await fetchBrandLogoPath(tmdbId: tmdbId, isNetwork: isNetwork) }
+        }
+        guard let apiKey else { return nil }
+        struct Brand: Decodable { let logo_path: String? }
+        var components = URLComponents(
+            url: apiBase.appendingPathComponent("\(isNetwork ? "network" : "company")/\(tmdbId)"),
+            resolvingAgainstBaseURL: false
+        )!
+        components.queryItems = [URLQueryItem(name: "api_key", value: apiKey)]
+        guard let url = components.url,
+              let (body, response) = try? await data(for: url),
+              let http = response as? HTTPURLResponse,
+              (200...299).contains(http.statusCode),
+              let brand = try? JSONDecoder().decode(Brand.self, from: body),
+              let path = brand.logo_path, !path.isEmpty else {
+            return nil
+        }
+        return path
+    }
