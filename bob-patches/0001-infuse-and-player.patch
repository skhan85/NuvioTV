+// MARK: - Fork: Up Next after Infuse
+
+/// Fork: Infuse plays one file and calls back when it stops. When it hands back an episode at its end,
+/// Home offers the next aired episode and opens its sources after ten seconds unless cancelled.
+enum InfuseUpNext {
+    static let countdownSeconds = 10
+    /// `fork_upnext_same_source` = false: Up Next opens the source list instead of playing.
+    static let sameSourceKey = "fork_upnext_same_source"
+
+    struct Offer: Identifiable {
+        let id = UUID()
+        let meta: NuvioMeta
+        let video: NuvioVideo
+
+        var title: String {
+            let name = video.title.trimmingCharacters(in: .whitespacesAndNewlines)
+            let code = "S\(video.season) E\(video.episode)"
+            return name.isEmpty ? "Up Next: \(code)" : "Up Next: \(code) · \(name)"
+        }
+    }
+
+    /// Infuse stopped at (or near) the end: 90% in, or within the last 5 minutes (end credits; the
+    /// runtime is the metadata's, so the file can run past it).
+    static func reachedEnd(progress: Double?, position: Double?, duration: Double?) -> Bool {
+        if let position, let duration, position.isFinite, duration > 0, position > 0 {
+            return position >= duration * 0.9 || position >= duration - 300
+        }
+        if let progress, progress.isFinite { return progress >= 0.9 }
+        return false
+    }
+
+    /// The episode after (season, episode) in air order, skipping specials and ones not aired yet.
+    static func nextEpisode(in videos: [NuvioVideo], season: Int, episode: Int, today: Date = Date()) -> NuvioVideo? {
+        let numbered = videos.filter { $0.season > 0 && $0.episode > 0 }
+            .sorted { ($0.season, $0.episode) < ($1.season, $1.episode) }
+        guard let index = numbered.firstIndex(where: { $0.season == season && $0.episode == episode }),
+              index + 1 < numbered.count else { return nil }
+        let next = numbered[index + 1]
+        return hasAired(next.released, today: today) ? next : nil
+    }
+
+    static func hasAired(_ released: String?, today: Date = Date()) -> Bool {
+        guard let released, released.count >= 10 else { return true }
+        let formatter = DateFormatter()
+        formatter.dateFormat = "yyyy-MM-dd"
+        formatter.timeZone = TimeZone(identifier: "UTC")
+        return String(released.prefix(10)) <= formatter.string(from: today)
+    }
+}
