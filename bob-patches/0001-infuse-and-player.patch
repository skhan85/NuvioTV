diff --git a/tvosApp/NuvioTV/Sources/Fork/InfuseFork.swift b/tvosApp/NuvioTV/Sources/Fork/InfuseFork.swift
new file mode 100644
index 00000000..ccdd468e
--- /dev/null
+++ b/tvosApp/NuvioTV/Sources/Fork/InfuseFork.swift
@@ -0,0 +1,484 @@
+import Foundation
+import SwiftUI
+
+// MARK: - Fork: Infuse subtitles
+
+/// Fork: subtitles from the installed subtitle add-ons (OpenSubtitles and the like) go to Infuse along
+/// with the stream's own ones.
+///
+/// Infuse uses only one subtitle it is given (the last), so it gets just the best match for the
+/// viewer's first subtitle language. Add-on links have no file ending, often
+/// redirect and can be gzipped or WebVTT, which Infuse cannot show, so each goes through Kuiper's
+/// `/subs/` relay as a plain `.srt`. The link also names the video (`/v/<video>`), so the relay lines
+/// the subtitle up with the video's audio (Kuiper's subsync); Infuse opens at once and gets the synced
+/// copy when it is ready, the original otherwise.
+enum InfuseForkSubtitles {
+    static let relayBase = "https://kuiper.khanofmilton.ca/subs/"
+    /// Seconds Kuiper may hold the warm-up request for the first synced copy.
+    static let syncWarmUpSeconds = 35
+    /// Infuse uses only the LAST `sub=` it is given (the iPhone fork found the same: of three it took
+    /// the add-on's lowest-ranked), so it gets exactly one: the best match for the viewer's first
+    /// subtitle language that has one. Sending several put a Portuguese file last and English never
+    /// showed.
+    static let maxSubtitles = 1
+    /// `fork_infuse_send_subtitle` (default off): hand Infuse the relayed add-on subtitle. Off, Infuse
+    /// uses the file's own tracks or its own downloads; on a test the relayed one drifted out of sync.
+    static let sendKey = "fork_infuse_send_subtitle"
+    static var sendEnabled: Bool { UserDefaults.standard.object(forKey: sendKey) as? Bool ?? false }
+
+    static func subtitles(streamSubtitles: [NuvioSubtitle], addonSubtitles: [NuvioSubtitle],
+                          videoURL: String) -> [NuvioSubtitle] {
+        func matches(_ sub: NuvioSubtitle, _ language: String) -> Bool {
+            SubtitleLanguagePreferences.matches(sub.language, target: language) ||
+                SubtitleLanguagePreferences.matches(sub.label, target: language)
+        }
+        func isForced(_ sub: NuvioSubtitle) -> Bool {
+            let text = [sub.label ?? "", sub.url].joined(separator: " ").lowercased()
+            return text.contains("forced") || text.contains("foreign part")
+        }
+        var pick: NuvioSubtitle?
+        for language in preferredLanguages() {
+            // The add-on's best match first (the same pick as the iPhone fork), then the stream's own;
+            // forced-only tracks only when nothing complete exists in that language.
+            let candidates = addonSubtitles.filter { matches($0, language) } +
+                streamSubtitles.filter { matches($0, language) }
+            if let best = candidates.first(where: { !isForced($0) }) ?? candidates.first {
+                pick = best
+                break
+            }
+        }
+        guard let sub = pick else { return [] }
+        return [NuvioSubtitle(
+            url: relayURL(sub.url, language: sub.language,
+                          name: SubtitleLanguagePreferences.humanLanguageName(from: sub.language),
+                          number: 1, videoURL: videoURL),
+            language: sub.language,
+            label: sub.label,
+            source: sub.source
+        )]
+    }
+
+    /// The viewer's subtitle languages in order; with System, the Apple TV's own language.
+    static func preferredLanguages() -> [String] {
+        let ordered = SubtitleLanguagePreferences.orderedFromDefaults()
+        if !ordered.isEmpty { return ordered }
+        let device = Locale.preferredLanguages.lazy.compactMap { identifier -> String? in
+            let code = identifier.lowercased().components(separatedBy: CharacterSet(charactersIn: "-_")).first ?? ""
+            return SubtitleLanguagePreferences.supportedLanguages.first {
+                SubtitleLanguagePreferences.exactCodes(for: $0).contains(code)
+            }
+        }.first
+        return [device ?? "English"]
+    }
+
+    /// Two-letter code for the relay's file name ("en"), "und" when unknown.
+    static func twoLetterCode(_ language: String) -> String {
+        let name = SubtitleLanguagePreferences.supportedLanguages.first {
+            SubtitleLanguagePreferences.matches(language, target: $0)
+        }
+        if let name, let code = SubtitleLanguagePreferences.exactCodes(for: name).first(where: { $0.count == 2 }) {
+            return code
+        }
+        let raw = language.lowercased().filter(\.isLetter)
+        return raw.count == 2 ? raw : "und"
+    }
+
+    /// `relayBase<subtitle>/v/<video>/<Label N.en.srt>`; links already relayed, or not http(s), stay.
+    static func relayURL(_ url: String, language: String, name: String = "", number: Int = 1,
+                         videoURL: String? = nil) -> String {
+        guard url.hasPrefix("http://") || url.hasPrefix("https://"), !url.hasPrefix(relayBase) else { return url }
+        let allowed = CharacterSet.alphanumerics.union(CharacterSet(charactersIn: " ()-_."))
+        let label = String(String(name.unicodeScalars.filter { allowed.contains($0) })
+            .trimmingCharacters(in: .whitespaces).prefix(60))
+        let file = "\(label.isEmpty ? "Subtitle" : label) \(number).\(twoLetterCode(language)).srt"
+        let path = file.addingPercentEncoding(
+            withAllowedCharacters: .urlPathAllowed.subtracting(CharacterSet(charactersIn: "/"))) ?? "sub.srt"
+        guard let videoURL, videoURL.hasPrefix("http://") || videoURL.hasPrefix("https://") else {
+            return relayBase + base64url(url) + "/" + path
+        }
+        return relayBase + base64url(url) + "/v/" + base64url(videoURL) + "/" + path
+    }
+
+    /// A relay link that also names the video, i.e. one Kuiper syncs before serving.
+    static func isSyncLink(_ url: String) -> Bool {
+        url.hasPrefix(relayBase) && url.dropFirst(relayBase.count).contains("/v/")
+    }
+
+    /// Asks the relay for each synced subtitle with `?wait=`, so it starts syncing now. Runs in the
+    /// background; nothing waits on it.
+    static func warmUpSync(_ urls: [String]) async {
+        await withTaskGroup(of: Void.self) { group in
+            for url in urls where isSyncLink(url) {
+                guard var components = URLComponents(string: url) else { continue }
+                components.queryItems = [URLQueryItem(name: "wait", value: String(syncWarmUpSeconds))]
+                guard let warmURL = components.url else { continue }
+                group.addTask {
+                    let request = URLRequest(url: warmURL, timeoutInterval: TimeInterval(syncWarmUpSeconds + 5))
+                    _ = try? await URLSession.shared.data(for: request)
+                }
+            }
+        }
+    }
+
+    static func base64url(_ text: String) -> String {
+        Data(text.utf8).base64EncodedString()
+            .replacingOccurrences(of: "+", with: "-")
+            .replacingOccurrences(of: "/", with: "_")
+            .trimmingCharacters(in: CharacterSet(charactersIn: "="))
+    }
+}
+
+/// Fork: add-on subtitle results per title, fetched ahead (Details page, a focused Continue Watching
+/// card) so the Infuse hand-off can include them without waiting.
+@MainActor
+final class ForkSubtitlePrefetch {
+    static let shared = ForkSubtitlePrefetch()
+
+    private struct Entry {
+        var subtitles: [NuvioSubtitle]
+        var done: Bool
+        var fetchedAt: Date
+    }
+
+    private var entries: [String: Entry] = [:]
+    private var tasks: [String: Task<Void, Never>] = [:]
+    private static let lifetime: TimeInterval = 30 * 60
+
+    /// `contentId` is the subtitle add-on id: `tt…` for a movie, `tt…:season:episode` for an episode.
+    func prefetch(contentId: String, type: String) {
+        guard !contentId.isEmpty, tasks[contentId] == nil else { return }
+        if let entry = entries[contentId], Date().timeIntervalSince(entry.fetchedAt) < Self.lifetime { return }
+        if entries.count > 40 { entries.removeAll() }
+        entries[contentId] = Entry(subtitles: [], done: false, fetchedAt: Date())
+        tasks[contentId] = Task { @MainActor [weak self] in
+            for await subtitles in CinemetaCatalogRepository().subtitlesProgressively(id: contentId, type: type) {
+                self?.entries[contentId]?.subtitles = subtitles
+            }
+            self?.entries[contentId]?.done = true
+            self?.tasks[contentId] = nil
+        }
+    }
+
+    /// Whatever has arrived for `contentId`, waiting at most `wait` seconds for a first result.
+    func subtitles(contentId: String, type: String, wait: TimeInterval) async -> [NuvioSubtitle] {
+        prefetch(contentId: contentId, type: type)
+        let deadline = Date().addingTimeInterval(wait)
+        while let entry = entries[contentId], entry.subtitles.isEmpty, !entry.done, Date() < deadline {
+            try? await Task.sleep(nanoseconds: 50_000_000)
+        }
+        return entries[contentId]?.subtitles ?? []
+    }
+
+    static func contentId(meta: NuvioMeta, season: Int?, episode: Int?) -> String {
+        if meta.isSeries, let season, let episode {
+            return meta.canonicalEpisodeStreamId(
+                for: NuvioVideo(id: "\(meta.id):\(season):\(episode)", title: "", season: season, episode: episode))
+        }
+        return meta.streamId
+    }
+}
