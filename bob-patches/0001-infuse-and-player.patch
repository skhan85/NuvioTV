+// MARK: - Fork: stream warm-up
+
+/// Fork: opens the focused stream link ahead (a one-byte ranged GET, then cancelled), so the debrid
+/// / resolver redirect chain is already done when Play is pressed. A link that answers 4xx/5xx
+/// (other than 416) is marked dead in the picker. Off switch: `fork_stream_warmup` = false.
+@MainActor
+final class ForkStreamWarmup: ObservableObject {
+    static let shared = ForkStreamWarmup()
+    static let enabledKey = "fork_stream_warmup"
+
+    @Published private(set) var dead: Set<String> = []
+    private var warmed: [String: Date] = [:]
+    private let session: URLSession = {
+        let config = URLSessionConfiguration.ephemeral
+        config.timeoutIntervalForRequest = 12
+        return URLSession(configuration: config)
+    }()
+
+    func warm(_ urlString: String, headers: [String: String]) {
+        guard UserDefaults.standard.object(forKey: Self.enabledKey) as? Bool ?? true,
+              urlString.hasPrefix("http://") || urlString.hasPrefix("https://"),
+              let url = URL(string: urlString) else { return }
+        if let at = warmed[urlString], Date().timeIntervalSince(at) < 300 { return }
+        if warmed.count > 200 { warmed.removeAll() }
+        warmed[urlString] = Date()
+        var request = URLRequest(url: url)
+        request.setValue("bytes=0-0", forHTTPHeaderField: "Range")
+        headers.forEach { request.setValue($0.value, forHTTPHeaderField: $0.key) }
+        let session = self.session
+        let originalHost = url.host
+        Task { @MainActor [weak self] in
+            guard let result = try? await session.bytes(for: request) else { return }
+            let (bytes, response) = result
+            bytes.task.cancel()
+            guard let http = response as? HTTPURLResponse else { return }
+            let status = http.statusCode
+            if status >= 400, status != 416 {
+                self?.dead.insert(urlString)
+                return
+            }
+            // Fork: also read the start and the end of the file from the final download address, so the
+            // host has the file's header and index ready (a cold open of a very large file took about
+            // 7 s, a warm one about 3 s) and the player starts from a hot cache.
+            guard let finalURL = http.url, let total = Self.totalSize(from: http) else { return }
+            await Self.readRange(finalURL, headers: headers, originalHost: originalHost,
+                                 range: "bytes=0-4194303", session: session)
+            if total > 16_777_216 {
+                await Self.readRange(finalURL, headers: headers, originalHost: originalHost,
+                                     range: "bytes=\(total - 4_194_304)-\(total - 1)", session: session)
+            }
+        }
+    }
+
+    /// The file's size from a `Content-Range: bytes 0-0/<size>` answer.
+    nonisolated private static func totalSize(from response: HTTPURLResponse) -> Int64? {
+        guard let range = response.value(forHTTPHeaderField: "Content-Range"),
+              let slash = range.lastIndex(of: "/") else { return nil }
+        return Int64(range[range.index(after: slash)...].trimmingCharacters(in: .whitespaces))
+    }
+
+    nonisolated private static func readRange(_ url: URL, headers: [String: String], originalHost: String?,
+                                              range: String, session: URLSession) async {
+        var request = URLRequest(url: url)
+        request.setValue(range, forHTTPHeaderField: "Range")
+        // The stream's own headers go only to the host the link started at, never to a redirect target.
+        if url.host == originalHost {
+            headers.forEach { request.setValue($0.value, forHTTPHeaderField: $0.key) }
+        }
+        _ = try? await session.data(for: request)
+    }
+
+    /// Fork: right after a stream search starts for a title (a focused show page or Continue Watching
+    /// card), waits for its first results, then warms the first two direct links so Play starts sooner.
+    private var topTask: Task<Void, Never>?
+
+    func warmTopStreams(limit: Int = 2) {
+        guard UserDefaults.standard.object(forKey: Self.enabledKey) as? Bool ?? true else { return }
+        topTask?.cancel()
+        topTask = Task { @MainActor [weak self] in
+            let deadline = Date().addingTimeInterval(25)
+            while !Task.isCancelled, Date() < deadline {
+                if StreamsRepository.shared.state.allStreams.contains(where: { $0.directURL != nil }) {
+                    // Let a few more add-ons answer before taking the first ones.
+                    try? await Task.sleep(nanoseconds: 2_000_000_000)
+                    guard !Task.isCancelled else { return }
+                    let streams = StreamsRepository.shared.state.allStreams.filter { $0.directURL != nil }
+                    for stream in streams.prefix(limit) {
+                        if let url = stream.directURL { self?.warm(url, headers: stream.httpHeaders ?? [:]) }
+                    }
+                    return
+                }
+                try? await Task.sleep(nanoseconds: 250_000_000)
+            }
+        }
+    }
+}
