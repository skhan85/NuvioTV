+// MARK: - Fork: Top 10 and Trending rows
+
+/// Fork: Netflix-style "Top 10 Shows Today", "Top 10 Movies Today" and "Trending Now" rows from
+/// TMDB trending. The Top 10 rows get the rank numerals through their names. Home places the
+/// shows row under Continue Watching, before "Because you watched", and the other two after it.
+/// `fork_trending_rows` = false turns them off (Settings → Layout → Top 10 & Trending).
+enum ForkTrendingRows {
+    static let enabledKey = "fork_trending_rows"
+    /// Per profile (Home reads it through the profile's `.defaultAppStorage`): kid-friendly lists.
+    static let kidsKey = "fork_kids_trending"
+    static let idPrefix = "fork_trending_"
+    /// Refresh at most this often while Home stays mounted.
+    static let refreshSeconds: UInt64 = 3 * 60 * 60
+
+    struct Rows {
+        var topShows: TVHomeSection?
+        var topMovies: TVHomeSection?
+        var trendingNow: TVHomeSection?
+
+        var isEmpty: Bool { topShows == nil && topMovies == nil && trendingNow == nil }
+    }
+
+    static func load(kids: Bool = false) async -> Rows {
+        let shows: [NuvioMeta]
+        let movies: [NuvioMeta]
+        let week: [NuvioMeta]
+        if kids {
+            // Kids profile: the most popular family / kids titles; Trending Now is the next ones,
+            // films and shows alternating.
+            async let kidsShows = TmdbDetailsService.fetchKidsPopular(mediaType: "tv")
+            async let kidsMovies = TmdbDetailsService.fetchKidsPopular(mediaType: "movie")
+            let allShows = await kidsShows.map(\.asMeta)
+            let allMovies = await kidsMovies.map(\.asMeta)
+            shows = Array(allShows.prefix(10))
+            movies = Array(allMovies.prefix(10))
+            let moreShows = Array(allShows.dropFirst(10))
+            let moreMovies = Array(allMovies.dropFirst(10))
+            week = (0..<max(moreShows.count, moreMovies.count)).flatMap { index in
+                [index < moreMovies.count ? moreMovies[index] : nil,
+                 index < moreShows.count ? moreShows[index] : nil].compactMap { $0 }
+            }
+        } else {
+            async let showsList = TmdbDetailsService.fetchTrending(mediaType: "tv", window: "day", limit: 10)
+            async let moviesList = TmdbDetailsService.fetchTrending(mediaType: "movie", window: "day", limit: 10)
+            async let weekList = TmdbDetailsService.fetchTrending(mediaType: "all", window: "week", limit: 20)
+            shows = await showsList.map(\.asMeta)
+            movies = await moviesList.map(\.asMeta)
+            let topIds = Set((shows + movies).map(\.id))
+            week = await weekList.map(\.asMeta).filter { !topIds.contains($0.id) }
+        }
+
+        func row(_ name: String, _ title: String, _ items: [NuvioMeta], min: Int) -> TVHomeSection? {
+            guard items.count >= min else { return nil }
+            return TVHomeSection(id: idPrefix + name, title: title, items: items)
+        }
+        return Rows(
+            topShows: row("top_shows", "Top 10 Shows Today", shows, min: 5),
+            topMovies: row("top_movies", "Top 10 Movies Today", movies, min: 5),
+            trendingNow: row("now", "Trending Now", week, min: 6)
+        )
+    }
+}
