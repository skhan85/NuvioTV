+    /// Fork: TMDB's trending list for `mediaType` ("movie", "tv" or "all") over `window`
+    /// ("day" or "week"), in TMDB's order, people left out. Empty without a key or on failure.
+    static func fetchTrending(mediaType: String, window: String, limit: Int = 20) async -> [RelatedTitle] {
+        if requestContext == nil {
+            return await withRequestContext {
+                await fetchTrending(mediaType: mediaType, window: window, limit: limit)
+            }
+        }
+        guard let apiKey else { return [] }
+        var components = URLComponents(
+            url: apiBase.appendingPathComponent("trending/\(mediaType)/\(window)"),
+            resolvingAgainstBaseURL: false
+        )!
+        components.queryItems = [
+            URLQueryItem(name: "api_key", value: apiKey),
+            URLQueryItem(name: "language", value: preferredLanguage)
+        ]
+        guard let url = components.url,
+              let (data, response) = try? await data(for: url),
+              let http = response as? HTTPURLResponse,
+              (200...299).contains(http.statusCode),
+              let decoded = try? JSONDecoder().decode(TmdbPagedResults.self, from: data) else {
+            return []
+        }
+        let defaultType = mediaType == "tv" ? "series" : "movie"
+        return decoded.results
+            .filter { item in
+                let type = item.mediaType?.lowercased()
+                return type == nil || type == "movie" || type == "tv"
+            }
+            .prefix(limit)
+            .compactMap { mapDiscoverItemFast($0, defaultType: defaultType) }
+    }
+
+    /// Fork: kid-friendly stand-in for `fetchTrending` on a kids profile: TMDB's most popular
+    /// Family / Animation films rated PG or lower in the US, or Kids / Family shows
+    /// (crime, drama and war-politics shows left out). `mediaType` is "movie" or "tv".
+    static func fetchKidsPopular(mediaType: String, limit: Int = 20) async -> [RelatedTitle] {
+        if requestContext == nil {
+            return await withRequestContext {
+                await fetchKidsPopular(mediaType: mediaType, limit: limit)
+            }
+        }
+        guard let apiKey else { return [] }
+        var components = URLComponents(
+            url: apiBase.appendingPathComponent("discover/\(mediaType)"),
+            resolvingAgainstBaseURL: false
+        )!
+        var items = [
+            URLQueryItem(name: "api_key", value: apiKey),
+            URLQueryItem(name: "language", value: preferredLanguage),
+            URLQueryItem(name: "sort_by", value: "popularity.desc"),
+            URLQueryItem(name: "include_adult", value: "false")
+        ]
+        if mediaType == "movie" {
+            items += [
+                URLQueryItem(name: "certification_country", value: "US"),
+                URLQueryItem(name: "certification.lte", value: "PG"),
+                URLQueryItem(name: "with_genres", value: "10751|16"),
+                URLQueryItem(name: "vote_count.gte", value: "50")
+            ]
+        } else {
+            items += [
+                URLQueryItem(name: "with_genres", value: "10762|10751"),
+                URLQueryItem(name: "without_genres", value: "80|18|10768"),
+                URLQueryItem(name: "vote_count.gte", value: "20")
+            ]
+        }
+        components.queryItems = items
+        guard let url = components.url,
+              let (data, response) = try? await data(for: url),
+              let http = response as? HTTPURLResponse,
+              (200...299).contains(http.statusCode),
+              let decoded = try? JSONDecoder().decode(TmdbPagedResults.self, from: data) else {
+            return []
+        }
+        let defaultType = mediaType == "tv" ? "series" : "movie"
+        return decoded.results
+            .prefix(limit)
+            .compactMap { mapDiscoverItemFast($0, defaultType: defaultType) }
+    }
