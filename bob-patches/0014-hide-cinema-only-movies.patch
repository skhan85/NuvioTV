+// MARK: - Fork: cinema-only films count as unreleased
+
+/// Fork: "Hide unreleased content" also hides films that are only in cinemas so far (nothing to
+/// stream but cam prints). A recent film counts as cinema-only until TMDB lists a digital,
+/// physical or TV release (types 4-6) on or before today. Verdicts come from TMDB in the
+/// background: a film nobody has checked yet stays visible, and `revision` changes once it is
+/// checked so the rows filter again. Films first released more than `windowDays` ago are never
+/// hidden (TMDB often has no home-release date for older titles).
+@MainActor
+final class CinemaOnlyReleases: ObservableObject {
+    static let shared = CinemaOnlyReleases()
+
+    @Published private(set) var revision = 0
+    private var verdicts: [String: Bool] = [:]
+    private var queued: Set<String> = []
+    private var queue: [NuvioMeta] = []
+    private var running = 0
+    private var revisionBumpScheduled = false
+    private static let windowDays = 150
+    private static let maxConcurrent = 4
+
+    /// True only when TMDB has confirmed the film is still cinema-only. Unchecked films are
+    /// queued for a check (never publishes synchronously, so it is safe inside `body`).
+    func isCinemaOnly(_ meta: NuvioMeta, today: String) -> Bool {
+        guard Self.isCandidate(meta, today: today) else { return false }
+        if let verdict = verdicts[meta.id] { return verdict }
+        enqueue(meta)
+        return false
+    }
+
+    /// Checks the candidates in `metas` now and waits for the answers (rows built off-screen).
+    func prefetch(_ metas: [NuvioMeta], today: String) async {
+        var seen = Set<String>()
+        let todo = metas.filter {
+            Self.isCandidate($0, today: today) && verdicts[$0.id] == nil && seen.insert($0.id).inserted
+        }
+        guard !todo.isEmpty else { return }
+        let results = await withTaskGroup(of: (String, Bool).self) { group in
+            for meta in todo {
+                group.addTask { (meta.id, await Self.lookUp(meta, today: today)) }
+            }
+            var collected: [(String, Bool)] = []
+            for await result in group { collected.append(result) }
+            return collected
+        }
+        for (id, verdict) in results { verdicts[id] = verdict }
+        revision &+= 1
+    }
+
+    private func enqueue(_ meta: NuvioMeta) {
+        guard queued.insert(meta.id).inserted else { return }
+        queue.append(meta)
+        DispatchQueue.main.async { [weak self] in self?.drain() }
+    }
+
+    private func drain() {
+        while running < Self.maxConcurrent, !queue.isEmpty {
+            let meta = queue.removeFirst()
+            running += 1
+            Task { @MainActor [weak self] in
+                let verdict = await Self.lookUp(meta, today: ContentReleasePolicy.todayIsoDay())
+                guard let self else { return }
+                self.verdicts[meta.id] = verdict
+                self.queued.remove(meta.id)
+                self.running -= 1
+                self.scheduleRevisionBump()
+                self.drain()
+            }
+        }
+    }
+
+    /// Coalesces a burst of answers into one re-filter.
+    private func scheduleRevisionBump() {
+        guard !revisionBumpScheduled else { return }
+        revisionBumpScheduled = true
+        DispatchQueue.main.asyncAfter(deadline: .now() + 0.4) { [weak self] in
+            guard let self else { return }
+            self.revisionBumpScheduled = false
+            self.revision &+= 1
+        }
+    }
+
+    nonisolated private static func lookUp(_ meta: NuvioMeta, today: String) async -> Bool {
+        guard let todayDate = day(today) else { return false }
+        // nil: TMDB couldn't be reached or the film isn't on TMDB. Don't hide what can't be checked.
+        guard let releases = await TmdbDetailsService.fetchMovieReleaseDates(for: meta) else { return false }
+        let days = releases.compactMap { release in day(release.date).map { (release.type, $0) } }
+        guard let firstRelease = days.map(\.1).min() else { return false }
+        if firstRelease > todayDate { return false } // not out at all: the date rule already hides it
+        if daysBetween(firstRelease, todayDate) > windowDays { return false }
+        let atHome = days.contains { $0.0 >= 4 && $0.1 <= todayDate }
+        return !atHome
+    }
+
+    /// Films first released in the last `windowDays` days, or (no full date) this year or last year.
+    nonisolated private static func isCandidate(_ meta: NuvioMeta, today: String) -> Bool {
+        guard meta.type.lowercased() == "movie", let todayDate = day(today) else { return false }
+        if let released = day(meta.released) ?? day(meta.releaseInfo) {
+            if released > todayDate { return false }
+            return daysBetween(released, todayDate) <= windowDays
+        }
+        let year = meta.year ?? meta.releaseInfo.flatMap { Int($0.prefix(4)) }
+        guard let year, let currentYear = Int(today.prefix(4)) else { return false }
+        return year == currentYear || year == currentYear - 1
+    }
+
+    nonisolated private static func day(_ raw: String?) -> Date? {
+        guard let raw = raw?.trimmingCharacters(in: .whitespacesAndNewlines), raw.count >= 10 else { return nil }
+        let formatter = DateFormatter()
+        formatter.calendar = Calendar(identifier: .gregorian)
+        formatter.locale = Locale(identifier: "en_US_POSIX")
+        formatter.timeZone = TimeZone(identifier: "UTC")
+        formatter.dateFormat = "yyyy-MM-dd"
+        return formatter.date(from: String(raw.prefix(10)))
+    }
+
+    nonisolated private static func daysBetween(_ from: Date, _ to: Date) -> Int {
+        Int((to.timeIntervalSince(from) / 86_400).rounded())
+    }
+}
