+struct ForkInsightsView: View {
+    @State var page: ForkInsightsPage
+    let onClose: () -> Void
+    /// Fork: opens a calendar title's details page (id, type).
+    var onOpen: ((String, String) -> Void)? = nil
+    @State private var stats: ForkWatchStats?
+    @State private var calendar: [ForkReleaseCalendar.Entry]?
+
+    private static let parser: DateFormatter = {
+        let f = DateFormatter()
+        f.dateFormat = "yyyy-MM-dd"
+        return f
+    }()
+
+    private static func dayTitle(_ iso: String) -> String {
+        guard let date = parser.date(from: iso) else { return iso }
+        return date.formatted(.dateTime.weekday(.wide).month(.abbreviated).day())
+    }
+
+    private static func monthTitle(_ iso: String) -> String {
+        guard let date = parser.date(from: iso) else { return String(iso.prefix(7)) }
+        return date.formatted(.dateTime.month(.wide).year())
+    }
+
+    var body: some View {
+        ZStack {
+            Color.black.ignoresSafeArea()
+            ScrollView(.vertical) {
+                VStack(alignment: .leading, spacing: 32) {
+                    HStack(spacing: 16) {
+                        ForEach(ForkInsightsPage.allCases) { item in
+                            SourceModeChip(title: item.title, isSelected: page == item) { page = item }
+                        }
+                    }
+                    .focusSection()
+
+                    switch page {
+                    case .stats: statsPage
+                    case .diary: diaryPage
+                    case .calendar: calendarPage
+                    }
+                }
+                .padding(80)
+                .frame(maxWidth: .infinity, alignment: .leading)
+            }
+        }
+        .onAppear { stats = ForkWatchStats.compute() }
+        .task(id: page) {
+            guard page == .calendar, calendar == nil else { return }
+            calendar = await ForkReleaseCalendar.load()
+        }
+        .onExitCommand(perform: onClose)
+    }
+
+    @ViewBuilder
+    private var statsPage: some View {
+        if let s = stats {
+            LazyVGrid(columns: Array(repeating: GridItem(.flexible(), spacing: 24), count: 4),
+                      alignment: .leading, spacing: 24) {
+                tile("\(s.estimatedHours)", "hours watched (est.)")
+                tile("\(s.movies)", "movies")
+                tile("\(s.episodes)", "episodes")
+                tile("\(s.showsFinished) / \(s.showsStarted)", "shows finished")
+                tile("\(s.thisMonth)", "this month")
+                tile("\(s.thisYear)", "this year")
+                tile("\(s.longestStreak)", "best streak (days)")
+                tile("\(s.movies + s.episodes)", "titles and episodes")
+            }
+            if !s.topGenres.isEmpty {
+                section("Taste")
+                Text(s.topGenres.joined(separator: "  ·  "))
+                    .font(.system(size: 28)).foregroundColor(.white)
+            }
+            section("Achievements")
+            LazyVGrid(columns: Array(repeating: GridItem(.flexible(), spacing: 24), count: 4),
+                      alignment: .leading, spacing: 24) {
+                ForEach(s.achievements) { achievement($0) }
+            }
+        } else {
+            ProgressView()
+        }
+    }
+
+    private func tile(_ value: String, _ label: String) -> some View {
+        Button {} label: {
+            VStack(alignment: .leading, spacing: 6) {
+                Text(value)
+                    .font(.system(size: 52, weight: .bold, design: .rounded))
+                    .foregroundColor(.white)
+                    .minimumScaleFactor(0.5)
+                    .lineLimit(1)
+                Text(label).font(.system(size: 22)).foregroundColor(.white.opacity(0.6))
+            }
+            .padding(24)
+            .frame(maxWidth: .infinity, alignment: .leading)
+            .background(Color.white.opacity(0.08), in: RoundedRectangle(cornerRadius: 20))
+        }
+        .buttonStyle(.card)
+    }
+
+    private func achievement(_ a: ForkWatchStats.Achievement) -> some View {
+        let colors: [Color] = [.gray, .brown, Color(white: 0.8), .yellow]
+        let color = colors[min(a.tier, 3)]
+        return Button {} label: {
+            VStack(spacing: 12) {
+                ZStack {
+                    Circle().stroke(Color.white.opacity(0.15), lineWidth: 10)
+                    Circle()
+                        .trim(from: 0, to: CGFloat(a.progress))
+                        .stroke(color, style: StrokeStyle(lineWidth: 10, lineCap: .round))
+                        .rotationEffect(.degrees(-90))
+                    Image(systemName: a.tier > 0 ? "medal.fill" : "medal")
+                        .font(.system(size: 40)).foregroundColor(color)
+                }
+                .frame(width: 110, height: 110)
+                Text(a.title).font(.system(size: 26, weight: .semibold)).foregroundColor(.white)
+                Text(a.detail).font(.system(size: 20)).foregroundColor(.white.opacity(0.6))
+            }
+            .padding(20)
+            .frame(maxWidth: .infinity)
+        }
+        .buttonStyle(.card)
+    }
+
+    @ViewBuilder
+    private var diaryPage: some View {
+        if let s = stats {
+            if s.days.isEmpty {
+                empty("Nothing watched yet. Finished titles show up here, day by day.")
+            }
+            LazyVStack(alignment: .leading, spacing: 16) {
+                ForEach(Array(s.days.enumerated()), id: \.element.id) { index, day in
+                    if index == 0 || s.days[index - 1].date.prefix(7) != day.date.prefix(7) {
+                        section(Self.monthTitle(day.date))
+                    }
+                    Text(Self.dayTitle(day.date)).font(.system(size: 22)).foregroundColor(.white.opacity(0.6))
+                    ForEach(day.entries) { row(poster: $0.poster, title: $0.name, detail: $0.detail) }
+                }
+            }
+        } else {
+            ProgressView()
+        }
+    }
+
+    @ViewBuilder
+    private var calendarPage: some View {
+        if let calendar {
+            if calendar.isEmpty {
+                empty("Nothing coming up in the next 60 days for your Library or the shows you're watching.")
+            }
+            let today = Self.parser.string(from: Date())
+            LazyVStack(alignment: .leading, spacing: 16) {
+                ForEach(Array(calendar.enumerated()), id: \.element.id) { index, entry in
+                    if index == 0 || calendar[index - 1].date != entry.date {
+                        section(entry.date == today ? "Today" : Self.dayTitle(entry.date))
+                    }
+                    row(poster: entry.poster, title: entry.name, detail: entry.label, dimmed: entry.date < today) {
+                        onOpen?(entry.metaId, entry.metaType)
+                    }
+                }
+            }
+        } else {
+            HStack(spacing: 16) {
+                ProgressView()
+                Text("Checking your library…").foregroundColor(.white.opacity(0.6))
+            }
+        }
+    }
+
+    private func row(poster: String?, title: String, detail: String, dimmed: Bool = false,
+                     action: @escaping () -> Void = {}) -> some View {
+        Button(action: action) {
+            HStack(spacing: 20) {
+                AsyncImage(url: poster.flatMap(URL.init(string:))) { image in
+                    image.resizable().scaledToFill()
+                } placeholder: {
+                    Color.white.opacity(0.08)
+                }
+                .frame(width: 60, height: 90)
+                .clipShape(RoundedRectangle(cornerRadius: 8))
+                VStack(alignment: .leading, spacing: 4) {
+                    Text(title).font(.system(size: 28, weight: .semibold)).foregroundColor(.white).lineLimit(1)
+                    Text(detail).font(.system(size: 22)).foregroundColor(.white.opacity(0.6)).lineLimit(2)
+                }
+                Spacer()
+            }
+            .padding(.vertical, 6)
+            .padding(.horizontal, 12)
+            .opacity(dimmed ? 0.55 : 1)
+        }
+        .buttonStyle(.card)
+        .frame(maxWidth: 1100, alignment: .leading)
+    }
+
+    private func section(_ text: String) -> some View {
+        Text(text).font(.system(size: 34, weight: .bold)).foregroundColor(.white).padding(.top, 16)
+    }
+
+    private func empty(_ text: String) -> some View {
+        Text(text).font(.system(size: 26)).foregroundColor(.white.opacity(0.6))
+    }
+}
