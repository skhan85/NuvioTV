diff --git a/tvosApp/NuvioTV/Sources/Fork/HomeFork.swift b/tvosApp/NuvioTV/Sources/Fork/HomeFork.swift
new file mode 100644
index 00000000..917a74c1
--- /dev/null
+++ b/tvosApp/NuvioTV/Sources/Fork/HomeFork.swift
@@ -0,0 +1,184 @@
+import SwiftUI
+
+// MARK: - Fork: Top 10 numerals
+
+/// Fork: rows whose title says "Top 10" (FlixPatrol rows and the like) get a big outlined rank
+/// numeral on each of their first ten posters. `fork_top10_numerals` = false turns it off.
+enum ForkTop10 {
+    static func isTop10(_ title: String) -> Bool {
+        guard UserDefaults.standard.object(forKey: "fork_top10_numerals") as? Bool ?? true else { return false }
+        let t = title.lowercased()
+        return t.contains("top 10") || t.contains("top ten") || t.contains("top10")
+    }
+}
+
+struct ForkTop10Numeral: View {
+    let rank: Int
+    let cardWidth: CGFloat
+
+    var body: some View {
+        let size = cardWidth * 0.62
+        ZStack {
+            // Outline: the numeral drawn light and offset in eight directions, a dark fill on top.
+            ForEach(0..<8, id: \.self) { i in
+                let a = Double(i) * .pi / 4
+                Text("\(rank)")
+                    .foregroundStyle(Color.white.opacity(0.9))
+                    .offset(x: cos(a) * 3, y: sin(a) * 3)
+            }
+            Text("\(rank)").foregroundStyle(Color.black)
+        }
+        .font(.system(size: size, weight: .black, design: .rounded))
+        .monospacedDigit()
+        .tracking(rank == 10 ? -size * 0.08 : 0)
+        .lineLimit(1)
+        .fixedSize()
+        .shadow(color: .black.opacity(0.6), radius: 6, y: 2)
+        .offset(x: -cardWidth * 0.12, y: size * 0.18)
+        .accessibilityHidden(true)
+        .allowsHitTesting(false)
+    }
+}
+
+// MARK: - Fork: Because you watched
+
+/// Fork: up to two "Because you watched X" rows on Home, built from TMDB recommendations for the two
+/// titles watched most recently (Continue Watching order), under Continue Watching / Upcoming.
+/// Titles already in Continue Watching are left out. `fork_because_rows` = false turns them off
+/// (Settings → Layout → Because You Watched).
+enum ForkBecauseYouWatched {
+    static let enabledKey = "fork_because_rows"
+    static let maxRows = 2
+    static let idPrefix = "fork_because_"
+
+    private static func seeds(_ items: [ContinueWatchingItem]) -> [ContinueWatchingItem] {
+        var seen = Set<String>()
+        return items.sorted { $0.lastWatchedAt > $1.lastWatchedAt }
+            .filter { seen.insert($0.meta.id).inserted }
+            .prefix(maxRows)
+            .map { $0 }
+    }
+
+    static func seedKey(_ items: [ContinueWatchingItem]) -> String {
+        seeds(items).map(\.meta.id).joined(separator: ",")
+    }
+
+    static func sections(seeds items: [ContinueWatchingItem]) async -> [TVHomeSection] {
+        let seeds = seeds(items)
+        let exclude = Set(items.map(\.meta.id))
+        var sections: [TVHomeSection] = []
+        var used = Set<String>()
+        for seed in seeds {
+            let related = await TmdbDetailsService.fetchMoreLikeThis(for: seed.meta, limit: 20)
+            let metas = related.map(\.asMeta).filter { meta in
+                !exclude.contains(meta.id) && used.insert(meta.id).inserted
+            }
+            guard metas.count >= 4 else { continue }
+            sections.append(TVHomeSection(
+                id: idPrefix + seed.meta.id,
+                title: "Because you watched \(seed.meta.name)",
+                items: metas
+            ))
+        }
+        return sections
+    }
+}
+
+// MARK: - Fork: episodes left on Continue Watching
+
+extension ContinueWatchingItem {
+    /// Aired episodes still to watch after this card's episode (including it for a Next Up card),
+    /// from the episode guide the card carries. nil for movies or without a guide.
+    var forkEpisodesLeft: Int? {
+        guard meta.isSeries, let season, let episode,
+              let videos = meta.videos, !videos.isEmpty else { return nil }
+        let count = videos.filter { video in
+            guard video.season > 0, video.episode > 0,
+                  EpisodeReleasePolicy.hasAired(video.released) else { return false }
+            if isUpNextEntry { return (video.season, video.episode) >= (season, episode) }
+            return (video.season, video.episode) > (season, episode)
+        }.count
+        return count
+    }
+
+    /// The card's own remaining text plus "N eps left" (fork). `fork_cw_episodes_left` = false hides it.
+    var forkRemainingText: String {
+        guard UserDefaults.standard.object(forKey: "fork_cw_episodes_left") as? Bool ?? true,
+              let left = forkEpisodesLeft, left > 0 else { return remainingText }
+        let eps = left == 1 ? "1 ep left" : "\(left) eps left"
+        return remainingText.isEmpty ? eps : "\(remainingText) · \(eps)"
+    }
+}
+
+// MARK: - Fork: full stream details
+
+/// Fork: shows all of a source's description in the picker. The first line (usually the title)
+/// spans the card; the rest flow into two columns, so a long AIOStreams format (quality, HDR,
+/// audio, languages, size, cache state…) fits without being cut off.
+struct ForkStreamCardDetails: View {
+    let description: String
+
+    private var lines: [String] {
+        description.components(separatedBy: .newlines)
+            .map { $0.trimmingCharacters(in: .whitespaces) }
+            .filter { !$0.isEmpty }
+    }
+
+    var body: some View {
+        let lines = lines
+        VStack(alignment: .leading, spacing: 8) {
+            if let first = lines.first {
+                Text(first)
+                    .font(.system(size: 26, weight: .medium))
+                    .foregroundColor(.white.opacity(0.78))
+                    .lineLimit(2)
+                    .fixedSize(horizontal: false, vertical: true)
+            }
+            if lines.count > 1 {
+                LazyVGrid(columns: [GridItem(.flexible(), spacing: 28, alignment: .topLeading),
+                                    GridItem(.flexible(), spacing: 28, alignment: .topLeading)],
+                          alignment: .leading, spacing: 6) {
+                    ForEach(Array(lines.dropFirst().enumerated()), id: \.offset) { _, line in
+                        Text(line)
+                            .font(.system(size: 24, weight: .regular))
+                            .foregroundColor(.white.opacity(0.62))
+                            .lineLimit(2)
+                            .fixedSize(horizontal: false, vertical: true)
+                            .frame(maxWidth: .infinity, alignment: .leading)
+                    }
+                }
+            }
+        }
+    }
+
+    /// "12.4 GB" from the add-on's size or a size in the stream's text, nil when unknown.
+    static func sizeText(for stream: NuvioStream) -> String? {
+        guard let bytes = StreamBadgeSizing.fileSizeBytes(for: stream) else { return nil }
+        // Decimal units, like the add-on's own text (a 30.3 GB file reads 30.3 GB, not 28.2).
+        let gb = Double(bytes) / 1_000_000_000
+        if gb >= 1 { return String(format: "%.1f GB", gb) }
+        return "\(Int((Double(bytes) / 1_000_000).rounded())) MB"
+    }
+}
+
+struct ForkStreamSizePill: View {
+    let text: String
+
+    var body: some View {
+        Text(text)
+            .font(.system(size: 24, weight: .bold))
+            .foregroundColor(.black)
+            .padding(.horizontal, 14)
+            .padding(.vertical, 4)
+            .background(Color.white.opacity(0.9), in: Capsule())
+            .fixedSize()
+    }
+}
+
+extension ForkSecrets {
+    /// The TMDB key to use: the one saved in Settings, else the one built into this fork.
+    static func tmdbKey(_ stored: String?) -> String {
+        let key = stored?.trimmingCharacters(in: .whitespacesAndNewlines) ?? ""
+        return key.isEmpty ? tmdbApiKey : key
+    }
+}
diff --git a/tvosApp/NuvioTV/Sources/Fork/InsightsFork.swift b/tvosApp/NuvioTV/Sources/Fork/InsightsFork.swift
new file mode 100644
index 00000000..f7933e1b
--- /dev/null
+++ b/tvosApp/NuvioTV/Sources/Fork/InsightsFork.swift
@@ -0,0 +1,418 @@
+import SwiftUI
+
+// MARK: - Fork: Stats, Diary and Calendar
+
+/// Fork: Stats and Diary (from NuvioPro) and a release Calendar (from Nuvio Enhanced / NuvioPro),
+/// opened from the Library tab. Everything comes from what is already on the device: the watched
+/// history, the library and the add-on metadata.
+enum ForkInsightsPage: String, CaseIterable, Identifiable {
+    case stats, diary, calendar
+    var id: String { rawValue }
+    var title: String {
+        switch self {
+        case .stats: return "Stats"
+        case .diary: return "Diary"
+        case .calendar: return "Calendar"
+        }
+    }
+    var icon: String {
+        switch self {
+        case .stats: return "chart.bar.fill"
+        case .diary: return "book.closed.fill"
+        case .calendar: return "calendar"
+        }
+    }
+}
+
+struct ForkWatchStats {
+    struct Achievement: Identifiable {
+        let id = UUID()
+        let title: String
+        let detail: String
+        let progress: Double
+        let tier: Int
+    }
+    struct DiaryEntry: Identifiable {
+        let id = UUID()
+        let name: String
+        let poster: String?
+        let detail: String
+    }
+    struct DiaryDay: Identifiable {
+        var id: String { date }
+        let date: String
+        let entries: [DiaryEntry]
+    }
+
+    var movies = 0
+    var episodes = 0
+    var showsStarted = 0
+    var showsFinished = 0
+    var estimatedHours = 0
+    var thisMonth = 0
+    var thisYear = 0
+    var longestStreak = 0
+    var topGenres: [String] = []
+    var days: [DiaryDay] = []
+    var achievements: [Achievement] = []
+
+    static func compute(now: Date = Date()) -> ForkWatchStats {
+        let items = WatchedStore.visibleItems()
+        var stats = ForkWatchStats()
+        let calendar = Calendar.current
+        let dayFormatter = DateFormatter()
+        dayFormatter.dateFormat = "yyyy-MM-dd"
+
+        var showIds = Set<String>()
+        var finished = Set<String>()
+        var minutes = 0
+        var genreCounts: [String: Int] = [:]
+        var byDay: [String: [WatchedStoreItem]] = [:]
+        for item in items {
+            let isEpisode = item.season != nil && item.episode != nil
+            if isEpisode {
+                stats.episodes += 1
+                showIds.insert(item.meta.id)
+                minutes += 45
+            } else if item.meta.isSeries {
+                showIds.insert(item.meta.id)
+                finished.insert(item.meta.id)
+            } else {
+                stats.movies += 1
+                minutes += 110
+            }
+            if calendar.isDate(item.watchedAt, equalTo: now, toGranularity: .month) { stats.thisMonth += 1 }
+            if calendar.isDate(item.watchedAt, equalTo: now, toGranularity: .year) { stats.thisYear += 1 }
+            for genre in item.meta.genres ?? [] { genreCounts[genre, default: 0] += 1 }
+            byDay[dayFormatter.string(from: item.watchedAt), default: []].append(item)
+        }
+        for id in showIds where !finished.contains(id) {
+            if let meta = items.first(where: { $0.meta.id == id })?.meta,
+               CatalogWatchedPolicy.hasWatchedAllAiredEpisodes(
+                   videos: meta.videos, watchedEpisodeKeys: WatchedStore.watchedEpisodeKeys(metaId: id)) {
+                finished.insert(id)
+            }
+        }
+        stats.showsStarted = showIds.count
+        stats.showsFinished = finished.count
+        stats.estimatedHours = minutes / 60
+        stats.topGenres = genreCounts.sorted { $0.value > $1.value }.prefix(5).map(\.key)
+
+        // Longest run of consecutive days with something watched.
+        let dates = byDay.keys.compactMap { dayFormatter.date(from: $0) }.sorted()
+        var best = 0, run = 0
+        var previous: Date?
+        for date in dates {
+            if let previous, calendar.dateComponents([.day], from: previous, to: date).day == 1 {
+                run += 1
+            } else {
+                run = 1
+            }
+            best = max(best, run)
+            previous = date
+        }
+        stats.longestStreak = best
+
+        stats.days = byDay.keys.sorted(by: >).prefix(120).map { day in
+            var grouped: [String: (WatchedStoreItem, [String])] = [:]
+            var order: [String] = []
+            for item in byDay[day] ?? [] {
+                if grouped[item.meta.id] == nil { order.append(item.meta.id); grouped[item.meta.id] = (item, []) }
+                if let s = item.season, let e = item.episode { grouped[item.meta.id]?.1.append("S\(s) E\(e)") }
+            }
+            let entries = order.compactMap { id -> DiaryEntry? in
+                guard let (item, eps) = grouped[id] else { return nil }
+                let detail = eps.isEmpty ? (item.meta.isSeries ? "Series" : "Movie") : eps.joined(separator: ", ")
+                return DiaryEntry(name: item.meta.name, poster: item.meta.posterUrl, detail: detail)
+            }
+            return DiaryDay(date: day, entries: entries)
+        }
+
+        func tier(_ value: Int, _ steps: [Int]) -> (Int, Double, Int) {
+            let reached = steps.filter { value >= $0 }.count
+            let next = reached < steps.count ? steps[reached] : steps.last!
+            return (reached, min(1, Double(value) / Double(next)), next)
+        }
+        let m = tier(stats.movies, [10, 50, 200])
+        let e = tier(stats.episodes, [50, 250, 1000])
+        let s = tier(stats.longestStreak, [3, 7, 30])
+        let f = tier(stats.showsFinished, [1, 10, 50])
+        stats.achievements = [
+            Achievement(title: "Film Buff", detail: "\(stats.movies) / \(m.2) movies", progress: m.1, tier: m.0),
+            Achievement(title: "Binger", detail: "\(stats.episodes) / \(e.2) episodes", progress: e.1, tier: e.0),
+            Achievement(title: "On a Roll", detail: "\(stats.longestStreak) / \(s.2) days in a row", progress: s.1, tier: s.0),
+            Achievement(title: "Finisher", detail: "\(stats.showsFinished) / \(f.2) shows finished", progress: f.1, tier: f.0),
+        ]
+        return stats
+    }
+}
+
+/// Upcoming releases for the library: series episodes from -7 to +60 days, and movies with a date.
+enum ForkReleaseCalendar {
+    struct Entry: Identifiable {
+        let id = UUID()
+        let date: String
+        let name: String
+        let poster: String?
+        let label: String
+        /// Fork: the title to open when the row is pressed.
+        let metaId: String
+        let metaType: String
+    }
+
+    static func load(now: Date = Date()) async -> [Entry] {
+        let formatter = DateFormatter()
+        formatter.dateFormat = "yyyy-MM-dd"
+        formatter.timeZone = TimeZone(identifier: "UTC")
+        let from = formatter.string(from: now.addingTimeInterval(-7 * 86_400))
+        let to = formatter.string(from: now.addingTimeInterval(60 * 86_400))
+        // Fork: shows from the Library plus shows watched in the last 120 days, so the agenda
+        // covers what you are actually following (like Stremio's Calendar), not only saved titles.
+        var seen = Set<String>()
+        var library: [NuvioMeta] = []
+        for meta in LibraryStore.items().map(\.meta) where seen.insert(meta.id).inserted {
+            library.append(meta)
+        }
+        let recentCutoff = now.addingTimeInterval(-120 * 86_400)
+        let following = WatchedStore.visibleItems()
+            .filter { $0.meta.isSeries && $0.watchedAt >= recentCutoff }
+            .sorted { $0.watchedAt > $1.watchedAt }
+        for item in following where seen.insert(item.meta.id).inserted {
+            library.append(item.meta)
+        }
+        let repository = CinemetaCatalogRepository()
+
+        return await withTaskGroup(of: [Entry].self) { group in
+            for meta in library.prefix(120) {
+                group.addTask {
+                    if meta.isSeries {
+                        var videos = meta.videos ?? []
+                        if videos.isEmpty, let full = try? await repository.getMetadata(id: meta.id, type: meta.type) {
+                            videos = full.videos ?? []
+                        }
+                        return videos.compactMap { video in
+                            guard video.season > 0, let released = video.released, released.count >= 10 else { return nil }
+                            let day = String(released.prefix(10))
+                            guard day >= from, day <= to else { return nil }
+                            let title = video.title.isEmpty ? "" : " · \(video.title)"
+                            return Entry(date: day, name: meta.name, poster: meta.posterUrl,
+                                         label: "S\(video.season) E\(video.episode)\(title)",
+                                         metaId: meta.id, metaType: meta.type)
+                        }
+                    }
+                    guard let released = meta.released, released.count >= 10 else { return [] }
+                    let day = String(released.prefix(10))
+                    guard day >= from, day <= to else { return [] }
+                    return [Entry(date: day, name: meta.name, poster: meta.posterUrl, label: "Movie",
+                                  metaId: meta.id, metaType: meta.type)]
+                }
+            }
+            var all: [Entry] = []
+            for await entries in group { all += entries }
+            return all.sorted { ($0.date, $0.name) < ($1.date, $1.name) }
+        }
+    }
+}
