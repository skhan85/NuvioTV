+import Foundation
+import SwiftUI
+
+// MARK: - Fork: Netflix home touches
+
+enum ForkNetflixUI {
+    /// Red TOP 10 tag and New Episode / New Season / Recently Added tags on every card.
+    static let cardBadgesKey = "fork_card_badges"
+    static let netflixRed = Color(red: 0xE5 / 255, green: 0x09 / 255, blue: 0x14 / 255)
+
+    /// Set by the app root whenever the active profile changes.
+    @MainActor static var activeProfileName: String?
+
+    @MainActor static var continueWatchingTitle: String {
+        if let name = activeProfileName?.trimmingCharacters(in: .whitespacesAndNewlines), !name.isEmpty {
+            return "Continue Watching for \(name)"
+        }
+        return "Continue Watching"
+    }
+}
+
+/// Home filter: everything, only series, or only movies (Netflix's Shows / Movies tabs).
+enum ForkHomeTypeFilter: String, CaseIterable, Hashable {
+    case all, shows, movies
+
+    var title: String {
+        switch self {
+        case .all: return "Home"
+        case .shows: return "Shows"
+        case .movies: return "Movies"
+        }
+    }
+
+    func matches(_ meta: NuvioMeta) -> Bool {
+        switch self {
+        case .all: return true
+        case .shows: return meta.isSeries
+        case .movies: return !meta.isSeries
+        }
+    }
+}
+
+struct ForkHomeTypeFilterBar: View {
+    @Binding var selection: ForkHomeTypeFilter
+    @FocusState private var focused: ForkHomeTypeFilter?
+
+    var body: some View {
+        HStack(spacing: 12) {
+            ForEach(ForkHomeTypeFilter.allCases, id: \.self) { filter in
+                Button {
+                    withAnimation(.easeInOut(duration: 0.2)) { selection = filter }
+                } label: {
+                    Text(filter.title)
+                        .font(.system(size: 24, weight: selection == filter ? .bold : .medium))
+                        .foregroundColor(focused == filter ? .black : (selection == filter ? .white : .white.opacity(0.62)))
+                        .padding(.horizontal, 22)
+                        .padding(.vertical, 9)
+                        .background(
+                            Capsule().fill(focused == filter ? Color.white : (selection == filter ? Color.white.opacity(0.16) : .clear))
+                        )
+                }
+                .buttonStyle(.plain)
+                .focused($focused, equals: filter)
+            }
+        }
+        .focusSection()
+    }
+}
+
+// MARK: Card badges
+
+/// Per-title freshness from TMDB ("New Episode", "New Season", "Recently Added"),
+/// looked up a few at a time and kept on the device for 12 hours.
+@MainActor
+final class ForkCardBadges: ObservableObject {
+    static let shared = ForkCardBadges()
+
+    struct Entry: Codable, Equatable {
+        var primary: String?
+        var secondary: String?
+        var at: Double
+    }
+
+    /// Bumped (at most twice a second) as badges arrive, so card overlays redraw.
+    @Published private(set) var revision = 0
+
+    private var entries: [String: Entry]
+    private var inFlight = Set<String>()
+    private var queue: [NuvioMeta] = []
+    private var running = 0
+    private var publishScheduled = false
+    private static let maxConcurrent = 4
+    private static let storeKey = "fork_card_badges_v1"
+    private static let ttl: Double = 12 * 3600
+
+    private init() {
+        if let data = UserDefaults.standard.data(forKey: Self.storeKey),
+           let decoded = try? JSONDecoder().decode([String: Entry].self, from: data) {
+            entries = decoded
+        } else {
+            entries = [:]
+        }
+    }
+
+    static var isEnabled: Bool {
+        ProfileSettings.current.object(forKey: ForkNetflixUI.cardBadgesKey) as? Bool ?? true
+    }
+
+    /// The badge for a title if known; starts a lookup when missing or stale.
+    func entry(for meta: NuvioMeta) -> Entry? {
+        let now = Date().timeIntervalSince1970
+        if let cached = entries[meta.id], now - cached.at < Self.ttl { return cached }
+        enqueue(meta)
+        return entries[meta.id]
+    }
+
+    private func enqueue(_ meta: NuvioMeta) {
+        guard !inFlight.contains(meta.id) else { return }
+        inFlight.insert(meta.id)
+        queue.append(meta)
+        // Defer so a view body never kicks off work synchronously.
+        DispatchQueue.main.async { [weak self] in self?.pump() }
+    }
+
+    private func pump() {
+        while running < Self.maxConcurrent, !queue.isEmpty {
+            let meta = queue.removeLast() // newest first: what's on screen now
+            running += 1
+            Task { @MainActor in
+                let result = await TmdbDetailsService.fetchFreshness(for: meta)
+                entries[meta.id] = Entry(
+                    primary: result?.primary,
+                    secondary: result?.secondary,
+                    at: Date().timeIntervalSince1970
+                )
+                inFlight.remove(meta.id)
+                running -= 1
+                schedulePublish()
+                pump()
+            }
+        }
+    }
+
+    private func schedulePublish() {
+        guard !publishScheduled else { return }
+        publishScheduled = true
+        DispatchQueue.main.asyncAfter(deadline: .now() + 0.5) { [weak self] in
+            guard let self else { return }
+            publishScheduled = false
+            revision &+= 1
+            persist()
+        }
+    }
+
+    private func persist() {
+        let now = Date().timeIntervalSince1970
+        entries = entries.filter { now - $0.value.at < Self.ttl * 4 }
+        if entries.count > 3000 {
+            entries = Dictionary(uniqueKeysWithValues: entries.sorted { $0.value.at > $1.value.at }.prefix(2000).map { ($0.key, $0.value) })
+        }
+        if let data = try? JSONEncoder().encode(entries) {
+            UserDefaults.standard.set(data, forKey: Self.storeKey)
+        }
+    }
+}
+
+/// Netflix-style tags drawn over a poster: a red TOP 10 tag for today's Top 10, and a
+/// red "New Episode" / "New Season" / "Recently Added" tag (with "Watch Now" or the
+/// next air day beside it).
+struct ForkCardBadgeOverlay: View {
+    let meta: NuvioMeta
+    let landscape: Bool
+    @ObservedObject private var store = ForkCardBadges.shared
+
+    var body: some View {
+        let _ = store.revision
+        let isTop10 = ForkTrendingRows.ranks[meta.id] != nil
+        let entry = store.entry(for: meta)
+
+        ZStack {
+            if landscape {
+                HStack(alignment: .top, spacing: 8) {
+                    if isTop10 { top10Tag }
+                    if let primary = entry?.primary { pill(primary, entry?.secondary) }
+                }
+                .padding(14)
+                .frame(maxWidth: .infinity, maxHeight: .infinity, alignment: .topLeading)
+            } else {
+                if isTop10 {
+                    top10Tag
+                        .padding(10)
+                        .frame(maxWidth: .infinity, maxHeight: .infinity, alignment: .topLeading)
+                }
+                if let primary = entry?.primary {
+                    pill(primary, entry?.secondary)
+                        .padding(.bottom, 12)
+                        .frame(maxWidth: .infinity, maxHeight: .infinity, alignment: .bottom)
+                }
+            }
+        }
+        .allowsHitTesting(false)
+    }
+
+    private var top10Tag: some View {
+        VStack(spacing: -3) {
+            Text("TOP")
+                .font(.system(size: 12, weight: .heavy))
+            Text("10")
+                .font(.system(size: 22, weight: .black))
+        }
+        .foregroundColor(.white)
+        .frame(width: 40, height: 46)
+        .background(
+            RoundedRectangle(cornerRadius: 4, style: .continuous).fill(ForkNetflixUI.netflixRed)
+        )
+        .shadow(color: .black.opacity(0.35), radius: 4, y: 2)
+    }
+
+    private func pill(_ primary: String, _ secondary: String?) -> some View {
+        HStack(spacing: 0) {
+            Text(primary)
+                .font(.system(size: 17, weight: .bold))
+                .foregroundColor(.white)
+                .padding(.horizontal, 10)
+                .padding(.vertical, 5)
+                .background(ForkNetflixUI.netflixRed)
+            if let secondary {
+                Text(secondary)
+                    .font(.system(size: 17, weight: .bold))
+                    .foregroundColor(.black)
+                    .padding(.horizontal, 10)
+                    .padding(.vertical, 5)
+                    .background(Color.white)
+            }
+        }
+        .lineLimit(1)
+        .fixedSize()
+        .clipShape(RoundedRectangle(cornerRadius: 4, style: .continuous))
+        .shadow(color: .black.opacity(0.35), radius: 4, y: 2)
+    }
+}
+
+/// Netflix's big round play button over a Continue Watching card.
+struct ForkContinuePlayCircle: View {
+    var size: CGFloat = 76
+
+    var body: some View {
+        ZStack {
+            Circle()
+                .fill(Color.black.opacity(0.38))
+            Circle()
+                .stroke(Color.white, lineWidth: 3)
+            Image(systemName: "play.fill")
+                .font(.system(size: size * 0.38, weight: .bold))
+                .foregroundColor(.white)
+                .offset(x: size * 0.04)
+        }
+        .frame(width: size, height: size)
+        .shadow(color: .black.opacity(0.4), radius: 6)
+        .allowsHitTesting(false)
+    }
+}
