+/// Fork: Netflix's solid white, gently rounded Play button; the usual glass capsule otherwise.
+private struct TvNetflixOrGlassBackground: ViewModifier {
+    let netflix: Bool
+    let filled: Bool
+
+    @ViewBuilder
+    func body(content: Content) -> some View {
+        if netflix {
+            content.background(Color.white, in: RoundedRectangle(cornerRadius: 10, style: .continuous))
+        } else {
+            content.modifier(TvDetailsGlassBackground(filled: filled, shape: Capsule()))
+        }
+    }
+}
+
+/// Fork: Netflix-style "TOP 10 · #3 in Movies Today" line for titles in today's Top 10 rows.
+private struct TvDetailsTop10Badge: View {
+    let metaId: String
+    @AppStorage(ForkNetflixDetails.enabledKey) private var netflixStyle = false
+    @AppStorage(ForkTrendingRows.enabledKey) private var trendingEnabled = true
+
+    var body: some View {
+        if netflixStyle, trendingEnabled, let entry = ForkTrendingRows.ranks[metaId] {
+            HStack(spacing: 14) {
+                VStack(spacing: -2) {
+                    Text("TOP").font(.system(size: 11, weight: .bold))
+                    Text("10").font(.system(size: 22, weight: .black))
+                }
+                .foregroundColor(.white)
+                .frame(width: 40, height: 40)
+                .background(Color(red: 0.90, green: 0.04, blue: 0.08), in: RoundedRectangle(cornerRadius: 4))
+                Text("#\(entry.rank) in \(entry.list) Today")
+                    .font(.system(size: 30, weight: .bold))
+                    .foregroundColor(.white)
+            }
+            .accessibilityElement(children: .combine)
+        }
+    }
+}
