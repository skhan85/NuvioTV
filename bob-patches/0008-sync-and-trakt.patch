+    /// Fork: an unreleased title saved with Remind Me sends its full release date, so the
+    /// iPhone can notify on the day; everything else keeps the year as before.
+    private static func forkReleaseInfo(_ meta: NuvioMeta) -> String? {
+        let isFullDate: (String?) -> Bool = { value in
+            guard let value, value.count >= 10 else { return false }
+            return value.prefix(10).range(of: #"^\d{4}-\d{2}-\d{2}$"#, options: .regularExpression) != nil
+        }
+        if !isFullDate(meta.releaseInfo), let released = meta.released, isFullDate(released),
+           ContentReleasePolicy.isUnreleased(meta, today: ContentReleasePolicy.todayIsoDay()) {
+            return String(released.prefix(10))
+        }
+        return meta.releaseInfo ?? meta.year.map(String.init)
+    }
